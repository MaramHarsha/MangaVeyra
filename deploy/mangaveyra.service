# systemd unit for a bare-metal install.
#   sudo useradd --system --home /var/lib/mangaveyra --create-home mangaveyra
#   sudo install -d -m 0755 -o mangaveyra -g mangaveyra /opt/mangaveyra/bin   # the in-app updater replaces the binary here
#   sudo install -m 0755 -o mangaveyra -g mangaveyra bin/mangaveyra /opt/mangaveyra/bin/mangaveyra
#   sudo install -d -m 0750 -o root -g mangaveyra /etc/mangaveyra
#   sudo install -m 0640 -o root -g mangaveyra .env.example /etc/mangaveyra/mangaveyra.env   # then edit it
#   sudo cp deploy/mangaveyra.service /etc/systemd/system/ && sudo systemctl enable --now mangaveyra
[Unit]
Description=MangaVeyra self-hosted AI manga studio
Documentation=https://github.com/MaramHarsha/MangaVeyra
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=mangaveyra
Group=mangaveyra
Environment=MV_DATA_DIR=/var/lib/mangaveyra
EnvironmentFile=-/etc/mangaveyra/mangaveyra.env
ExecStart=/opt/mangaveyra/bin/mangaveyra serve
Restart=on-failure
# The in-app updater (G14) exits with 75 after swapping in a verified release.
RestartForceExitStatus=75
RestartSec=5
TimeoutStopSec=30
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# /opt/mangaveyra/bin lets the in-app updater replace the binary. For a read-only
# binary, install it elsewhere and drop that path: G14 then refuses before
# changing anything and you update by hand.
ReadWritePaths=/var/lib/mangaveyra /opt/mangaveyra/bin
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
# TCP/UDP for HTTP, SMTP, S3 and providers; AF_UNIX for a local PostgreSQL socket.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
SystemCallArchitectures=native
# The service listens on an unprivileged port as its own user, so it needs no
# capability at all; to bind :80/:443 directly, put a reverse proxy in front
# (deploy/Caddyfile.example) rather than granting CAP_NET_BIND_SERVICE here.
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027

[Install]
WantedBy=multi-user.target
