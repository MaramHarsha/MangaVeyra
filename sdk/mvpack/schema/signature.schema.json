{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mangaveyra.org/schemas/mvpack/signature.schema.json",
  "title": "MangaVeyra pack signatures (signature.json), format 1",
  "description": "ed25519 signatures over the canonical manifest bytes and the per-file SHA-256 list. See sdk/mvpack/SPEC.md §7 for the exact signing payload. Licensed MIT.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mvpack_signature", "manifest_sha256", "files", "signatures"],
  "properties": {
    "mvpack_signature": { "const": 1 },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the RFC 8785 canonical form of manifest.json."
    },
    "files": {
      "type": "array",
      "description": "Every payload file, sorted by path (byte order). Must equal the manifest's files (path, size, sha256).",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": { "$ref": "manifest.schema.json#/$defs/path" },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "signer", "alg", "public_key", "signed_at", "sig"],
        "properties": {
          "key_id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
          "signer": { "enum": ["server", "developer", "world"] },
          "alg": { "const": "ed25519" },
          "public_key": { "type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$", "description": "Base64 of the 32-byte key." },
          "signed_at": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "description": "RFC 3339, UTC, whole seconds (the form the signing payload uses)." },
          "sig": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$", "description": "Base64 of the 64-byte signature." }
        }
      }
    }
  }
}
