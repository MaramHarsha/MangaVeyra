{
  "mvplugin": 1,
  "id": "lin-park.community-model-manifests",
  "name": "Community model manifests",
  "version": "0.4.1",
  "kind": "model-adapter",
  "licence": "CC0-1.0",
  "min_app_version": "1.0.0",
  "entry": {
    "type": "manifest",
    "contributes": {
      "models": [
        "models/glass-orchard-xl.json"
      ],
      "layout_templates": [
        "layouts/four-tier.json"
      ]
    }
  },
  "permissions": [
    {
      "id": "models.provide",
      "risk": "low",
      "reason": "Adds model manifests to the catalogue."
    },
    {
      "id": "layout.templates",
      "risk": "low",
      "reason": "Adds a four-tier page layout."
    }
  ],
  "source": {
    "repo": "https://github.com/lin-park/community-model-manifests",
    "tag": "v0.4.1",
    "signed_tag": false
  }
}
