{
  "profile": "product-admin",
  "sourceRoots": ["internal/ai", "internal/studioui", "internal/export", "internal/editor", "web/src/styles"],
  "locale": "ja-JP",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": ["Select/Listbox", "Form", "Toast", "CRUD"],
  "ownership": {
    "Select/Listbox": "native",
    "Form": "authored",
    "Toast": "authored",
    "CRUD": "authored"
  },
  "requiredCommands": ["go-focused", "edition", "templ", "frontend-check", "frontend-test", "frontend-build"],
  "commands": {
    "go-focused": "go test -count=1 ./internal/ai ./internal/studioui ./internal/studio ./internal/gen ./internal/jobs ./internal/pagestore ./internal/lettering ./internal/compose ./internal/export ./internal/editor",
    "edition": "go test -count=1 ./internal/editioncheck/...",
    "templ": "templ generate",
    "frontend-check": "cd web && npm run check",
    "frontend-test": "cd web && npm test",
    "frontend-build": "cd web && npm run build"
  }
}
