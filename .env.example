# MangaVeyra configuration. Copy to .env (docker compose reads it) or export
# the variables. Every variable is optional; the defaults run a single-user
# server with SQLite and local storage in ./data on port 8080.
# A YAML file with the same settings can be passed with `mangaveyra serve --config mangaveyra.yaml`;
# environment variables override it. MV_CONFIG=path does the same as --config.

# --- Server -------------------------------------------------------------------
# Listen address.
MV_ADDR=:8080
# Data directory: SQLite database, local media (media/), secret.key, backups/, manifests/, locales/.
MV_DATA_DIR=data
# External URL of this server (links in emails, worker file URLs, CSRF trusted origin,
# Secure cookies and HSTS when it starts with https://).
MV_PUBLIC_URL=
# Log level: debug, info, warn, error.
MV_LOG_LEVEL=info
# Development mode: human-readable logs.
MV_DEV=false
# Reverse proxies whose X-Forwarded-For / X-Forwarded-Proto headers are trusted (IPs or CIDRs, comma-separated).
MV_TRUSTED_PROXIES=
# Largest single upload in megabytes.
MV_MAX_UPLOAD_MB=50
# Graceful shutdown timeout (Go duration).
MV_SHUTDOWN_TIMEOUT=20s

# --- Database -------------------------------------------------------------------
# Empty = SQLite at $MV_DATA_DIR/mangaveyra.db. Examples:
#   MV_DB=sqlite:///var/lib/mangaveyra/mangaveyra.db
#   MV_DB=postgres://mangaveyra:secret@postgres:5432/mangaveyra?sslmode=disable
MV_DB=

# --- Secrets ----------------------------------------------------------------------
# Master key that encrypts API keys, World tokens and 2FA secrets at rest
# (32 bytes as base64 or hex; generate with `openssl rand -base64 32`).
# Empty = $MV_DATA_DIR/secret.key is generated on first start (mode 0600). Back it up!
MV_MASTER_KEY=

# --- Media storage -----------------------------------------------------------------
# local (files under $MV_DATA_DIR/media) or s3 (any S3-compatible store).
MV_STORAGE=local
# S3 settings (only with MV_STORAGE=s3). Endpoint is host[:port] without scheme.
MV_S3_ENDPOINT=
MV_S3_REGION=us-east-1
MV_S3_BUCKET=
MV_S3_ACCESS_KEY=
MV_S3_SECRET_KEY=
MV_S3_USE_SSL=true
# Path-style addressing (MinIO, Garage).
MV_S3_PATH_STYLE=false
# Optional key prefix inside the bucket.
MV_S3_PREFIX=

# --- Email (optional) ---------------------------------------------------------------
# Without SMTP, password resets are done by an admin (reset link) and email notifications are off.
MV_SMTP_HOST=
MV_SMTP_PORT=587
MV_SMTP_USERNAME=
MV_SMTP_PASSWORD=
MV_SMTP_FROM="MangaVeyra <noreply@example.org>"
# starttls (default), tls (implicit TLS, usually port 465) or none (local relays only).
MV_SMTP_TLS=starttls

# --- AI workers ---------------------------------------------------------------------------
# Shared secret that lets `docker compose` workers pair without an admin-issued worker token.
# Workers send it as "Authorization: Bearer <token>". Leave empty to require per-worker tokens
# (Models & providers → Local worker → Add worker).
MV_WORKER_TOKEN=
# Allow providers (and web-push endpoints) on private or loopback addresses, e.g. Ollama on the LAN.
# Link-local and cloud metadata addresses stay blocked.
MV_ALLOW_PRIVATE_PROVIDER_URLS=false

# --- World hub (optional, off until an admin links the server) --------------------------
MV_WORLD_URL=https://world.mangaveyra.org

# --- CLI helpers ------------------------------------------------------------------------------
# Agent token used by `mangaveyra mcp-stdio` when --token is not given.
MV_AGENT_TOKEN=

# --- docker compose only ----------------------------------------------------------------------
POSTGRES_PASSWORD=change-me
MV_PORT=8080
