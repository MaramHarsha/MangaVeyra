package layout

import (
	"github.com/MaramHarsha/MangaVeyra/internal/i18n"
	"github.com/MaramHarsha/MangaVeyra/internal/web/ui"
)

// Auth art variants for AuthShell.
const (
	// AuthArtMark shows the brand mark on speed lines (log in, reset).
	AuthArtMark = "mark"
	// AuthArtPage shows a glowing screentone page and an SFX word (sign up).
	AuthArtPage = "page"
)

// AuthOpts configure AuthShell.
type AuthOpts struct {
	Art string
	// SFX is the corner sound effect on the art side ("BA-DUM").
	SFX string
	// HideArtMobile hides the art band on phones (sign-up, forgot password show a back arrow instead).
	HideArtMobile bool
	// BackURL is the mobile back arrow target.
	BackURL string
}

// AuthShell renders the split log-in / sign-up frame: art on the left, the form panel on the right.
templ AuthShell(c *Chrome, o AuthOpts) {
	@Base(c) {
		<a class="mv-skip-link" href="#main">{ i18n.T(ctx, "ui.skip_to_content") }</a>
		<div class={ "mv-auth", attrIf(o.HideArtMobile, "mv-auth--no-art-mobile") }>
			<div class="mv-auth__art" aria-hidden="true">
				<div class="mv-tex-speedlines"></div>
				<div class="mv-tex-calm"></div>
				if o.Art == AuthArtPage {
					<div class="mv-auth__page">
						@SamplePage(300)
					</div>
				} else {
					@ThemedImg("mv-auth__mark", BrandMarkDark, BrandMarkLight, "", 180, 180)
				}
				if o.SFX != "" {
					<span class="mv-auth__sfx">
						@ui.SFX(o.SFX, "", "", false)
					</span>
				}
			</div>
			<main id="main" class="mv-auth__panel">
				if o.BackURL != "" {
					<a class="mv-iconlink mv-auth__back" href={ templ.URL(o.BackURL) } aria-label={ i18n.T(ctx, "ui.back") }>
						@ui.Icon("arrow-left", 22)
					</a>
				}
				{ children... }
			</main>
		</div>
	}
}

// SamplePage draws the placeholder manga page (five panels, screentone) from
// design/kit.js at the given width. It is an SVG, so no inline styles are needed.
templ SamplePage(width int) {
	<svg viewBox="0 0 300 424" width={ itoa(width) } height={ itoa(width * 424 / 300) } role="img" aria-label="Sample page">
		<defs>
			<pattern id="mv-dots" width="6" height="6" patternUnits="userSpaceOnUse">
				<circle cx="3" cy="3" r="1.05" fill="#070A12" fill-opacity=".45"></circle>
			</pattern>
		</defs>
		<rect width="300" height="424" fill="#E8EEFF"></rect>
		for _, pts := range samplePanels {
			<polygon points={ pts } fill="#DCE3F3"></polygon>
			<polygon points={ pts } fill="url(#mv-dots)"></polygon>
			<polygon points={ pts } fill="none" stroke="#070A12" stroke-width="1.5"></polygon>
		}
	</svg>
}

var samplePanels = []string{
	"18.0,18.0 282.0,18.0 282.0,130.5 18.0,146.0",
	"155.3,155.7 282.0,140.2 282.0,258.6 155.3,258.6",
	"18.0,157.7 147.4,156.1 147.4,258.6 18.0,258.6",
	"18.0,270.2 176.4,270.2 155.3,406.0 18.0,406.0",
	"184.3,270.2 282.0,270.2 282.0,406.0 163.2,406.0",
}

// SetupOpts configure SetupShell.
type SetupOpts struct {
	Host  string
	Steps []SetupStep
	// Facts are the footer lines ("Telemetry: off", "Mode: private group · invite-only sign-up").
	Facts []string
}

// SetupStep is one entry in the first-run wizard's side list.
type SetupStep struct {
	Label   string
	Href    string
	Icon    string
	Done    bool
	Current bool
}

// SetupShell renders the first-run wizard frame (G8): hero side panel with steps, and the step content.
templ SetupShell(c *Chrome, o SetupOpts) {
	@Base(c) {
		<a class="mv-skip-link" href="#main">{ i18n.T(ctx, "ui.skip_to_content") }</a>
		<div class="mv-setup">
			<aside class="mv-setup__side">
				@ThemedImg("mv-setup__logo", LogoDark, LogoLight, "MangaVeyra", 113, 26)
				<div class="mv-setup__hero">
					<span class="mv-label-mono">{ i18n.T(ctx, "setup.kicker") } · <span class="mv-mono--plain">{ o.Host }</span></span>
					<span class="mv-setup__title">{ i18n.T(ctx, "setup.hero.line1") }<br/>{ i18n.T(ctx, "setup.hero.line2") }</span>
					<span class="mv-setup__lead">{ i18n.T(ctx, "setup.hero.lead") }</span>
				</div>
				<nav class="mv-setup__nav" aria-label={ i18n.T(ctx, "setup.steps") }>
					for _, s := range o.Steps {
						<a
							class={ ui.Cls("mv-setup__navitem", ui.If(s.Done, "is-done")) }
							href={ templ.URL(s.Href) }
							if s.Current {
								aria-current="step"
							}
						>
							if s.Done && !s.Current {
								@ui.Icon("circle-check", 18)
							} else {
								@ui.Icon(s.Icon, 18)
							}
							{ s.Label }
						</a>
					}
				</nav>
				<div class="mv-setup__facts">
					for _, f := range o.Facts {
						<span>{ f }</span>
					}
				</div>
			</aside>
			<main id="main" class="mv-setup__main">
				{ children... }
			</main>
		</div>
	}
}

// OnboardingShell renders the three-step onboarding frame (A5) with its skip link.
templ OnboardingShell(c *Chrome, skip templ.Component) {
	@Base(c) {
		<a class="mv-skip-link" href="#main">{ i18n.T(ctx, "ui.skip_to_content") }</a>
		<main id="main" class="mv-onboard">
			<div class="mv-onboard__top">
				@ThemedImg("mv-onboard__logo", LogoDark, LogoLight, "MangaVeyra", 96, 22)
				if skip != nil {
					@skip
				}
			</div>
			{ children... }
		</main>
	}
}

// SettingsNavItem is one section of the settings navigation.
type SettingsNavItem struct {
	Key   string
	Href  string
	Label string
	Icon  string
}

// SettingsLayout renders the settings page (G1) inside the app shell: page title,
// section list on the left (a full-screen list on phones) and the section content.
// index marks /settings itself (phones show only the list).
templ SettingsLayout(c *Chrome, title string, nav []SettingsNavItem, current string, index bool) {
	@AppShell(c) {
		<div class={ ui.Cls("mv-settings-page mv-stack mv-stack--lg", ui.If(index, "mv-settings--index")) }>
			<div class="mv-hide-mobile">
				@ui.PageHead(title, "", nil)
			</div>
			<div class={ ui.Cls("mv-settings", ui.If(index, "mv-settings--index")) }>
				<nav class="mv-settings__nav" aria-label={ title }>
					for _, n := range nav {
						<a
							class="mv-settings__navitem"
							href={ templ.URL(n.Href) }
							if n.Key == current {
								aria-current="page"
							}
						>
							@ui.Icon(n.Icon, 20)
							<span>{ n.Label }</span>
							<i class="ti ti-chevron-right mv-settings__chev" aria-hidden="true"></i>
						</a>
					}
				</nav>
				<div class="mv-settings__content" id="settings-content">
					{ children... }
				</div>
			</div>
		</div>
	}
}

// ReaderShell renders the distraction-free reader frame: slim bar and a canvas stage.
templ ReaderShell(c *Chrome, title, backURL string) {
	@Base(c) {
		<a class="mv-skip-link" href="#main">{ i18n.T(ctx, "ui.skip_to_content") }</a>
		<div class="mv-reader">
			<header class="mv-reader__bar">
				<a class="mv-iconlink" href={ templ.URL(backURL) } aria-label={ i18n.T(ctx, "ui.back") }>
					@ui.Icon("arrow-left", 22)
				</a>
				<span class="mv-reader__title">{ title }</span>
			</header>
			<main id="main" class="mv-reader__stage">
				{ children... }
			</main>
		</div>
	}
}

// EditorShell renders the full-screen editor container; the editor island fills it.
templ EditorShell(c *Chrome) {
	@Base(c) {
		<a class="mv-skip-link" href="#main">{ i18n.T(ctx, "ui.skip_to_content") }</a>
		<main id="main" class="mv-editor">
			{ children... }
		</main>
	}
}
