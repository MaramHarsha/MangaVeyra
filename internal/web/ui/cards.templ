package ui

import (
	"math"
	"strconv"

	"github.com/MaramHarsha/MangaVeyra/internal/i18n"
)

// BadgeSpec is a badge to show on a card.
type BadgeSpec struct {
	Tone Tone
	Icon string
	Text string
}

// ProjectCardProps describe a project card (design 04 §10).
type ProjectCardProps struct {
	Href       string
	Title      string
	Meta       string
	ThumbLabel string
	ThumbURL   string
	// Variant "studio" matches the B2 project-library card artboard.
	Variant string
	Class string
	Badges     []BadgeSpec
	// MenuLabel is the accessible name of the "…" menu button; empty hides it.
	MenuLabel string
}

// ProjectCard renders a project with the angled bottom edge on its thumbnail.
templ ProjectCard(p ProjectCardProps) {
	<article class={ Cls("mv-pcard", If(p.Variant == "studio", "mv-pcard--studio"), p.Class) }>
		if p.ThumbURL != "" {
			<div class="mv-pcard__thumb mv-card-image">
				<img src={ templ.URL(p.ThumbURL) } alt={ p.ThumbLabel } loading="lazy"/>
			</div>
		} else {
			@ToneBox(p.ThumbLabel, "", "mv-pcard__thumb")
		}
		<div class="mv-pcard__body">
			<div class="mv-pcard__head">
				<a class="mv-pcard__title" href={ templ.URL(p.Href) }>{ p.Title }</a>
				if p.MenuLabel != "" {
					// Project actions have no endpoint yet: the designed "…" stays, disabled with the Soon hint (ADR 0004 §7).
					<button type="button" class="mv-iconlink mv-pcard__menu is-soon" aria-label={ p.MenuLabel + " · " + i18n.T(ctx, "ui.soon") } title={ i18n.T(ctx, "ui.soon_hint") } disabled>
						@Icon("dots", 18)
					</button>
				}
			</div>
			if p.Meta != "" {
				<span class="mv-pcard__meta">{ p.Meta }</span>
			}
			if len(p.Badges) > 0 {
				<div class="mv-pcard__badges">
					for _, b := range p.Badges {
						@Badge(b.Tone, b.Icon, b.Text)
					}
				</div>
			}
		</div>
	</article>
}

// SeriesCardProps describe a series card with a 3:4 cover.
type SeriesCardProps struct {
	Href  string
	Title string
	Meta  string
	Stat  string
	// Badge is shown top-left on the cover ("New ch.").
	Badge string
	// Rank is the big outlined ranking number ("1").
	Rank  int
	Boxed bool
	Label string
}

func (p SeriesCardProps) label() string {
	if p.Label == "" {
		return "COVER 3:4"
	}
	return p.Label
}

// SeriesCard renders a series with its cover, optional badge and rank number.
templ SeriesCard(p SeriesCardProps) {
	<a class={ Cls("mv-scard", If(p.Boxed, "mv-scard--boxed"), If(p.Rank > 0, "mv-scard--ranked")) } href={ templ.URL(p.Href) }>
		<div class="mv-scard__cover">
			@ToneBox(p.label(), "3x4", "")
			if p.Badge != "" {
				<span class="mv-scard__badge">
					@Badge(ToneNew, "", p.Badge)
				</span>
			}
			if p.Rank > 0 {
				<span class="mv-scard__rank" aria-hidden="true">{ strconv.Itoa(p.Rank) }</span>
			}
		</div>
		<div class="mv-scard__body">
			<strong class="mv-scard__title">{ p.Title }</strong>
			if p.Meta != "" {
				<span class="mv-scard__meta">{ p.Meta }</span>
			}
			if p.Stat != "" {
				<span class="mv-scard__stat">{ p.Stat }</span>
			}
		</div>
	</a>
}

// CharacterCardProps describe a character profile card.
type CharacterCardProps struct {
	Href string
	// Kanji is the watermark glyph (e.g. 凛).
	Kanji     string
	Role      string
	FirstName string
	LastName  string
	Desc      string
	// Lock is the Character Lock score 0–1 (negative hides it); LockLabel is "Character Lock".
	Lock      float64
	LockLabel string
	ArtLabel  string
	ArtURL string
	// Variant "bible" matches the C2 character-library card artboard.
	Variant string
	Class string
	StatusLabel string
	StatusTone Tone
}

// CharacterCard renders an anime profile sheet: art, kanji watermark, big name, role and Character Lock score.
templ CharacterCard(p CharacterCardProps) {
	<article class={ Cls("mv-ccard", If(p.Variant == "bible", "mv-ccard--bible"), p.Class) }>
		if p.ArtURL != "" {
			<div class="mv-ccard__art mv-card-image">
				<img src={ templ.URL(p.ArtURL) } alt={ p.ArtLabel } loading="lazy"/>
			</div>
		} else {
			@ToneBox(p.ArtLabel, "", "mv-ccard__art")
		}
		<div class="mv-ccard__body">
			if p.Kanji != "" {
				<span class="mv-ccard__kanji" aria-hidden="true">{ p.Kanji }</span>
			}
			if p.Role != "" {
				<span class="mv-ccard__role">{ p.Role }</span>
			}
			<h2 class="mv-ccard__name">
				if p.Href != "" {
					<a href={ templ.URL(p.Href) } class="mv-link--plain">
						<span>{ p.FirstName }</span>
						<span>{ p.LastName }</span>
					</a>
				} else {
					<span>{ p.FirstName }</span>
					<span>{ p.LastName }</span>
				}
			</h2>
			if p.Desc != "" {
				<p class="mv-ccard__desc">{ p.Desc }</p>
			}
			if p.Lock >= 0 {
				<div class="mv-ccard__lock">
					<div class={ Cls("mv-lock", If(p.Lock < .9, "mv-lock--drift")) }>
						<span class="mv-lock__label">
							@Icon("lock", 14)
							{ p.LockLabel }
						</span>
						<span class="mv-lock__score">{ lockPercent(p.Lock) }</span>
					</div>
					@Bar(p.Lock, lockTone(p.Lock), false, p.LockLabel)
				</div>
			} else if p.StatusLabel != "" {
				<div class="mv-ccard__lock">
					@Badge(p.StatusTone, "photo", p.StatusLabel)
				</div>
			}
		</div>
	</article>
}

// lockPercent floors a Character Lock measurement to a whole percent and never
// lets a value below the 0.90 pass threshold read as "90%" (ADR 0011).
func lockPercent(v float64) string {
	percent := int(math.Floor(v*100 + 1e-9))
	if v < .9 && percent >= 90 {
		percent = 89
	}
	return strconv.Itoa(percent) + "%"
}

func lockTone(v float64) string {
	if v < .9 {
		return "warning"
	}
	return "success"
}

// ChapterRowProps describe a chapter row.
type ChapterRowProps struct {
	Href   string
	Number int
	Title  string
	Meta   string
	New    bool
	Read   bool
	// NewLabel is the translated "New" badge text.
	NewLabel string
	// Downloaded shows a check; otherwise a download icon.
	Downloaded    bool
	DownloadLabel string
}

func twoDigits(n int) string {
	if n >= 0 && n < 10 {
		return "0" + strconv.Itoa(n)
	}
	return strconv.Itoa(n)
}

// ChapterRow renders a chapter in a list: big number, title, meta, new / downloaded state.
templ ChapterRow(p ChapterRowProps) {
	<a class={ Cls("mv-chrow", If(p.New, "mv-chrow--new"), If(p.Read, "mv-chrow--read")) } href={ templ.URL(p.Href) }>
		<span class="mv-chrow__num">{ twoDigits(p.Number) }</span>
		<span class="mv-chrow__main">
			<strong class="mv-chrow__title">{ p.Title }</strong>
			<span class="mv-chrow__meta">{ p.Meta }</span>
		</span>
		<span class="mv-chrow__aside">
			if p.New {
				@Badge(ToneNew, "", p.NewLabel)
			}
			if p.Downloaded {
				<i class="ti ti-circle-check mv-ok-text" aria-hidden="true"></i>
				<span class="mv-sr-only">{ p.DownloadLabel }</span>
			} else {
				<i class="ti ti-download" aria-hidden="true"></i>
			}
		</span>
	</a>
}
