package ui

// Badge renders a status or provenance badge: icon + word, never colour alone (design 04 §09).
templ Badge(tone Tone, icon, text string) {
	<span class={ Cls("mv-badge", If(tone != "", "mv-badge--"+string(tone))) }>
		if icon != "" {
			@Icon(icon, 12)
		}
		{ text }
	</span>
}

// Status keys for StatusBadge.
const (
	StatusDraft     = "draft"
	StatusPublished = "published"
	StatusQueued    = "queued"
	StatusRunning   = "running"
	StatusFailed    = "failed"
	StatusLocked    = "locked"
	StatusNew       = "new"
	StatusOnline    = "online"
	StatusOffline   = "offline"
)

func statusLook(status string) (Tone, string) {
	switch status {
	case StatusPublished, StatusOnline:
		return ToneSuccess, "circle-check"
	case StatusQueued:
		return ToneInfo, "clock"
	case StatusRunning:
		return ToneInfo, "loader-2"
	case StatusFailed:
		return ToneError, "alert-triangle"
	case StatusLocked:
		return ToneWarning, "lock"
	case StatusNew:
		return ToneNew, ""
	case StatusOffline:
		return ToneMuted, "plug-connected-x"
	}
	return ToneNeutral, ""
}

// StatusBadge renders the badge for a well-known status with its icon; text is the translated word.
templ StatusBadge(status, text string) {
	{{ tone, icon := statusLook(status) }}
	@Badge(tone, icon, text)
}

// Provenance roles and labels (product rule 5: honest provenance).
const (
	ProvenanceAI         = "ai"
	ProvenanceAIAssisted = "ai_assisted"
	ProvenanceHuman      = "human"
	ProvenanceSelfHost   = "self_host"
)

// ProvenanceBadge renders the AI-assisted / hand-drawn / self-host label.
templ ProvenanceBadge(kind, text string) {
	switch kind {
		case ProvenanceAI, ProvenanceAIAssisted:
			@Badge(ToneText, "sparkles", text)
		case ProvenanceHuman:
			@Badge(ToneText, "brush", text)
		default:
			@Badge(ToneMuted, "server", text)
	}
}

// AvatarProps configure an avatar.
type AvatarProps struct {
	Name string
	// Key picks the colour (user id); defaults to Name.
	Key string
	// Src is an image URL; initials are shown when empty.
	Src string
	// Size is "xs" 24, "sm" 28, "" 30, "md" 36, "lg" 48.
	Size   string
	Online bool
	Class  string
}

func (p AvatarProps) class() string {
	key := p.Key
	if key == "" {
		key = p.Name
	}
	return Cls("mv-avatar", AvatarColor(key), If(p.Size != "", "mv-avatar--"+p.Size), If(p.Online, "mv-avatar--online"), p.Class)
}

// Avatar renders a round avatar with initials or a photo; Online adds the green ring.
templ Avatar(p AvatarProps) {
	<span class={ p.class() } title={ p.Name }>
		if p.Src != "" {
			<img src={ p.Src } alt={ p.Name } loading="lazy"/>
		} else {
			<span aria-hidden="true">{ Initials(p.Name) }</span>
			<span class="mv-sr-only">{ p.Name }</span>
		}
	</span>
}

// AvatarStack renders overlapping avatars with a "+n" counter.
templ AvatarStack(people []AvatarProps, more int) {
	<span class="mv-avatar-stack">
		for _, p := range people {
			@Avatar(AvatarProps{Name: p.Name, Key: p.Key, Src: p.Src, Size: "md", Online: p.Online, Class: "mv-avatar--stack"})
		}
		if more > 0 {
			<span class="mv-avatar-stack__more">+{ fmtNum(float64(more)) }</span>
		}
	</span>
}

// Tab is one tab of a Tabs bar.
type Tab struct {
	Href    string
	Label   string
	Count   string
	Current bool
	Icon    string
}

// Tabs renders link tabs with the 3 px accent underline (design 04 §09).
templ Tabs(label string, tabs []Tab) {
	<nav class="mv-tabs" aria-label={ label }>
		for _, t := range tabs {
			<a
				class="mv-tabs__tab"
				href={ templ.URL(t.Href) }
				if t.Current {
					aria-current="page"
				}
			>
				{ t.Label }
				if t.Count != "" {
					<span class="mv-tabs__count">{ t.Count }</span>
				}
			</a>
		}
	</nav>
}

// Tone renders a labelled screentone placeholder (all artwork is placeholder art).
// shape is "", "3x4", "square" or "page"; class adds sizing classes.
templ ToneBox(label, shape, class string) {
	<div class={ Cls("mv-tone", If(shape != "", "mv-tone--"+shape), class) } role="img" aria-label={ label }>
		if label != "" {
			<span class="mv-tone__label" aria-hidden="true">{ label }</span>
		}
		{ children... }
	</div>
}

// Skeleton renders the moving-screentone skeleton (only for AI results).
templ Skeleton(label string) {
	<div class="mv-skeleton" role="status" aria-label={ label }>
		<div class="mv-skeleton__block mv-skeleton__art"></div>
		<div class="mv-skeleton__lines">
			<div class="mv-skeleton__block mv-skeleton__line mv-skeleton__line--title"></div>
			<div class="mv-skeleton__block mv-skeleton__line"></div>
			<div class="mv-skeleton__block mv-skeleton__line"></div>
			<div class="mv-skeleton__block mv-skeleton__line"></div>
		</div>
	</div>
}

// Bar renders a thin progress bar (value 0–1). tone: "", "success", "warning", "error".
templ Bar(value float64, tone string, thick bool, label string) {
	<div
		class={ Cls("mv-bar", Pct(value), If(tone != "", "mv-bar--"+tone), If(thick, "mv-bar--thick")) }
		role="progressbar"
		aria-valuemin="0"
		aria-valuemax="100"
		aria-valuenow={ fmtNum(float64(int(value*100 + .5))) }
		if label != "" {
			aria-label={ label }
		}
	></div>
}

// PageHead renders the page title, subtitle and actions (kit.js pageHead).
templ PageHead(title, sub string, actions templ.Component) {
	<header class="mv-pagehead">
		<div class="mv-pagehead__text">
			<h1 class="mv-pagehead__title">{ title }</h1>
			if sub != "" {
				<span class="mv-pagehead__sub">{ sub }</span>
			}
		</div>
		if actions != nil {
			<div class="mv-pagehead__actions">
				@actions
			</div>
		}
	</header>
}

// Box renders a surface panel with a border (kit.js box).
templ Box(class string) {
	<div class={ Cls("mv-box", class) }>
		{ children... }
	</div>
}

// KV renders a key/value row.
templ KV(key, value string) {
	<div class="mv-kv">
		<span class="mv-kv__key">{ key }</span>
		<span class="mv-kv__value">{ value }</span>
	</div>
}

// KVC renders a key/value row whose value is a component.
templ KVC(key string) {
	<div class="mv-kv">
		<span class="mv-kv__key">{ key }</span>
		<span class="mv-kv__value">
			{ children... }
		</span>
	</div>
}

// Step is one step of a stepper.
type Step struct {
	Label string
	Href  string
	Done  bool
	// Current marks the active step.
	Current bool
}

// Steps renders the numbered progress bars used by the setup wizard and onboarding.
templ Steps(label string, steps []Step) {
	<ol class="mv-steps mv-list-plain" aria-label={ label }>
		for _, s := range steps {
			<li class={ Cls("mv-steps__step", If(s.Done, "is-done"), If(s.Current, "is-current")) }>
				<span class="mv-steps__bar" aria-hidden="true"></span>
				<span
					class="mv-steps__label"
					if s.Current {
						aria-current="step"
					}
				>{ s.Label }</span>
			</li>
		}
	</ol>
}

// SetRow renders a settings row: title, description and a control on the right.
templ SetRow(title, desc string) {
	<div class="mv-setrow">
		<div class="mv-setrow__text">
			<span class="mv-setrow__title">{ title }</span>
			if desc != "" {
				<span class="mv-setrow__desc">{ desc }</span>
			}
		</div>
		<div class="mv-setrow__control">
			{ children... }
		</div>
	</div>
}

// ToggleRow renders a settings row with a switch that labels itself by the row title.
templ ToggleRow(id, name, title, desc string, checked bool, attrs templ.Attributes) {
	<div class="mv-setrow">
		<label class="mv-setrow__text" for={ id }>
			<span class="mv-setrow__title">{ title }</span>
			if desc != "" {
				<span class="mv-setrow__desc">{ desc }</span>
			}
		</label>
		<div class="mv-setrow__control">
			@Toggle(ToggleProps{ID: id, Name: name, Checked: checked, Attrs: attrs})
		</div>
	</div>
}

// Notice renders an inline message with an icon (success, info, warning, error).
templ Notice(tone Tone, icon string) {
	<div class={ Cls("mv-notice", If(tone != "", "mv-notice--"+string(tone))) } role={ noticeRole(tone) }>
		@Icon(icon, 18)
		<div>
			{ children... }
		</div>
	</div>
}

func noticeRole(t Tone) string {
	if t == ToneError {
		return "alert"
	}
	return "status"
}

// Kbd renders a keyboard key.
templ Kbd(key string) {
	<kbd class="mv-kbd">{ key }</kbd>
}
