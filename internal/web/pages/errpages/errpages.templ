// Package errpages renders the G6 system pages: 404 (SHIIN…), server error
// (GASHAN!), forbidden (HMMM…), offline (PUTSUN) and maintenance (GARA GARA).
package errpages

import (
	"github.com/MaramHarsha/MangaVeyra/internal/i18n"
	"github.com/MaramHarsha/MangaVeyra/internal/web/ui"
)

// NotFound is the G6 404 page: outlined 404, SHIIN… and two ways out.
templ NotFound(signedIn bool) {
	<section class="mv-state mv-state--page" aria-labelledby="mv-err-title">
		<div class="mv-tex-splash-soft" aria-hidden="true"></div>
		<span class="mv-state__outline" aria-hidden="true">404</span>
		@ui.SFX(i18n.T(ctx, "error.not_found.sfx"), "lg", "accent", false)
		<h1 class="mv-state__title mv-state__title--lg" id="mv-err-title">{ i18n.T(ctx, "errors.404.title") }</h1>
		<p class="mv-state__body mv-state__body--lg">{ i18n.T(ctx, "errors.404.body") }</p>
		<div class="mv-state__actions">
			// G6 404: "Go to Explore" + "Search". Until Explore exists, the
			// primary action falls back to a page that does, so a 404 is never a
			// dead end.
			if ui.Ready(ctx, "/explore") {
				@ui.LinkButton("/explore", ui.ButtonProps{Variant: ui.Primary}) {
					{ i18n.T(ctx, "errors.404.explore") }
				}
			} else if signedIn {
				@ui.LinkButton("/studio", ui.ButtonProps{Variant: ui.Primary}) {
					{ i18n.T(ctx, "errors.404.studio") }
				}
			} else {
				@ui.LinkButton("/login", ui.ButtonProps{Variant: ui.Primary}) {
					{ i18n.T(ctx, "auth.login.submit") }
				}
			}
			@ui.LinkButton("/search", ui.ButtonProps{Variant: ui.Secondary}) {
				{ i18n.T(ctx, "errors.404.search") }
			}
		</div>
	</section>
}

// ServerError is the G6 error page for 5xx responses (GASHAN!).
templ ServerError(message, requestID string) {
	<section class="mv-state mv-state--page" aria-labelledby="mv-err-title">
		<div class="mv-tex-speedlines mv-tex-speedlines--wide mv-tex-speedlines--error" aria-hidden="true"></div>
		<div class="mv-tex-calm mv-tex-calm--wide" aria-hidden="true"></div>
		@ui.SFX(i18n.T(ctx, "error.internal.sfx"), "xl", "error", false)
		<h1 class="mv-state__title mv-state__title--lg" id="mv-err-title">{ i18n.T(ctx, "errors.500.title") }</h1>
		<p class="mv-state__body mv-state__body--lg">{ message }</p>
		<div class="mv-state__actions">
			@ui.LinkButton("", ui.ButtonProps{Variant: ui.Primary, Icon: "refresh"}) {
				{ i18n.T(ctx, "errors.500.retry") }
			}
			@ui.LinkButton("/", ui.ButtonProps{Variant: ui.Secondary}) {
				{ i18n.T(ctx, "errors.home") }
			}
		</div>
		if requestID != "" {
			<span class="mv-state__meta">{ i18n.T(ctx, "errors.request_id", "id", requestID) }</span>
		}
	</section>
}

// Generic renders other errors (401, 403, 405, 409, 413, 429…) with HMMM… and the message.
templ Generic(status int, title, message string) {
	<section class="mv-state mv-state--page" aria-labelledby="mv-err-title">
		<div class="mv-tex-splash-soft" aria-hidden="true"></div>
		@ui.SFX(i18n.T(ctx, "errors.generic.sfx"), "xl", "accent", false)
		<h1 class="mv-state__title mv-state__title--lg" id="mv-err-title">{ title }</h1>
		<p class="mv-state__body mv-state__body--lg">{ message }</p>
		<div class="mv-state__actions">
			if status == 401 {
				@ui.LinkButton("/login", ui.ButtonProps{Variant: ui.Primary}) {
					{ i18n.T(ctx, "auth.login.submit") }
				}
			}
			@ui.LinkButton("/", ui.ButtonProps{Variant: ui.Secondary}) {
				{ i18n.T(ctx, "errors.home") }
			}
		</div>
		<span class="mv-state__meta">{ itoa(status) }</span>
	</section>
}

// Offline is the G6 offline page (PUTSUN), precached by the service worker.
templ Offline() {
	<section class="mv-state mv-state--page" aria-labelledby="mv-err-title">
		<div class="mv-tex-speedlines mv-tex-speedlines--wide" aria-hidden="true"></div>
		<div class="mv-tex-calm mv-tex-calm--wide" aria-hidden="true"></div>
		@ui.SFX(i18n.T(ctx, "errors.offline.sfx"), "xxl", "", false)
		<h1 class="mv-state__title mv-state__title--lg" id="mv-err-title">{ i18n.T(ctx, "errors.offline.title") }</h1>
		<p class="mv-state__body mv-state__body--lg">{ i18n.T(ctx, "errors.offline.body") }</p>
		<div class="mv-state__actions">
			@ui.LinkButton("/library/downloads", ui.ButtonProps{Variant: ui.Primary, Icon: "download"}) {
				{ i18n.T(ctx, "errors.offline.downloads") }
			}
		</div>
	</section>
}

// Maintenance is the G6 maintenance page (GARA GARA) shown while an admin updates the server.
templ Maintenance(instance, message string) {
	<section class="mv-state mv-state--page" aria-labelledby="mv-err-title">
		<div class="mv-tex-speedlines mv-tex-speedlines--wide" aria-hidden="true"></div>
		<div class="mv-tex-calm mv-tex-calm--wide" aria-hidden="true"></div>
		@ui.SFX(i18n.T(ctx, "gate.maintenance.sfx"), "xl", "warning", false)
		<h1 class="mv-state__title mv-state__title--lg" id="mv-err-title">{ i18n.T(ctx, "errors.maintenance.title", "instance", instance) }</h1>
		<p class="mv-state__body mv-state__body--lg">{ message }</p>
		<div class="mv-state__actions">
			<span class="mv-state__meta">{ i18n.T(ctx, "errors.maintenance.meta") }</span>
		</div>
		<meta http-equiv="refresh" content="30"/>
	</section>
}
