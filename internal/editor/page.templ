package editor

import (
	"fmt"
	"github.com/MaramHarsha/MangaVeyra/internal/pagedoc"
	"github.com/MaramHarsha/MangaVeyra/internal/web/layout"
	"github.com/MaramHarsha/MangaVeyra/internal/web/ui"
)

templ EditorDocument(c *layout.Chrome, data bootstrapData, props string) {
	@layout.EditorShell(c) {
		<div class="mv-ed" data-island="editor" data-props={ props }>
			<header class="mv-ed__bar">
				<a href={ templ.URL("/studio/p/" + data.Project.ID + "/story/" + data.Chapter.ID) } class="mv-ed__back" aria-label={ label(ctx, "back") }>@ui.Icon("arrow-left", 20)
</a>
				<span class="mv-ed__project">{ data.Project.Title }</span><strong>{ fmt.Sprintf("%d · %s",data.Chapter.Number,data.Chapter.Title) }</strong>
				<div class="mv-seg"><span class="mv-seg__item">{ label(ctx,"pages") }</span></div>
				<div class="mv-ed__bar-end">
					@ui.LinkButton(exportHref(data), ui.ButtonProps{Variant: ui.Secondary, Size: ui.SM, Icon: "download"}) {
						{ label(ctx,"export") }
					}
				</div>
			</header>
			<aside class="mv-ed__left">
				<div class="mv-ed__section-head"><strong>{ label(ctx,"pages") }</strong></div>
				<nav class="mv-ed__filmstrip" aria-label={ label(ctx, "pages") }>
					for _,page:=range data.Pages {
						<a class="mv-ed__page-thumb" href={ templ.URL(pageHref(data, page.Number)) } aria-current={ pageCurrent(data, page.ID) }>
							if page.Thumb!=nil&&page.Thumb.URL!="" {
								<img src={ page.Thumb.URL } alt={ fmt.Sprintf("%d", page.Number) }/>
							} else {
								@ui.ToneBox(fmt.Sprintf("%d", page.Number), "", "mv-ed__thumb-art")
							}
							<span>{ fmt.Sprintf("%d",page.Number) }</span>
						</a>
					}
				</nav>
			</aside>
			<section class="mv-ed__stage" aria-label={ label(ctx, "canvas") }>
				if data.Current!=nil {
					@ReadOnlyPage(*data.Current)
				} else {
					@ui.State(ui.StateProps{Title: label(ctx, "empty.title"), Body: label(ctx, "empty.body")})
				}
			</section>
			<aside class="mv-ed__right"><div class="mv-ed__section-head"><strong>{ label(ctx,"properties") }</strong></div><p class="mv-ed__help">{ label(ctx,"loading_editor") }</p><noscript><p class="mv-ed__help">{ label(ctx,"requires_js") }</p></noscript></aside>
			<footer class="mv-ed__footer"><span>{ data.Project.Format }</span><span>{ data.Project.PageSize }</span><span>{ label(ctx,"lettering_independent") }</span></footer>
		</div>
	}
}

func pageCurrent(data bootstrapData, id string) string {
	if data.Current != nil && data.Current.Page.ID == id {
		return "page"
	}
	return "false"
}

templ ReadOnlyPage(v pageResponse) {
	<svg class="mv-ed__proof" viewBox={ rectView(v.Page) } role="img" aria-label={ label(ctx, "canvas") }>
		<rect width={ fmt.Sprint(v.Page.Width) } height={ fmt.Sprint(v.Page.Height) } fill="#ffffff"></rect>
		for _,pn:=range v.Page.Panels {
			<polygon points={ polygonString(pn.Points) } fill="#dce3f3" stroke="#070a12" stroke-width="4"></polygon>
		}
		for _,l:=range v.Lettering {
			<g transform={ rotation(l.Rotate, l.RotationCenter.X, l.RotationCenter.Y) }>
				if l.ShapePath!="" {
					<path d={ l.ShapePath } fill={ l.Fill } stroke={ l.Stroke } stroke-width={ fmt.Sprint(l.StrokeWidth) }></path>
				}
				<path d={ l.TextPath } fill={ l.TextColor } stroke={ l.TextStroke } stroke-width={ fmt.Sprint(l.TextStrokeWidth) }></path>
			</g>
		}
	</svg>
}

var _ = pagedoc.Schema
