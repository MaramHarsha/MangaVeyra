package ai

import (
	"context"
	"strconv"
	"strings"

	"github.com/MaramHarsha/MangaVeyra/internal/i18n"
	"github.com/MaramHarsha/MangaVeyra/internal/web/ui"
)

func routingOptions(ctx context.Context, disabled bool) []ui.Option {
	options := []ui.Option{}
	for _, mode := range []string{ModeBalanced, ModeBest, ModeFastest, ModeLocalOnly, ModeFreeOnly} {
		options = append(options, ui.Option{Value: mode, Label: i18n.T(ctx, "aiimage.mode."+mode), Disabled: disabled})
	}
	return options
}

// decisionProvider is the provider word of a decision ("local", "OpenRouter").
func decisionProvider(ctx context.Context, d routingDecisionView) string {
	switch d.Provider {
	case PlaceholderID:
		return i18n.T(ctx, "aiimage.decision.builtin")
	case providerKindWorker:
		return i18n.T(ctx, "aiimage.decision.local")
	}
	if d.ProviderKind == providerKindLocalText {
		return i18n.T(ctx, "aiimage.decision.local")
	}
	if d.ProviderKind != "" {
		return providerKindName(d.ProviderKind)
	}
	return i18n.T(ctx, "aiimage.decision.removed")
}

// decisionReason says in words why the router chose the model.
func decisionReason(ctx context.Context, d routingDecisionView) string {
	reason := i18n.T(ctx, "aiimage.decision.scored", "mode", i18n.T(ctx, "aiimage.mode."+d.Mode))
	switch {
	case d.Overridden:
		reason = i18n.T(ctx, "aiimage.decision.pinned")
	case d.Provider == PlaceholderID && d.Mode == ModeLocalOnly:
		reason = i18n.T(ctx, "aiimage.decision.local_only")
	case d.Provider == PlaceholderID:
		reason = i18n.T(ctx, "aiimage.decision.placeholder")
	}
	if d.Explanation != "" {
		reason += " · " + d.Explanation
	}
	return reason
}

func routingTaskLabel(ctx context.Context, task string) string {
	if strings.TrimSpace(task) == "" {
		return ""
	}
	return i18n.T(ctx, "aiimage.task."+task)
}

// RoutingPage is G11 Model routing: the mode switch, recent decisions, pins
// and guards. People who cannot change a control see it read-only: guards and
// the mode switch are admin settings, and pins need a project you own.
templ RoutingPage(v routingView) {
	<div class="mv-airouting">
		@ui.PageHead(i18n.T(ctx, "aiimage.routing.title"), i18n.T(ctx, "aiimage.routing.subtitle"), routingModes(v))
		if v.Notice == "1" {
			@ui.Notice(ui.ToneSuccess, "check") {
				{ i18n.T(ctx,"aiimage.saved") }
			}
		}
		if v.Error != "" {
			@ui.Notice(ui.ToneError, "alert-triangle") {
				{ v.Error }
			}
		}
		<div class="mv-airouting__columns">
			<section class="mv-airouting__decisions" aria-labelledby="routing-decisions">
				<h2 id="routing-decisions">{ i18n.T(ctx,"aiimage.routing.recent") }</h2>
				<ol class="mv-list-plain">
					for _,decision:=range v.Decisions {
						<li class="mv-airouting__decision">
							<span>{ routingTaskLabel(ctx, decision.Task) }</span>
							<div>
								<strong>{ v.modelName(decision.Model) } · { decisionProvider(ctx, decision) }</strong>
								<p>{ decisionReason(ctx, decision) }</p>
							</div>
						</li>
					}
					if len(v.Decisions)==0 {
						<li class="mv-airouting__empty">{ i18n.T(ctx,"aiimage.routing.no_decisions") }</li>
					}
				</ol>
			</section>
			<div class="mv-airouting__side">
				<section class="mv-airouting__box" aria-labelledby="routing-pins">
					<h2 id="routing-pins">{ i18n.T(ctx,"aiimage.routing.pins") }</h2>
					for _,pin:=range v.Pins {
						<div class="mv-airouting__pin">
							<span>{ routingTaskLabel(ctx, pin.Task) }<small>{ i18n.T(ctx,"aiimage.scope."+pin.Scope) } · { pin.ScopeID }</small></span><strong>{ v.modelName(pin.Model) }</strong>
							if pin.Editable {
								<form method="post" action={ templ.URL("/models/routing/pins/" + pin.ID + "/delete") } novalidate>
									@ui.Button(ui.ButtonProps{Type: "submit", Variant: ui.Ghost, Size: ui.SM, Icon: "x", Label: i18n.T(ctx, "aiimage.routing.remove_pin")}) {
										<span class="mv-sr-only">{ i18n.T(ctx,"aiimage.routing.remove_pin") }</span>
									}
								</form>
							}
						</div>
					}
					if len(v.Pins)==0 {
						<p class="mv-airouting__muted">{ i18n.T(ctx,"aiimage.routing.no_pins") }</p>
					}
					if v.CanPin {
						@routingPinForm(v)
					}
				</section>
				@routingGuards(v)
			</div>
		</div>
	</div>
}

templ routingPinForm(v routingView) {
	<details class="mv-airouting__add-pin">
		<summary>{ i18n.T(ctx,"aiimage.routing.add_pin") }</summary>
		<form method="post" action="/models/routing/pins" novalidate class="mv-airouting__pin-form">
			@ui.Field(ui.FieldProps{ID: "pin-scope", Label: i18n.T(ctx, "aiimage.routing.scope")}) {
				@ui.Select(ui.SelectProps{ID: "pin-scope", Name: "scope", Options: pinScopeOptions(ctx, v.Admin)})
			}
			@ui.Field(ui.FieldProps{ID: "pin-target", Label: i18n.T(ctx, "aiimage.routing.target"), Hint: i18n.T(ctx, "aiimage.routing.target_hint")}) {
				@ui.Input(ui.InputProps{ID: "pin-target", Name: "scope_id", Described: true, MaxLength: 80})
			}
			@ui.Field(ui.FieldProps{ID: "pin-task", Label: i18n.T(ctx, "aiimage.routing.task")}) {
				@ui.Select(ui.SelectProps{ID: "pin-task", Name: "task", Options: pinTaskOptions(ctx)})
			}
			@ui.Field(ui.FieldProps{ID: "pin-model", Label: i18n.T(ctx, "aiimage.custom.model")}) {
				@ui.Select(ui.SelectProps{ID: "pin-model", Name: "model", Options: pinModelOptions(v.Models)})
			}
			@ui.Button(ui.ButtonProps{Type: "submit", Variant: ui.Quiet, Size: ui.SM}) {
				{ i18n.T(ctx,"aiimage.routing.save_pin") }
			}
		</form>
	</details>
}

func routingAmount(v routingView) string {
	return strconv.FormatFloat(v.limitAmount(), 'f', -1, 64)
}

// routingGuards is the designed Guards box: one row per guard, label and
// switch. The spend row reads "Monthly remote spend limit · $20" as designed;
// an admin edits the amount in place. With JavaScript every change saves at
// once (lib/models.ts); without it the Save button submits the same form.
// Only admins can change guards, so everyone else sees them read-only.
templ routingGuards(v routingView) {
	<form
		id="routing-settings"
		method="post"
		action="/models/routing"
		novalidate
		class="mv-airouting__box"
		if v.Admin {
			data-autosave
			data-saved-label={ i18n.T(ctx, "aiimage.saved") }
			data-error-label={ i18n.T(ctx, "aiimage.routing.save_failed") }
		}
	>
		<h2>{ i18n.T(ctx,"aiimage.routing.guards") }</h2>
		<div class="mv-airouting__guard">
			<label for="licence-guard">{ i18n.T(ctx,"aiimage.routing.licence") }</label>
			@ui.Toggle(ui.ToggleProps{ID: "licence-guard", Name: "licence_guard", Value: "true", Checked: v.LicenceGuard, Disabled: !v.Admin})
		</div>
		<div class="mv-airouting__guard">
			if v.Admin {
				<span class="mv-airouting__limit">
					<label for="routing-limit-on">{ i18n.T(ctx,"aiimage.routing.limit") } · $</label>
					<input
						class="mv-input mv-airouting__amount"
						id="routing-limit"
						name="limit"
						type="number"
						inputmode="decimal"
						min="0.01"
						step="0.01"
						value={ routingAmount(v) }
						aria-label={ i18n.T(ctx, "aiimage.routing.limit_amount") }
					/>
				</span>
			} else {
				<label for="routing-limit-on">{ i18n.T(ctx, "aiimage.routing.limit_value", "amount", formatUSD(v.limitAmount())) }</label>
			}
			@ui.Toggle(ui.ToggleProps{ID: "routing-limit-on", Name: "limit_on", Value: "true", Checked: v.Limit > 0, Disabled: !v.Admin})
		</div>
		<div class="mv-airouting__guard">
			<span id="routing-learn-label">
				{ i18n.T(ctx,"aiimage.routing.learn") } @ui.SoonTag()
			</span>
			@ui.Toggle(ui.ToggleProps{ID: "routing-learn", Disabled: true, Attrs: templ.Attributes{"aria-labelledby": "routing-learn-label"}})
		</div>
		<div class="mv-airouting__guard">
			<label for="users-add-providers">{ i18n.T(ctx,"aiimage.routing.users") }</label>
			@ui.Toggle(ui.ToggleProps{ID: "users-add-providers", Name: "users_may_add", Value: "true", Checked: v.UsersMayAdd, Disabled: !v.Admin})
		</div>
		<div class="mv-airouting__guard">
			<label for="private-endpoints">{ i18n.T(ctx,"aiimage.routing.private") }</label>
			@ui.Toggle(ui.ToggleProps{ID: "private-endpoints", Name: "private_endpoints", Value: "true", Checked: v.PrivateEndpoints, Disabled: !v.Admin})
		</div>
		if v.Admin {
			<div class="mv-airouting__save mv-nojs-only">
				@ui.Button(ui.ButtonProps{Type: "submit", Variant: ui.Quiet, Size: ui.SM}) {
					{ i18n.T(ctx,"aiimage.routing.save") }
				}
			</div>
		} else {
			<p class="mv-airouting__muted">{ i18n.T(ctx,"aiimage.routing.admin_only") }</p>
		}
	</form>
}

templ routingModes(v routingView) {
	@ui.Segmented(ui.SegmentedProps{Name: "mode", Value: v.Mode, Options: routingOptions(ctx, !v.Admin), Label: i18n.T(ctx, "aiimage.routing.title"), InputAttrs: templ.Attributes{"form": "routing-settings"}})
}

func pinScopeOptions(ctx context.Context, admin bool) []ui.Option {
	return []ui.Option{{Value: "project", Label: i18n.T(ctx, "aiimage.scope.project")}, {Value: "character", Label: i18n.T(ctx, "aiimage.scope.character")}, {Value: "panel_type", Label: i18n.T(ctx, "aiimage.scope.panel_type"), Disabled: !admin}, {Value: "server", Label: i18n.T(ctx, "aiimage.scope.server"), Disabled: !admin}}
}
func pinTaskOptions(ctx context.Context) []ui.Option {
	out := []ui.Option{}
	for _, task := range []string{TaskPanel, TaskCharacterSheet, TaskRegionEdit, TaskCover} {
		out = append(out, ui.Option{Value: task, Label: i18n.T(ctx, "aiimage.task."+task)})
	}
	return out
}
func pinModelOptions(models []ModelManifest) []ui.Option {
	out := []ui.Option{}
	for _, model := range models {
		out = append(out, ui.Option{Value: model.ID, Label: model.Name})
	}
	return out
}
