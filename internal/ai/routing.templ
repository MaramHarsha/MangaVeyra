package ai

import (
	"context"
	"fmt"
	"github.com/MaramHarsha/MangaVeyra/internal/i18n"
	"github.com/MaramHarsha/MangaVeyra/internal/web/ui"
)

func routingOptions(ctx context.Context, disabled bool) []ui.Option {
	options := []ui.Option{}
	for _, mode := range []string{ModeBalanced, ModeBest, ModeFastest, ModeLocalOnly, ModeFreeOnly} {
		options = append(options, ui.Option{Value: mode, Label: i18n.T(ctx, "aiimage.mode."+mode), Disabled: disabled})
	}
	return options
}

templ RoutingPage(v routingView) {
	<div class="mv-airouting">
		@ui.PageHead(i18n.T(ctx, "aiimage.routing.title"), i18n.T(ctx, "aiimage.routing.subtitle"), routingModes(v))
		if v.Notice == "1" {
			@ui.Notice(ui.ToneSuccess, "check") {
				{ i18n.T(ctx,"aiimage.saved") }
			}
		}
		<div class="mv-airouting__columns">
			<section class="mv-airouting__decisions" aria-labelledby="routing-decisions">
				<h2 id="routing-decisions">{ i18n.T(ctx,"aiimage.routing.recent") }</h2>
				<ol class="mv-list-plain">
					for _,decision:=range v.Decisions {
						<li class="mv-airouting__decision"><span>{ decision.Task }</span><div><strong>{ decision.Model }</strong><p>{ decision.Explanation }</p></div></li>
					}
					if len(v.Decisions)==0 {
						<li class="mv-airouting__empty">{ i18n.T(ctx,"aiimage.routing.no_decisions") }</li>
					}
				</ol>
			</section>
			<div class="mv-airouting__side">
				<section class="mv-airouting__box" aria-labelledby="routing-pins">
					<h2 id="routing-pins">{ i18n.T(ctx,"aiimage.routing.pins") }</h2>
					for _,pin:=range v.Pins {
						<div class="mv-airouting__pin">
							<span>{ pin.Task }<small>{ pin.Scope } · { pin.ScopeID }</small></span><strong>{ pin.Model }</strong>
							if pin.Editable {
								<form method="post" action={ templ.URL("/models/routing/pins/" + pin.ID + "/delete") } novalidate>
									@ui.Button(ui.ButtonProps{Type: "submit", Variant: ui.Ghost, Size: ui.SM, Icon: "x", Label: i18n.T(ctx, "aiimage.routing.remove_pin")}) {
										<span class="mv-sr-only">{ i18n.T(ctx,"aiimage.routing.remove_pin") }</span>
									}
								</form>
							}
						</div>
					}
					if len(v.Pins)==0 {
						<p class="mv-airouting__muted">{ i18n.T(ctx,"aiimage.routing.no_pins") }</p>
					}
					<details class="mv-airouting__add-pin">
						<summary>{ i18n.T(ctx,"aiimage.routing.add_pin") }</summary>
						<form method="post" action="/models/routing/pins" novalidate class="mv-airouting__pin-form">
							@ui.Field(ui.FieldProps{ID: "pin-scope", Label: i18n.T(ctx, "aiimage.routing.scope")}) {
								@ui.Select(ui.SelectProps{ID: "pin-scope", Name: "scope", Options: pinScopeOptions(ctx, v.Admin)})
							}
							@ui.Field(ui.FieldProps{ID: "pin-target", Label: i18n.T(ctx, "aiimage.routing.target"), Hint: i18n.T(ctx, "aiimage.routing.target_hint")}) {
								@ui.Input(ui.InputProps{ID: "pin-target", Name: "scope_id", Described: true, MaxLength: 80})
							}
							@ui.Field(ui.FieldProps{ID: "pin-task", Label: i18n.T(ctx, "aiimage.routing.task")}) {
								@ui.Select(ui.SelectProps{ID: "pin-task", Name: "task", Options: pinTaskOptions(ctx)})
							}
							@ui.Field(ui.FieldProps{ID: "pin-model", Label: i18n.T(ctx, "aiimage.custom.model")}) {
								@ui.Select(ui.SelectProps{ID: "pin-model", Name: "model", Options: pinModelOptions(v.Models)})
							}
							@ui.Button(ui.ButtonProps{Type: "submit", Variant: ui.Quiet, Size: ui.SM}) {
								{ i18n.T(ctx,"aiimage.routing.save_pin") }
							}
						</form>
					</details>
				</section>
				<form id="routing-settings" method="post" action="/models/routing" novalidate class="mv-airouting__box">
					<h2>{ i18n.T(ctx,"aiimage.routing.guards") }</h2>
					<div class="mv-airouting__guard"><label for="licence-guard">{ i18n.T(ctx,"aiimage.routing.licence") }</label>@ui.Toggle(ui.ToggleProps{ID: "licence-guard", Name: "licence_guard", Value: "true", Checked: v.LicenceGuard, Disabled: !v.Admin, AriaLabel: i18n.T(ctx, "aiimage.routing.licence")})
</div>
					@ui.Field(ui.FieldProps{ID: "routing-limit", Label: i18n.T(ctx, "aiimage.routing.limit"), Hint: i18n.T(ctx, "aiimage.routing.limit_hint")}) {
						@ui.Input(ui.InputProps{ID: "routing-limit", Name: "limit", Type: "number", Value: fmt.Sprintf("%g", v.Limit), Disabled: !v.Admin, Described: true, Attrs: templ.Attributes{"min": "0", "step": "0.000001"}})
					}
					<div class="mv-airouting__guard"><span>{ i18n.T(ctx,"aiimage.routing.learn") } @ui.SoonTag()
</span>@ui.Toggle(ui.ToggleProps{ID: "routing-learn", Disabled: true, AriaLabel: i18n.T(ctx, "aiimage.routing.learn")})
</div>
					<div class="mv-airouting__guard"><label for="users-add-providers">{ i18n.T(ctx,"aiimage.routing.users") }</label>@ui.Toggle(ui.ToggleProps{ID: "users-add-providers", Name: "users_may_add", Value: "true", Checked: v.UsersMayAdd, Disabled: !v.Admin, AriaLabel: i18n.T(ctx, "aiimage.routing.users")})
</div>
					if v.Admin {
						@ui.Button(ui.ButtonProps{Type: "submit", Variant: ui.Quiet, Size: ui.SM}) {
							{ i18n.T(ctx,"aiimage.routing.save") }
						}
					}
				</form>
			</div>
		</div>
	</div>
}

templ routingModes(v routingView) {
	@ui.Segmented(ui.SegmentedProps{Name: "mode", Value: v.Mode, Options: routingOptions(ctx, !v.Admin), Label: i18n.T(ctx, "aiimage.routing.title"), InputAttrs: templ.Attributes{"form": "routing-settings"}})
}

func pinScopeOptions(ctx context.Context, admin bool) []ui.Option {
	return []ui.Option{{Value: "project", Label: i18n.T(ctx, "aiimage.scope.project")}, {Value: "character", Label: i18n.T(ctx, "aiimage.scope.character")}, {Value: "panel_type", Label: i18n.T(ctx, "aiimage.scope.panel_type"), Disabled: !admin}, {Value: "server", Label: i18n.T(ctx, "aiimage.scope.server"), Disabled: !admin}}
}
func pinTaskOptions(ctx context.Context) []ui.Option {
	out := []ui.Option{}
	for _, task := range []string{TaskPanel, TaskCharacterSheet, TaskRegionEdit, TaskCover} {
		out = append(out, ui.Option{Value: task, Label: i18n.T(ctx, "aiimage.task."+task)})
	}
	return out
}
func pinModelOptions(models []ModelManifest) []ui.Option {
	out := []ui.Option{}
	for _, model := range models {
		out = append(out, ui.Option{Value: model.ID, Label: model.Name})
	}
	return out
}

func customProgress(ctx context.Context, step string) []ui.Step {
	steps := []ui.Step{}
	for i, s := range customSteps {
		steps = append(steps, ui.Step{Label: fmt.Sprintf("%d. %s", i+1, i18n.T(ctx, "aiimage.custom.step."+s)), Current: s == step, Done: i+1 < customStepNumber(step)})
	}
	return steps
}

templ CustomProviderPage(v customProviderView) {
	<div class="mv-aicustom">
		@ui.PageHead(i18n.T(ctx, "aiimage.custom.title"), i18n.T(ctx, "aiimage.custom.progress", "number", customStepNumber(v.Step), "name", i18n.T(ctx, "aiimage.custom.step."+v.Step)), nil)
		@ui.Steps(i18n.T(ctx, "aiimage.custom.steps"), customProgress(ctx, v.Step))
		if v.LocalOnly {
			@ui.Notice(ui.ToneWarning, "shield-lock") {
				{ i18n.T(ctx,"models.local_only.body") }
			}
		}
		if v.Notice!="" {
			@ui.Notice(ui.ToneWarning, "alert-triangle") {
				{ v.Notice }
			}
		}
		if v.Errors.Form()!="" {
			@ui.Notice(ui.ToneError, "alert-triangle") {
				{ v.Errors.Form() }
			}
		}
		<form method="post" action={ templ.URL(customURL(v.Step, "")) } novalidate class="mv-aicustom__columns" hx-disabled-elt="find button[type=submit]">
			<input type="hidden" name="id" value={ v.ID }/>
			<div class="mv-aicustom__fields">
				<fieldset class="mv-field">
					<legend class="mv-field__label">{ i18n.T(ctx,"aiimage.custom.type") }</legend>
					<div class="mv-aicustom__types"><span class="is-current">{ i18n.T(ctx,"aiimage.custom.compatible") }</span><span aria-disabled="true">ComfyUI @ui.SoonTag()</span><span aria-disabled="true">Hugging Face @ui.SoonTag()</span><span aria-disabled="true">HTTP @ui.SoonTag()</span></div>
				</fieldset>
				if v.Step=="connect" {
					@customNameField(v)
					@ui.Field(ui.FieldProps{ID: "custom-endpoint", Label: i18n.T(ctx, "aiimage.custom.endpoint"), Error: v.Errors["endpoint"], Hint: i18n.T(ctx, "aiimage.custom.endpoint_hint")}) {
						@ui.Input(ui.InputProps{ID: "custom-endpoint", Name: "endpoint", Value: v.Endpoint, Required: true, Invalid: v.Errors["endpoint"] != "", Described: true, MaxLength: 2048})
					}
					@ui.Field(ui.FieldProps{ID: "custom-model", Label: i18n.T(ctx, "aiimage.custom.model"), Hint: i18n.T(ctx, "aiimage.custom.model_hint")}) {
						@ui.Input(ui.InputProps{ID: "custom-model", Name: "model", Value: v.Model, Required: true, MaxLength: 160, Described: true})
					}
					@ui.Field(ui.FieldProps{ID: "custom-key", Label: i18n.T(ctx, "aiimage.custom.key"), Error: v.Errors["key"], Hint: i18n.T(ctx, "models.form.key_hint")}) {
						@ui.Input(ui.InputProps{ID: "custom-key", Name: "key", Type: "password", Autocomplete: "off", MaxLength: maxProviderKeyBytes, Described: true, Invalid: v.Errors["key"] != ""})
					}
					if v.Admin {
						@ui.Field(ui.FieldProps{ID: "custom-scope", Label: i18n.T(ctx, "models.form.scope")}) {
							@ui.Select(ui.SelectProps{ID: "custom-scope", Name: "scope", Value: v.Scope, Options: providerScopeOptions(ctx)})
						}
					} else {
						<input type="hidden" name="scope" value={ providerScopeUser }/>
					}
				} else if v.Step=="describe" {
					@customNameField(v)
					@ui.Field(ui.FieldProps{ID: "custom-context", Label: i18n.T(ctx, "aiimage.custom.context"), Hint: i18n.T(ctx, "aiimage.custom.context_hint")}) {
						@ui.Input(ui.InputProps{ID: "custom-context", Name: "context", Type: "number", Value: fmt.Sprint(v.Context), Required: true, Described: true, Attrs: templ.Attributes{"min": "4096", "max": "1048576"}})
					}
					@ui.Field(ui.FieldProps{ID: "custom-output", Label: i18n.T(ctx, "aiimage.custom.output")}) {
						@ui.Input(ui.InputProps{ID: "custom-output", Name: "output", Type: "number", Value: fmt.Sprint(v.Output), Required: true, Attrs: templ.Attributes{"min": "256", "max": "16384"}})
					}
				} else {
					@ui.Field(ui.FieldProps{ID: "custom-endpoint", Label: i18n.T(ctx, "aiimage.custom.endpoint")}) {
						@ui.Input(ui.InputProps{ID: "custom-endpoint", Value: v.Endpoint, ReadOnly: true})
					}
					@ui.Field(ui.FieldProps{ID: "custom-model", Label: i18n.T(ctx, "aiimage.custom.model")}) {
						@ui.Input(ui.InputProps{ID: "custom-model", Value: v.Model, ReadOnly: true})
					}
					@ui.Notice(ui.ToneInfo, "info-circle") {
						{ i18n.T(ctx,"aiimage.custom.non_generation") }
					}
					if v.Step=="route" {
						<p>{ i18n.T(ctx,"aiimage.custom.route_body") }</p>
					}
				}
			</div>
			<div class="mv-aicustom__result">
				<h2>{ i18n.T(ctx,"aiimage.custom.result") }</h2>
				<div class="mv-aicustom__preview" role="status"><div>@ui.Icon("plug-connected", 32)
<strong>{ i18n.T(ctx,"aiimage.custom.text_check") }</strong><span>{ i18n.T(ctx,"aiimage.custom.non_generation") }</span></div></div>
				<dl class="mv-aicustom__metrics"><div><dt>{ i18n.T(ctx,"models.col.status") }</dt><dd>{ customStatus(ctx,v.TestState) }</dd></div><div><dt>{ i18n.T(ctx,"aiimage.custom.kind") }</dt><dd>{ i18n.T(ctx,"models.cap.text") }</dd></div><div><dt>{ i18n.T(ctx,"models.col.cost") }</dt><dd>{ i18n.T(ctx,"models.cost.none") }</dd></div></dl>
				<div class="mv-aicustom__actions">
					@ui.LinkButton(customBack(v), ui.ButtonProps{Variant: ui.Ghost}) {
						{ i18n.T(ctx,"aiimage.back") }
					}
					@ui.Button(ui.ButtonProps{Type: "submit", Variant: ui.Primary, Icon: "arrow-right", Disabled: v.LocalOnly && v.Step == "test"}) {
						{ customNext(ctx,v.Step) }
					}
				</div>
			</div>
		</form>
	</div>
}

templ customNameField(v customProviderView) {
	@ui.Field(ui.FieldProps{ID: "custom-name", Label: i18n.T(ctx, "models.form.name"), Error: v.Errors["name"]}) {
		@ui.Input(ui.InputProps{ID: "custom-name", Name: "name", Value: v.Name, Required: true, MaxLength: maxProviderNameRunes, Invalid: v.Errors["name"] != ""})
	}
}

func customStatus(ctx context.Context, state string) string {
	if state == "ok" {
		return i18n.T(ctx, "models.status.ready")
	}
	if state == "error" {
		return i18n.T(ctx, "models.status.failed")
	}
	return i18n.T(ctx, "models.status.unchecked")
}
func customBack(v customProviderView) string {
	if v.Step == "connect" || v.Step == "test" {
		return "/models"
	}
	return customURL(customSteps[customStepNumber(v.Step)-2], v.ID)
}
func customNext(ctx context.Context, step string) string {
	return i18n.T(ctx, "aiimage.custom.next."+step)
}
