package ai

import (
	"context"
	"github.com/MaramHarsha/MangaVeyra/internal/i18n"
	"github.com/MaramHarsha/MangaVeyra/internal/web/ui"
)

templ modelsAddAction(canAdd bool) {
	if canAdd {
		@ui.LinkButton("/models/providers/new?kind=openrouter", ui.ButtonProps{Variant: ui.Primary, Icon: "plus"}) {
			{ i18n.T(ctx, "models.add") }
		}
	}
}

// ModelsPage is the Gate A provider-management surface.
templ ModelsPage(v modelsPageView) {
	<div class="mv-models">
		@ui.PageHead(i18n.T(ctx, "models.title"), i18n.T(ctx, "models.subtitle"), modelsAddAction(v.CanAdd))
		if v.LocalOnly {
			@ui.Notice(ui.ToneWarning, "shield-lock") {
				<strong>{ i18n.T(ctx, "models.local_only.title") }</strong>
				<p>{ i18n.T(ctx, "models.local_only.body") }</p>
			}
		}
		<div class="mv-models__grid">
			@PlaceholderProviderCard()
			for _, provider := range v.Providers {
				@ProviderCard(providerCardView{Provider: provider, LocalOnly: v.LocalOnly})
			}
		</div>
		if len(v.Providers) == 0 {
			<p class="mv-models__empty mv-muted">{ i18n.T(ctx, "models.empty") }</p>
		}
	</div>
}

// PlaceholderProviderCard describes the deterministic built-in text provider.
templ PlaceholderProviderCard() {
	<article class="mv-model-card mv-model-card--builtin">
		<header class="mv-model-card__head">
			<div class="mv-model-card__identity">
				@ui.Icon("file-text", 24)
				<div>
					<h2>{ i18n.T(ctx, "models.placeholder.name") }</h2>
					<p>{ i18n.T(ctx, "models.placeholder.description") }</p>
				</div>
			</div>
			@ui.Badge(ui.ToneSuccess, "circle-check", i18n.T(ctx, "models.placeholder.status"))
		</header>
		<div class="mv-model-card__meta">
			@ui.KV(i18n.T(ctx, "models.field.scope"), i18n.T(ctx, "models.scope.builtin"))
			@ui.KV(i18n.T(ctx, "models.field.model"), "placeholder-text")
		</div>
	</article>
}

func providerCardID(id string) string { return "provider-" + id }

func providerStatusTone(provider providerView) ui.Tone {
	if provider.Enabled {
		return ui.ToneSuccess
	}
	return ui.ToneMuted
}

func providerStatusIcon(provider providerView) string {
	if provider.Enabled {
		return "circle-check"
	}
	return "circle-off"
}

func providerStateKey(provider providerView) string {
	if provider.Enabled {
		return "models.state.enabled"
	}
	return "models.state.disabled"
}

func providerNoticeIcon(tone ui.Tone) string {
	if tone == ui.ToneError {
		return "alert-triangle"
	}
	return "circle-check"
}

func providerEnabledValue(provider providerView) string {
	if provider.Enabled {
		return "false"
	}
	return "true"
}

func providerEnabledIcon(provider providerView) string {
	if provider.Enabled {
		return "circle-off"
	}
	return "circle-check"
}

func providerTestTone(provider providerView) ui.Tone {
	switch provider.LastTest.State {
	case "ok":
		return ui.ToneSuccess
	case "error":
		return ui.ToneError
	default:
		return ui.ToneMuted
	}
}

func providerTestIcon(provider providerView) string {
	switch provider.LastTest.State {
	case "ok":
		return "circle-check"
	case "error":
		return "alert-triangle"
	default:
		return "clock"
	}
}

func providerTestKey(provider providerView) string {
	switch provider.LastTest.State {
	case "ok":
		return "models.test.ok"
	case "error":
		return "models.test.failed"
	default:
		return "models.test.never"
	}
}

// ProviderCard renders only providerView, which has no plaintext/ciphertext field.
templ ProviderCard(v providerCardView) {
	<article class="mv-model-card" id={ providerCardID(v.Provider.ID) }>
		<header class="mv-model-card__head">
			<div class="mv-model-card__identity">
				@ui.Icon("route", 24)
				<div>
					<h2>{ v.Provider.Name }</h2>
					<p>{ i18n.T(ctx, "models.openrouter.description") }</p>
				</div>
			</div>
			@ui.Badge(providerStatusTone(v.Provider), providerStatusIcon(v.Provider), i18n.T(ctx, providerStateKey(v.Provider)))
		</header>
		if v.Notice != "" {
			@ui.Notice(v.Tone, providerNoticeIcon(v.Tone)) {
				{ v.Notice }
			}
		}
		<div class="mv-model-card__meta">
			@ui.KV(i18n.T(ctx, "models.field.scope"), i18n.T(ctx, "models.scope."+v.Provider.Scope))
			@ui.KV(i18n.T(ctx, "models.field.key"), v.Provider.KeyHint)
			@ui.KVC(i18n.T(ctx, "models.field.check")) {
				@ui.Badge(providerTestTone(v.Provider), providerTestIcon(v.Provider), i18n.T(ctx, providerTestKey(v.Provider)))
			}
			if v.Provider.LastTest.RequestID != "" {
				@ui.KV(i18n.T(ctx, "models.field.request_id"), v.Provider.LastTest.RequestID)
			}
		</div>
		<div class="mv-model-card__actions">
			<form method="post" action={ templ.URL("/models/providers/" + v.Provider.ID + "/test") } novalidate
				hx-post={ "/models/providers/" + v.Provider.ID + "/test" }
				hx-target={ "#" + providerCardID(v.Provider.ID) } hx-swap="outerHTML" hx-disabled-elt="find button">
				@ui.Button(ui.ButtonProps{Type: "submit", Variant: ui.Quiet, Size: ui.SM, Icon: "plug-connected",
					Disabled: v.LocalOnly || !v.Provider.Enabled}) {
					{ i18n.T(ctx, "models.test.action") }
				}
			</form>
			<form method="post" action={ templ.URL("/models/providers/" + v.Provider.ID + "/enabled") } novalidate
				hx-post={ "/models/providers/" + v.Provider.ID + "/enabled" }
				hx-target={ "#" + providerCardID(v.Provider.ID) } hx-swap="outerHTML" hx-disabled-elt="find button">
				<input type="hidden" name="enabled" value={ providerEnabledValue(v.Provider) }/>
				@ui.Button(ui.ButtonProps{Type: "submit", Variant: ui.Ghost, Size: ui.SM,
					Icon: providerEnabledIcon(v.Provider)}) {
					if v.Provider.Enabled {
						{ i18n.T(ctx, "models.disable") }
					} else {
						{ i18n.T(ctx, "models.enable") }
					}
				}
			</form>
		</div>
		<details class="mv-model-card__key">
			<summary class="mv-link">{ i18n.T(ctx, "models.key.replace") }</summary>
			<form class="mv-model-card__key-form" method="post" action={ templ.URL("/models/providers/" + v.Provider.ID + "/key") } novalidate
				hx-post={ "/models/providers/" + v.Provider.ID + "/key" }
				hx-target={ "#" + providerCardID(v.Provider.ID) } hx-swap="outerHTML" hx-disabled-elt="find button">
				@ui.Field(ui.FieldProps{ID: "key-" + v.Provider.ID, Label: i18n.T(ctx, "models.form.key"), Hint: i18n.T(ctx, "models.key.hint")}) {
					@ui.Input(ui.InputProps{ID: "key-" + v.Provider.ID, Name: "key", Type: "password", Autocomplete: "off",
						Required: true, MaxLength: maxProviderKeyBytes, Attrs: templ.Attributes{"spellcheck": "false", "autocapitalize": "none"}})
				}
				@ui.Button(ui.ButtonProps{Type: "submit", Variant: ui.Secondary, Size: ui.SM, Icon: "key"}) {
					{ i18n.T(ctx, "models.key.submit") }
				}
			</form>
		</details>
	</article>
}

func providerScopeOptions(ctx context.Context) []ui.Option {
	return []ui.Option{
		{Value: providerScopeServer, Label: i18n.T(ctx, "models.scope.server")},
		{Value: providerScopeUser, Label: i18n.T(ctx, "models.scope.user")},
	}
}

// ProviderFormPage is the single-page Gate A OpenRouter connection flow.
templ ProviderFormPage(v providerFormView) {
	<div class="mv-provider-form">
		@ui.PageHead(i18n.T(ctx, "models.form.title"), i18n.T(ctx, "models.form.subtitle"), nil)
		if v.LocalOnly {
			@ui.Notice(ui.ToneWarning, "shield-lock") {
				<strong>{ i18n.T(ctx, "models.local_only.title") }</strong>
				<p>{ i18n.T(ctx, "models.local_only.connect_body") }</p>
			}
		}
		<form class="mv-provider-form__body" method="post" action="/models/providers" novalidate>
			<input type="hidden" name="next" value={ v.Next }/>
			if v.Errors.Form() != "" {
				@ui.Notice(ui.ToneError, "alert-triangle") { { v.Errors.Form() } }
			}
			@ui.Field(ui.FieldProps{ID: "provider-name", Label: i18n.T(ctx, "models.form.name"),
				Hint: i18n.T(ctx, "models.form.name_hint"), Error: v.Errors["name"]}) {
				@ui.Input(ui.InputProps{ID: "provider-name", Name: "name", Value: v.Name, Required: true,
					MaxLength: maxProviderNameRunes, Autofocus: true, Invalid: v.Errors["name"] != "", Described: true})
			}
			@ui.Field(ui.FieldProps{ID: "provider-key", Label: i18n.T(ctx, "models.form.key"),
				Hint: i18n.T(ctx, "models.form.key_hint"), Error: v.Errors["key"]}) {
				@ui.Input(ui.InputProps{ID: "provider-key", Name: "key", Type: "password", Autocomplete: "off",
					Required: true, MaxLength: maxProviderKeyBytes, Invalid: v.Errors["key"] != "", Described: true,
					Attrs: templ.Attributes{"spellcheck": "false", "autocapitalize": "none"}})
			}
			if v.Admin {
				<fieldset class="mv-field">
					<legend class="mv-field__label">{ i18n.T(ctx, "models.form.scope") }</legend>
					@ui.Segmented(ui.SegmentedProps{Name: "scope", Value: v.Scope, Options: providerScopeOptions(ctx),
						Label: i18n.T(ctx, "models.form.scope"), Full: true})
					if v.Errors["scope"] != "" {
						<span class="mv-field__error" role="alert">{ v.Errors["scope"] }</span>
					} else {
						<span class="mv-field__hint">{ i18n.T(ctx, "models.form.scope_hint") }</span>
					}
				</fieldset>
			} else {
				<input type="hidden" name="scope" value={ providerScopeUser }/>
				@ui.Notice(ui.ToneInfo, "user") { { i18n.T(ctx, "models.form.personal_only") } }
			}
			<div class="mv-provider-form__actions">
				@ui.LinkButton("/models", ui.ButtonProps{Variant: ui.Ghost}) { { i18n.T(ctx, "ui.cancel") } }
				@ui.Button(ui.ButtonProps{Type: "submit", Variant: ui.Primary, Icon: "plug-connected"}) {
					{ i18n.T(ctx, "models.form.submit") }
				}
			</div>
		</form>
	</div>
}
