package studioui

import (
	"context"
	"strconv"
	"strings"

	"github.com/MaramHarsha/MangaVeyra/internal/i18n"
	"github.com/MaramHarsha/MangaVeyra/internal/studio"
	"github.com/MaramHarsha/MangaVeyra/internal/web/ui"
)

// scriptFormID names the C1 script form; the scene title and the no-JS Save
// button live in the header and join the form through the form attribute.
const scriptFormID = "mv-c1-script"

var dialogueKinds = []string{"speech", "thought", "caption"}

func storyViewIs(v storyView, view string) bool {
	if v.View == viewProse {
		return view == viewProse
	}
	return view == viewPanels
}

// sceneHref opens a scene in the view that is showing; the studio script
// rewrites these links when the Prose / Panels toggle changes.
func sceneHref(v storyView, sceneID string) string {
	href := scenePath(v.Project.ID, v.Chapter.ID, sceneID)
	if storyViewIs(v, viewProse) {
		return href + "?view=prose"
	}
	return href
}

func viewHref(v storyView, view string) string {
	href := v.sceneURL()
	if view == viewProse {
		return href + "?view=prose"
	}
	return href
}

func cellLabel(parts ...string) string { return strings.Join(parts, " · ") }

// cellRows sizes a compact textarea to its text where field-sizing is not
// supported, so cells read like the design's text instead of scroll boxes.
func cellRows(text string, perLine, min, max int) int {
	rows := 0
	for _, line := range strings.Split(text, "\n") {
		rows += 1 + len([]rune(line))/perLine
	}
	if rows < min {
		return min
	}
	if rows > max {
		return max
	}
	return rows
}

func cellAttrs(readOnly bool, maxLength int, rows int) templ.Attributes {
	a := templ.Attributes{"maxlength": strconv.Itoa(maxLength)}
	if rows > 0 {
		a["rows"] = strconv.Itoa(rows)
	}
	if readOnly {
		a["readonly"] = true
	}
	return a
}

func speakerSize(speaker string) int {
	n := len([]rune(speaker)) + 1
	if n < 6 {
		return 6
	}
	if n > 24 {
		return 24
	}
	return n
}

func dialogueKind(kind string) string {
	switch kind {
	case "speech", "thought", "caption":
		return kind
	}
	return "speech"
}

// lineLabel is the bold name before a line: "Caption" for captions, as
// designed, else the speaker (or the line type when nobody is named).
func lineLabel(ctx context.Context, line studio.ScriptDialogue) string {
	if dialogueKind(line.Kind) != "caption" && strings.TrimSpace(line.Speaker) != "" {
		return line.Speaker
	}
	return i18n.T(ctx, "studioui.dialogue."+dialogueKind(line.Kind))
}

func indexID(prefix, panelID string, index int) string {
	return prefix + panelID + "-" + strconv.Itoa(index)
}

func lineKey(panelID string, index int) string { return panelID + "." + strconv.Itoa(index) }

func formAttr(extra templ.Attributes) templ.Attributes {
	a := templ.Attributes{"form": scriptFormID}
	for k, v := range extra {
		a[k] = v
	}
	return a
}

func focusAttrs(v storyView, id string) templ.Attributes {
	if v.FocusLine != "" && v.FocusLine == id {
		return templ.Attributes{"autofocus": true}
	}
	return nil
}

// StoryPage is C1: the chapter/scene tree, one scene's script in the centre
// (Prose or Panels) and the Script assistant, which is not built yet and
// shows as Soon.
templ StoryPage(v storyView) {
	<div class="mv-c1" data-story-views>
		@storyTree(v)
		<section class="mv-c1__centre" aria-labelledby="mv-c1-title">
			@storyBar(v)
			<div class="mv-c1__body">
				@FormNotice(v.Error)
				if v.Conflict {
					@ui.Notice(ui.ToneWarning, "refresh") {
						<strong>{ i18n.T(ctx, "studioui.script.unsaved") }</strong>
						<p>{ i18n.T(ctx, "studioui.script.conflict_help") }</p>
						<a href={ templ.URL(v.sceneURL()) }>{ i18n.T(ctx, "studioui.script.reload") }</a>
					}
				}
				if v.Dirty {
					@ui.Notice(ui.ToneInfo, "pencil") {
						<p>{ i18n.T(ctx, "studioui.script.draft") }</p>
					}
				}
				if len(v.Script.Scenes) > 0 {
					@ScriptProse(v)
					@ScriptEditor(v)
					@makePagesButton(v, "mv-show-mobile mv-c1__mobile-make", true)
				} else {
					<div class="mv-c1__gen">
						if v.Job != nil {
							@JobPanel(v.Job)
							if !v.Job.Active && v.CanGenerate && !v.Chapter.Locked {
								@GenerationStart(v)
							}
						} else if v.CanGenerate && !v.Chapter.Locked {
							@GenerationStart(v)
						} else {
							@ui.State(ui.StateProps{Title: i18n.T(ctx, "studioui.story.no_script"), Body: i18n.T(ctx, "studioui.story.read_only"), Boxed: true})
						}
					</div>
				}
			</div>
		</section>
		@scriptAssistant()
	</div>
}

// storyBar is the designed header: "Ch. N · Scene M" over the scene title,
// the save state, the Prose / Panels toggle and "Make pages from script".
templ storyBar(v storyView) {
	<header class="mv-c1__bar">
		<div class="mv-c1__heading">
			if len(v.Script.Scenes) > 0 {
				{{ scene := v.currentScene() }}
				<span class="mv-c1__crumbline">
					<span class="mv-c1__crumb">{ i18n.T(ctx, "studioui.story.scene_crumb", "chapter", v.Chapter.Number, "scene", v.SceneIndex + 1) }</span>
					@storyBadges(v)
					if !v.ReadOnly {
						<span class="mv-c1__savestate mv-js-only" data-save-state aria-live="polite" data-saved={ i18n.T(ctx, "studioui.script.state.saved") } data-saving={ i18n.T(ctx, "studioui.script.state.saving") } data-dirty={ i18n.T(ctx, "studioui.script.state.dirty") } data-failed={ i18n.T(ctx, "studioui.script.state.failed") } data-conflict={ i18n.T(ctx, "studioui.script.state.conflict") } data-locked={ i18n.T(ctx, "studioui.script.state.locked") } data-invalid={ i18n.T(ctx, "studioui.script.state.invalid") }>
							if v.Dirty {
								{ i18n.T(ctx, "studioui.script.state.dirty") }
							} else {
								{ i18n.T(ctx, "studioui.script.state.saved") }
							}
						</span>
					}
				</span>
				<h1 class="mv-sr-only" id="mv-c1-title">{ i18n.T(ctx, "studioui.story.heading", "chapter", v.Chapter.Title, "scene", scene.Title) }</h1>
				<label class="mv-sr-only" for={ "scene-title-input-" + scene.ID }>{ cellLabel(i18n.T(ctx, "studioui.script.scene", "number", v.SceneIndex+1), i18n.T(ctx, "studioui.script.scene_title")) }</label>
				@ui.Input(ui.InputProps{ID: "scene-title-input-" + scene.ID, Name: sceneField(scene.ID, "title"), Value: scene.Title, ReadOnly: v.ReadOnly, MaxLength: 160, Placeholder: i18n.T(ctx, "studioui.script.scene_title"), Class: "mv-c1__cell mv-c1__cell--title", Attrs: formAttr(nil)})
			} else {
				<span class="mv-c1__crumbline">
					<span class="mv-c1__crumb">{ i18n.T(ctx, "studioui.story.crumb", "project", v.Project.Title, "number", v.Chapter.Number) }</span>
					@storyBadges(v)
				</span>
				<h1 class="mv-c1__title" id="mv-c1-title">{ v.Chapter.Title }</h1>
			}
		</div>
		<div class="mv-c1__tools">
			if len(v.Script.Scenes) > 0 {
				if !v.ReadOnly {
					@ui.Button(ui.ButtonProps{Variant: ui.Secondary, Size: ui.SM, Type: "submit", Icon: "device-floppy", Class: "mv-nojs-only", Attrs: formAttr(nil)}) {
						{ i18n.T(ctx, "studioui.script.save") }
					}
				}
				<div class="mv-c1__toggle" data-view-toggle>
					@ui.SegmentedLinks(i18n.T(ctx, "studioui.story.view"), []ui.SegLink{
						{Href: viewHref(v, viewProse), Label: i18n.T(ctx, "studioui.story.prose"), Current: storyViewIs(v, viewProse)},
						{Href: viewHref(v, viewPanels), Label: i18n.T(ctx, "studioui.story.panels"), Current: storyViewIs(v, viewPanels)},
					})
				</div>
				@makePagesButton(v, "mv-hide-mobile", false)
			}
		</div>
	</header>
}

templ storyBadges(v storyView) {
	if v.Chapter.Locked {
		@ui.StatusBadge(ui.StatusLocked, i18n.T(ctx, "studioui.story.locked"))
	}
	if len(v.Script.Scenes) == 0 {
		@scriptProvenance(v)
	}
	if v.ReadOnly && len(v.Script.Scenes) > 0 {
		<span class="mv-c1__readonly">{ i18n.T(ctx, "studioui.script.read_only") }</span>
	}
}

// scriptProvenance is the script provenance label of the chapter.
templ scriptProvenance(v storyView) {
	if label := v.Chapter.AILabel["script"]; label != "" {
		@ui.ProvenanceBadge(label, provenanceText(ctx, label))
	}
}

// storyTree lists the chapters (arcs are not modelled yet, so chapters are
// the top level) and the open chapter's scenes; the current scene is marked
// as designed. "Import text into this chapter" (ADR 0004 §4) keeps its place
// at the foot of the tree in the Soon state.
templ storyTree(v storyView) {
	<nav class="mv-c1__tree" aria-label={ i18n.T(ctx, "studioui.story.tree") }>
		<ul class="mv-list-plain">
			for _, chapter := range v.Chapters {
				<li>
					<a
						class="mv-c1__node mv-c1__node--chapter"
						href={ templ.URL(storyPath(v.Project.ID, chapter.ID)) }
						if chapter.ID == v.Chapter.ID {
							aria-current="true"
						}
					>
						@ui.Icon("file", 15)
						<span>{ i18n.T(ctx, "studioui.story.chapter_node", "number", chapter.Number, "title", chapter.Title) }</span>
					</a>
					if chapter.ID == v.Chapter.ID && len(v.Script.Scenes) > 0 {
						<ul class="mv-list-plain">
							for sceneIndex, scene := range v.Script.Scenes {
								<li>
									<a
										class="mv-c1__node mv-c1__node--scene"
										href={ templ.URL(sceneHref(v, scene.ID)) }
										data-scene-link
										if sceneIndex == v.SceneIndex {
											aria-current="page"
										}
									>
										@ui.Icon("point", 15)
										<span>{ i18n.T(ctx, "studioui.story.scene_node", "number", sceneIndex + 1, "title", scene.Title) }</span>
									</a>
								</li>
							}
						</ul>
					}
				</li>
			}
		</ul>
		<div class="mv-c1__treefoot">
			@ui.Button(ui.ButtonProps{Variant: ui.Quiet, Size: ui.SM, Icon: "file-import", Full: true, Disabled: true, Class: "is-soon mv-btn--start", Attrs: templ.Attributes{"title": i18n.T(ctx, "ui.soon_hint")}}) {
				{ i18n.T(ctx, "studioui.story.import") }
				@ui.SoonTag()
			}
		</div>
	</nav>
}

// makePagesButton queues revision-bound layout and structured auto-lettering.
templ makePagesButton(v storyView, class string, full bool) {
	{{ action := storyPath(v.Project.ID, v.Chapter.ID) + "/pages" }}
	if v.Chapter.PageCount != 0 {
		// Pages exist: the same designed button just opens the editor. It is a
		// plain link, so no revision can go stale while the editor saves pages.
		<div class={ ui.Cls("mv-c1__make", class) }>
			@ui.LinkButton(editorPath(v.Project.ID, v.Chapter.ID), ui.ButtonProps{Variant: ui.Primary, Size: ui.SM, Icon: "layout-board", Full: full, Attrs: templ.Attributes{"data-open-editor": true}}) {
				{ i18n.T(ctx, "studioui.story.make_pages") }
			}
		</div>
	} else if !ui.ReadyMethod(ctx, "POST", action) {
		<div class={ ui.Cls("mv-c1__make", class) }>
			@ui.Button(ui.ButtonProps{Variant: ui.Primary, Size: ui.SM, Icon: "layout-board", Full: full, Disabled: true, Class: "is-soon", Attrs: templ.Attributes{"title": i18n.T(ctx, "ui.soon_hint")}}) {
				{ i18n.T(ctx, "studioui.story.make_pages") }
				@ui.SoonTag()
			}
		</div>
	} else if v.CanMakePages && !v.Chapter.Locked && len(v.Script.Scenes) != 0 {
		<form class={ ui.Cls("mv-c1__make", class) } method="post" action={ templ.URL(action) } novalidate data-make-pages>
			<input type="hidden" name="revision" value={ formRevision(v) } data-revision/>
			@ui.Button(ui.ButtonProps{Variant: ui.Primary, Size: ui.SM, Type: "submit", Icon: "layout-board", Full: full}) {
				{ i18n.T(ctx, "studioui.story.make_pages") }
			}
		</form>
	} else {
		<div class={ ui.Cls("mv-c1__make", class) }>
			@ui.Button(ui.ButtonProps{Variant: ui.Primary, Size: ui.SM, Icon: "layout-board", Full: full, Disabled: true}) {
				{ i18n.T(ctx, "studioui.story.make_pages") }
			}
		</div>
	}
}

// scriptAssistant is the designed right pane. The assistant is not built: its
// route chip is dimmed and its input is disabled with a Soon tag.
templ scriptAssistant() {
	<aside class="mv-c1__assist" aria-labelledby="mv-c1-assist-title">
		<header class="mv-c1__assisthead">
			<h2 id="mv-c1-assist-title">{ i18n.T(ctx, "studioui.assist.title") }</h2>
			<span class="mv-c1__route is-soon" aria-disabled="true">
				@ui.RouteChip(i18n.T(ctx, "studioui.route.auto"), i18n.T(ctx, "studioui.assist.route"), "", "")
			</span>
		</header>
		<div class="mv-c1__assistbody">
			<p>{ i18n.T(ctx, "studioui.assist.body") }</p>
		</div>
		<div class="mv-c1__assistfoot">
			<label class="mv-sr-only" for="mv-c1-ask">{ i18n.T(ctx, "studioui.assist.ask") }</label>
			<div class="mv-c1__ask">
				@ui.Input(ui.InputProps{ID: "mv-c1-ask", Placeholder: i18n.T(ctx, "studioui.assist.ask"), Disabled: true})
				@ui.SoonTag()
			</div>
		</div>
	</aside>
}

// ScriptProse is the read-only Prose view of the open scene. Each text node
// names the field it shows (data-mirror) so the studio script can refresh it
// from unsaved edits when the view switches.
templ ScriptProse(v storyView) {
	{{ scene := v.currentScene() }}
	<article class="mv-c1__prose" data-view-panel="prose" hidden?={ !storyViewIs(v, viewProse) } aria-label={ i18n.T(ctx, "studioui.story.prose") }>
		<p class="mv-c1__prose-summary" data-mirror="chapter_summary">{ v.Script.ChapterSummary }</p>
		<section class="mv-c1__prose-scene" id={ "prose-" + scene.ID } aria-labelledby={ "prose-title-" + scene.ID }>
			<span class="mv-c1__crumb">
				{ i18n.T(ctx, "studioui.story.scene_crumb", "chapter", v.Chapter.Number, "scene", v.SceneIndex + 1) }
				<span class="mv-c1__prose-time" data-mirror={ sceneField(scene.ID, "time_of_day") }>{ scene.TimeOfDay }</span>
			</span>
			<h2 class="mv-c1__prose-title" id={ "prose-title-" + scene.ID } data-mirror={ sceneField(scene.ID, "title") }>{ scene.Title }</h2>
			<p class="mv-c1__prose-summary" data-mirror={ sceneField(scene.ID, "summary") }>{ scene.Summary }</p>
			for _, panel := range scene.Panels {
				<div class="mv-c1__prose-panel" data-prose-panel={ panel.ID }>
					<span class="mv-c1__prose-label">{ panel.Label }</span>
					<div class="mv-c1__prose-text" data-prose-lines={ panel.ID } data-label-speech={ i18n.T(ctx, "studioui.dialogue.speech") } data-label-thought={ i18n.T(ctx, "studioui.dialogue.thought") } data-label-caption={ i18n.T(ctx, "studioui.dialogue.caption") }>
						<p class="mv-c1__prose-action" data-mirror={ panelField(panel.ID, "action") }>{ panel.Action }</p>
						for dialogueIndex, line := range panel.Dialogue {
							<p class={ ui.Cls("mv-c1__prose-line", "mv-c1__prose-line--"+dialogueKind(line.Kind)) } data-prose-line={ lineKey(panel.ID, dialogueIndex) }>
								<strong data-mirror={ dialogueField(panel.ID, dialogueIndex, "speaker") } data-fallback={ i18n.T(ctx, "studioui.dialogue."+dialogueKind(line.Kind)) }>{ lineLabel(ctx, line) }</strong>
								<span data-mirror={ dialogueField(panel.ID, dialogueIndex, "text") }>{ line.Text }</span>
							</p>
						}
					</div>
					<span class="mv-c1__prose-sfx">
						for sfxIndex, effect := range panel.SFX {
							<span class="mv-c1__prose-sfxword" data-mirror={ sfxField(panel.ID, sfxIndex, "text") }>{ effect.Text }</span>
						}
					</span>
				</div>
			}
		</section>
	</article>
}

// ScriptEditor is the Panels view: the open scene's compact panel table. The
// form names the scene it carries, so a save leaves the other scenes as they
// are. With JavaScript it autosaves; without it, Save in the header submits.
templ ScriptEditor(v storyView) {
	{{ scene := v.currentScene() }}
	<form
		class="mv-c1__script"
		id={ scriptFormID }
		data-view-panel="panels"
		hidden?={ !storyViewIs(v, viewPanels) }
		method="post"
		action={ templ.URL(storyPath(v.Project.ID, v.Chapter.ID) + "/script") }
		novalidate
		data-guard-unsaved
		if !v.ReadOnly {
			data-script-autosave
		}
	>
		<h2 class="mv-sr-only">{ i18n.T(ctx, "studioui.script.title") }</h2>
		<input type="hidden" name="revision" value={ formRevision(v) } data-revision/>
		<input type="hidden" name="scene" value={ scene.ID }/>
		@sceneDetails(v, scene)
		@sceneTable(v, scene)
		if !v.ReadOnly {
			@lineTemplate(v)
		}
	</form>
}

// sceneDetails folds the chapter summary, time of day and scene summary —
// fields the artboard does not draw but generation reads — into one row.
templ sceneDetails(v storyView, scene studio.ScriptScene) {
	{{ sceneName := i18n.T(ctx, "studioui.script.scene", "number", v.SceneIndex+1) }}
	<details class="mv-c1__details" open?={ v.Error != "" }>
		<summary class="mv-c1__detailsum">
			@ui.Icon("chevron-right", 14)
			<span>{ i18n.T(ctx, "studioui.script.details") }</span>
			if scene.TimeOfDay != "" {
				<span class="mv-c1__detailmeta">{ scene.TimeOfDay }</span>
			}
			<span class="mv-c1__provenance">
				@scriptProvenance(v)
			</span>
		</summary>
		<div class="mv-c1__detailgrid">
			<div class="mv-c1__detail">
				<label class="mv-c1__minilabel" for="chapter_summary">{ i18n.T(ctx, "studioui.script.summary") }</label>
				@ui.Textarea(ui.TextareaProps{ID: "chapter_summary", Name: "chapter_summary", Value: v.Script.ChapterSummary, Class: "mv-c1__cell mv-c1__cell--summary", Attrs: cellAttrs(v.ReadOnly, 4000, cellRows(v.Script.ChapterSummary, 90, 2, 8))})
			</div>
			<div class="mv-c1__detail">
				<label class="mv-c1__minilabel" for={ "scene-time-" + scene.ID }>{ i18n.T(ctx, "studioui.script.time") }</label>
				@ui.Input(ui.InputProps{ID: "scene-time-" + scene.ID, Name: sceneField(scene.ID, "time_of_day"), Value: scene.TimeOfDay, ReadOnly: v.ReadOnly, MaxLength: 160, Class: "mv-c1__cell mv-c1__cell--meta"})
			</div>
			<div class="mv-c1__detail">
				<label class="mv-c1__minilabel" for={ "scene-summary-" + scene.ID }>{ cellLabel(sceneName, i18n.T(ctx, "studioui.script.scene_summary")) }</label>
				@ui.Textarea(ui.TextareaProps{ID: "scene-summary-" + scene.ID, Name: sceneField(scene.ID, "summary"), Value: scene.Summary, Placeholder: i18n.T(ctx, "studioui.script.scene_summary"), Class: "mv-c1__cell mv-c1__cell--summary", Attrs: cellAttrs(v.ReadOnly, 4000, cellRows(scene.Summary, 90, 1, 6))})
			</div>
		</div>
	</details>
}

templ sceneTable(v storyView, scene studio.ScriptScene) {
	<section class="mv-c1__scene" id={ "scene-" + scene.ID } aria-labelledby="mv-c1-title">
		<div class="mv-c1__table" role="table" aria-label={ i18n.T(ctx, "studioui.story.panels_table", "number", v.SceneIndex + 1) }>
			<div class="mv-c1__row mv-c1__row--head" role="row">
				<span role="columnheader">{ i18n.T(ctx, "studioui.story.col.panel") }</span>
				<span role="columnheader">{ i18n.T(ctx, "studioui.story.col.camera") }</span>
				<span role="columnheader">{ i18n.T(ctx, "studioui.story.col.action") }</span>
				<span role="columnheader" class="mv-c1__end">{ i18n.T(ctx, "studioui.story.col.sfx") }</span>
			</div>
			for _, panel := range scene.Panels {
				@panelRow(v, panel)
			}
		</div>
	</section>
}

// panelRow is one designed row: label, shot badge over emotion, action with
// its dialogue lines, SFX. Secondary fields (page, camera angle, notes, line
// types, SFX notes) sit in the row's disclosure so they add no height.
templ panelRow(v storyView, panel studio.ScriptPanel) {
	{{ panelName := i18n.T(ctx, "studioui.script.panel", "label", panel.Label) }}
	<div class="mv-c1__row" role="row" id={ "panel-" + panel.ID } data-panel={ panel.ID } data-panel-label={ panel.Label }>
		<div class="mv-c1__col mv-c1__col--panel" role="cell">
			<span class="mv-c1__label">{ panel.Label }</span>
			if !v.ReadOnly {
				@ui.Button(ui.ButtonProps{Variant: ui.Bare, Size: ui.SM, Icon: "message-plus", Type: "submit", Label: i18n.T(ctx, "studioui.script.add_line_to", "label", panel.Label), Tip: i18n.T(ctx, "studioui.script.add_line"), Class: "mv-c1__addline", Attrs: templ.Attributes{"name": intentAddLine, "value": panel.ID, "data-add-line": panel.ID, "formnovalidate": true, "data-tip-pos": "below"}})
			}
		</div>
		<div class="mv-c1__col mv-c1__col--camera" role="cell">
			<label class="mv-sr-only" for={ "shot-" + panel.ID }>{ cellLabel(panelName, i18n.T(ctx, "studioui.script.shot")) }</label>
			@ui.Input(ui.InputProps{ID: "shot-" + panel.ID, Name: panelField(panel.ID, "shot"), Value: panel.Shot, ReadOnly: v.ReadOnly, MaxLength: 240, Placeholder: i18n.T(ctx, "studioui.script.shot"), Class: "mv-c1__cell mv-c1__cell--badge", Attrs: templ.Attributes{"size": strconv.Itoa(speakerSize(panel.Shot))}})
			<label class="mv-sr-only" for={ "emotion-" + panel.ID }>{ cellLabel(panelName, i18n.T(ctx, "studioui.script.emotion")) }</label>
			@ui.Input(ui.InputProps{ID: "emotion-" + panel.ID, Name: panelField(panel.ID, "emotion"), Value: panel.Emotion, ReadOnly: v.ReadOnly, MaxLength: 240, Placeholder: i18n.T(ctx, "studioui.script.emotion"), Class: "mv-c1__cell mv-c1__cell--meta"})
		</div>
		<div class="mv-c1__col mv-c1__col--action" role="cell">
			<label class="mv-sr-only" for={ "action-" + panel.ID }>{ cellLabel(panelName, i18n.T(ctx, "studioui.script.action")) }</label>
			@ui.Textarea(ui.TextareaProps{ID: "action-" + panel.ID, Name: panelField(panel.ID, "action"), Value: panel.Action, Placeholder: i18n.T(ctx, "studioui.script.action"), Class: "mv-c1__cell mv-c1__cell--action", Attrs: cellAttrs(v.ReadOnly, 2000, cellRows(panel.Action, 60, 1, 8))})
			<div class="mv-c1__lines" data-lines={ panel.ID }>
				for dialogueIndex, line := range panel.Dialogue {
					@dialogueLine(v, panel, panelName, dialogueIndex, line)
				}
			</div>
		</div>
		<div class="mv-c1__col mv-c1__col--sfx" role="cell">
			for sfxIndex, effect := range panel.SFX {
				{{ sfxName := cellLabel(panelName, i18n.T(ctx, "studioui.script.sfx", "number", sfxIndex+1)) }}
				<label class="mv-sr-only" for={ indexID("sfx-", panel.ID, sfxIndex) }>{ cellLabel(sfxName, i18n.T(ctx, "studioui.script.sfx_text")) }</label>
				@ui.Input(ui.InputProps{ID: indexID("sfx-", panel.ID, sfxIndex), Name: sfxField(panel.ID, sfxIndex, "text"), Value: effect.Text, ReadOnly: v.ReadOnly, MaxLength: 240, Class: "mv-c1__cell mv-c1__cell--sfx"})
			}
		</div>
		@panelMore(v, panel, panelName)
	</div>
}

templ dialogueLine(v storyView, panel studio.ScriptPanel, panelName string, index int, line studio.ScriptDialogue) {
	{{ lineName := cellLabel(panelName, i18n.T(ctx, "studioui.script.dialogue", "number", index+1)) }}
	<div class="mv-c1__line" data-line={ lineKey(panel.ID, index) } data-kind={ dialogueKind(line.Kind) }>
		<span class="mv-c1__who">
			<label class="mv-sr-only" for={ indexID("speaker-", panel.ID, index) }>{ cellLabel(lineName, i18n.T(ctx, "studioui.script.speaker")) }</label>
			@ui.Input(ui.InputProps{ID: indexID("speaker-", panel.ID, index), Name: dialogueField(panel.ID, index, "speaker"), Value: line.Speaker, ReadOnly: v.ReadOnly, MaxLength: 160, Placeholder: i18n.T(ctx, "studioui.script.speaker"), Class: "mv-c1__cell mv-c1__cell--speaker", Attrs: mergeAttrs(templ.Attributes{"size": strconv.Itoa(speakerSize(line.Speaker))}, focusAttrs(v, indexID("speaker-", panel.ID, index)))})
			<strong class="mv-c1__caption" aria-hidden="true">{ i18n.T(ctx, "studioui.dialogue.caption") }</strong>
			<span class="mv-c1__colon" aria-hidden="true">:</span>
		</span>
		<label class="mv-sr-only" for={ indexID("line-", panel.ID, index) }>{ cellLabel(lineName, i18n.T(ctx, "studioui.script.line")) }</label>
		@ui.Textarea(ui.TextareaProps{ID: indexID("line-", panel.ID, index), Name: dialogueField(panel.ID, index, "text"), Value: line.Text, Placeholder: i18n.T(ctx, "studioui.script.line"), Class: "mv-c1__cell mv-c1__cell--line", Attrs: cellAttrs(v.ReadOnly, 2000, cellRows(line.Text, 48, 1, 6))})
	</div>
}

// panelMore is the row's disclosure: page, camera angle, notes, each line's
// type with a remove button, and SFX notes.
templ panelMore(v storyView, panel studio.ScriptPanel, panelName string) {
	<details class="mv-c1__more" open?={ v.Error != "" }>
		<summary class="mv-c1__moresum" aria-label={ i18n.T(ctx, "studioui.script.more", "label", panel.Label) } title={ i18n.T(ctx, "studioui.script.more_hint") }>
			@ui.Icon("dots", 16)
		</summary>
		<div class="mv-c1__moregrid">
			<div class="mv-c1__detail">
				<label class="mv-c1__minilabel" for={ "page-" + panel.ID }>{ i18n.T(ctx, "studioui.script.page") }<span class="mv-sr-only"> · { panelName }</span></label>
				@ui.Input(ui.InputProps{ID: "page-" + panel.ID, Name: panelField(panel.ID, "page_number"), Type: "number", Value: strconv.Itoa(panel.PageNumber), ReadOnly: v.ReadOnly, Inputmode: "numeric", Class: "mv-c1__cell mv-c1__cell--page", Attrs: templ.Attributes{"min": "1", "max": "9999"}})
			</div>
			<div class="mv-c1__detail">
				<label class="mv-c1__minilabel" for={ "camera-" + panel.ID }>{ i18n.T(ctx, "studioui.script.camera") }<span class="mv-sr-only"> · { panelName }</span></label>
				@ui.Input(ui.InputProps{ID: "camera-" + panel.ID, Name: panelField(panel.ID, "camera"), Value: panel.Camera, ReadOnly: v.ReadOnly, MaxLength: 240, Placeholder: i18n.T(ctx, "studioui.script.camera"), Class: "mv-c1__cell mv-c1__cell--meta"})
			</div>
			<div class="mv-c1__detail">
				<label class="mv-c1__minilabel" for={ "notes-" + panel.ID }>{ i18n.T(ctx, "studioui.script.notes") }<span class="mv-sr-only"> · { panelName }</span></label>
				@ui.Textarea(ui.TextareaProps{ID: "notes-" + panel.ID, Name: panelField(panel.ID, "notes"), Value: panel.Notes, Placeholder: i18n.T(ctx, "studioui.script.notes"), Class: "mv-c1__cell mv-c1__cell--notes", Attrs: cellAttrs(v.ReadOnly, 2000, cellRows(panel.Notes, 60, 1, 6))})
			</div>
			<div class="mv-c1__detail mv-c1__detail--lines">
				<span class="mv-c1__minilabel">{ i18n.T(ctx, "studioui.script.lines") }</span>
				<div class="mv-c1__linectls" data-line-controls={ panel.ID }>
					for index, line := range panel.Dialogue {
						@lineControl(v, panel, panelName, index, line)
					}
				</div>
				if !v.ReadOnly {
					@ui.Button(ui.ButtonProps{Variant: ui.Quiet, Size: ui.SM, Icon: "plus", Type: "submit", Class: "mv-c1__addline-full", Attrs: templ.Attributes{"name": intentAddLine, "value": panel.ID, "data-add-line": panel.ID, "formnovalidate": true}}) {
						{ i18n.T(ctx, "studioui.script.add_line") }
					}
				}
			</div>
			for sfxIndex, effect := range panel.SFX {
				<div class="mv-c1__detail">
					<label class="mv-c1__minilabel" for={ indexID("sfx-note-", panel.ID, sfxIndex) }>{ cellLabel(i18n.T(ctx, "studioui.script.sfx", "number", sfxIndex+1), i18n.T(ctx, "studioui.script.sfx_note")) }<span class="mv-sr-only"> · { panelName }</span></label>
					@ui.Input(ui.InputProps{ID: indexID("sfx-note-", panel.ID, sfxIndex), Name: sfxField(panel.ID, sfxIndex, "note"), Value: effect.Note, ReadOnly: v.ReadOnly, MaxLength: 240, Placeholder: effect.Text, Class: "mv-c1__cell mv-c1__cell--meta"})
				</div>
			}
		</div>
	</details>
}

templ lineControl(v storyView, panel studio.ScriptPanel, panelName string, index int, line studio.ScriptDialogue) {
	{{ lineName := cellLabel(panelName, i18n.T(ctx, "studioui.script.dialogue", "number", index+1)) }}
	<div class="mv-c1__linectl" data-line={ lineKey(panel.ID, index) }>
		<span class="mv-c1__lineno">{ strconv.Itoa(index + 1) }</span>
		<label class="mv-sr-only" for={ indexID("kind-", panel.ID, index) }>{ cellLabel(lineName, i18n.T(ctx, "studioui.script.kind")) }</label>
		@ui.Select(ui.SelectProps{ID: indexID("kind-", panel.ID, index), Name: dialogueField(panel.ID, index, "kind"), Value: dialogueKind(line.Kind), Disabled: v.ReadOnly, Class: "mv-c1__kind", Options: selectOptions(ctx, "studioui.dialogue.", dialogueKinds), Attrs: templ.Attributes{"data-line-kind": lineKey(panel.ID, index)}})
		if v.ReadOnly {
			<input type="hidden" name={ dialogueField(panel.ID, index, "kind") } value={ dialogueKind(line.Kind) }/>
		} else {
			@ui.Button(ui.ButtonProps{Variant: ui.Bare, Size: ui.SM, Icon: "trash", Type: "submit", Label: i18n.T(ctx, "studioui.script.remove_line", "line", lineName), Class: "mv-c1__removeline", Attrs: templ.Attributes{"name": intentRemoveLine, "value": lineKey(panel.ID, index), "data-remove-line": lineKey(panel.ID, index), "formnovalidate": true}})
		}
	</div>
}

// lineTemplate is what the studio script clones for a new line. Tokens:
// __PANEL__, __INDEX__, __NUMBER__ and __LABEL__.
templ lineTemplate(v storyView) {
	{{ tpl := studio.ScriptPanel{ID: "__PANEL__", Label: "__LABEL__"} }}
	{{ name := i18n.T(ctx, "studioui.script.panel", "label", "__LABEL__") }}
	<template data-line-template>
		@dialogueLineTemplate(v, tpl, name)
		@lineControlTemplate(v, tpl, name)
	</template>
}

templ dialogueLineTemplate(v storyView, panel studio.ScriptPanel, panelName string) {
	{{ lineName := cellLabel(panelName, i18n.T(ctx, "studioui.script.dialogue", "number", "__NUMBER__")) }}
	<div class="mv-c1__line" data-line="__PANEL__.__INDEX__" data-kind="speech">
		<span class="mv-c1__who">
			<label class="mv-sr-only" for="speaker-__PANEL__-__INDEX__">{ cellLabel(lineName, i18n.T(ctx, "studioui.script.speaker")) }</label>
			<input class="mv-input mv-c1__cell mv-c1__cell--speaker" type="text" id="speaker-__PANEL__-__INDEX__" name="panel.__PANEL__.dialogue.__INDEX__.speaker" value="" placeholder={ i18n.T(ctx, "studioui.script.speaker") } maxlength="160" size="6"/>
			<strong class="mv-c1__caption" aria-hidden="true">{ i18n.T(ctx, "studioui.dialogue.caption") }</strong>
			<span class="mv-c1__colon" aria-hidden="true">:</span>
		</span>
		<label class="mv-sr-only" for="line-__PANEL__-__INDEX__">{ cellLabel(lineName, i18n.T(ctx, "studioui.script.line")) }</label>
		<textarea class="mv-textarea mv-c1__cell mv-c1__cell--line" id="line-__PANEL__-__INDEX__" name="panel.__PANEL__.dialogue.__INDEX__.text" placeholder={ i18n.T(ctx, "studioui.script.line") } maxlength="2000" rows="1"></textarea>
	</div>
}

templ lineControlTemplate(v storyView, panel studio.ScriptPanel, panelName string) {
	{{ lineName := cellLabel(panelName, i18n.T(ctx, "studioui.script.dialogue", "number", "__NUMBER__")) }}
	<div class="mv-c1__linectl" data-line="__PANEL__.__INDEX__">
		<span class="mv-c1__lineno">__NUMBER__</span>
		<label class="mv-sr-only" for="kind-__PANEL__-__INDEX__">{ cellLabel(lineName, i18n.T(ctx, "studioui.script.kind")) }</label>
		@ui.Select(ui.SelectProps{ID: "kind-__PANEL__-__INDEX__", Name: "panel.__PANEL__.dialogue.__INDEX__.kind", Value: "speech", Class: "mv-c1__kind", Options: selectOptions(ctx, "studioui.dialogue.", dialogueKinds), Attrs: templ.Attributes{"data-line-kind": "__PANEL__.__INDEX__"}})
		@ui.Button(ui.ButtonProps{Variant: ui.Bare, Size: ui.SM, Icon: "trash", Type: "submit", Label: i18n.T(ctx, "studioui.script.remove_line", "line", lineName), Class: "mv-c1__removeline", Attrs: templ.Attributes{"name": intentRemoveLine, "value": "__PANEL__.__INDEX__", "data-remove-line": "__PANEL__.__INDEX__", "formnovalidate": true}})
	</div>
}

func mergeAttrs(sets ...templ.Attributes) templ.Attributes {
	out := templ.Attributes{}
	for _, set := range sets {
		for k, v := range set {
			out[k] = v
		}
	}
	return out
}
