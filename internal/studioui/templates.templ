package studioui

import (
	"context"
	"strconv"
	"strings"

	"github.com/MaramHarsha/MangaVeyra/internal/i18n"
	"github.com/MaramHarsha/MangaVeyra/internal/web/ui"
)

func selectOptions(ctx context.Context, prefix string, values []string) []ui.Option {
	out := make([]ui.Option, 0, len(values))
	for _, value := range values {
		out = append(out, ui.Option{Value: value, Label: i18n.T(ctx, prefix+value)})
	}
	return out
}

func readOnlyAttrs(readOnly bool) templ.Attributes {
	if readOnly {
		return templ.Attributes{"readonly": true}
	}
	return nil
}

func jobPollAttrs(v *jobView) templ.Attributes {
	if !v.Active {
		return nil
	}
	return templ.Attributes{"hx-get": v.StatusURL, "hx-trigger": "load delay:2s", "hx-swap": "outerHTML"}
}

func provenanceText(ctx context.Context, value string) string {
	switch value {
	case ui.ProvenanceAI:
		return i18n.T(ctx, "studioui.script.provenance.ai")
	case ui.ProvenanceAIAssisted:
		return i18n.T(ctx, "studioui.script.provenance.assisted")
	default:
		return i18n.T(ctx, "studioui.script.provenance.human")
	}
}

// ---- B3 wizard helpers -------------------------------------------------------

func stepName(ctx context.Context, step string) string {
	return i18n.T(ctx, "studioui.new.step."+step)
}

func stepClass(v newProjectView, step string) string {
	open := stepIndex(v.openStep())
	i := stepIndex(step)
	return ui.Cls("mv-steps__step", ui.If(i < open, "is-done"), ui.If(i == open, "is-current"))
}

func nextLabel(ctx context.Context, step string) string {
	i := stepIndex(step)
	if i+1 >= len(wizardSteps) {
		return ""
	}
	return i18n.T(ctx, "studioui.new.next."+wizardSteps[i+1])
}

func styleLabel(ctx context.Context, value string) string { return i18n.T(ctx, "style."+value) }

func formatLabel(ctx context.Context, value string) string {
	return i18n.T(ctx, "studioui.format."+value)
}

func genreSummary(ctx context.Context, genres []string) string {
	labels := make([]string, 0, len(genres))
	for _, genre := range genres {
		if contains(genreValues, genre) {
			labels = append(labels, i18n.T(ctx, "genre."+genre))
		}
	}
	if len(labels) == 0 {
		return i18n.T(ctx, "studioui.new.summary.none")
	}
	return strings.Join(labels, " · ")
}

func premiseSummary(ctx context.Context, v newProjectValues) string {
	if v.Mode == "adapt" {
		return i18n.T(ctx, "studioui.new.summary.adapt")
	}
	if strings.TrimSpace(v.Premise) == "" {
		return i18n.T(ctx, "studioui.new.summary.no_premise")
	}
	return i18n.T(ctx, "studioui.new.summary.quoted", "text", v.Premise)
}

func titleSummary(ctx context.Context, title string) string {
	if strings.TrimSpace(title) == "" {
		return i18n.T(ctx, "studioui.new.summary.untitled")
	}
	return title
}

func pageSizeOptions(ctx context.Context) []ui.Option {
	out := make([]ui.Option, 0, len(pageSizes))
	for _, size := range pageSizes {
		out = append(out, ui.Option{Value: size.Value, Label: i18n.T(ctx, "studioui.page_size."+size.Value)})
	}
	return out
}

var premiseSuggestions = []string{"gull", "keeper", "lantern"}

templ FormNotice(message string) {
	if message != "" {
		@ui.Notice(ui.ToneError, "alert-triangle") {
			<strong>{ i18n.T(ctx, "studioui.form.check") }</strong>
			<p>{ message }</p>
		}
	}
}

// NewProjectPage is the B3 wizard: one complete form holding all five steps.
// Without JavaScript every step shows, stacked; the studio script shows one
// step at a time with a working stepper, Back / Next and the live summary.
templ NewProjectPage(v newProjectView) {
	<div class="mv-wizard" data-wizard data-current={ v.openStep() }>
		<form id="mv-wizard-form" class="mv-wizard__form" method="post" action="/studio/new/premise" enctype="multipart/form-data" novalidate data-guard-unsaved>
			<div class="mv-wizard__main">
				<header class="mv-wizard__top">
					<a class="mv-wizard__close" href="/studio" aria-label={ i18n.T(ctx, "studioui.new.close") }>
						@ui.Icon("x", 20)
					</a>
					<h1 class="mv-wizard__name">{ i18n.T(ctx, "studioui.new.title") }</h1>
					<span class="mv-wizard__saved">{ i18n.T(ctx, "studioui.new.not_saved") }</span>
				</header>
				@wizardStepper(v)
				@wizardErrors(v)
				@wizardStep(v, "premise") {
					@wizardPremise(v)
				}
				@wizardStep(v, "genre") {
					@wizardGenre(v)
				}
				@wizardStep(v, "style") {
					@wizardStyle(v)
				}
				@wizardStep(v, "format") {
					@wizardFormat(v)
				}
				@wizardStep(v, "generate") {
					@wizardGenerate(v)
				}
				<footer class="mv-wizard__nav">
					@ui.Button(ui.ButtonProps{Variant: ui.Ghost, Icon: "arrow-left", Class: "mv-wizard__back", Attrs: templ.Attributes{"data-wizard-back": true, "hidden": true}}) {
						{ i18n.T(ctx, "ui.back") }
					}
					@ui.Button(ui.ButtonProps{Variant: ui.Primary, Size: ui.LG, Icon: "arrow-right", Class: "mv-wizard__next", Attrs: templ.Attributes{"data-wizard-next": true, "hidden": true}}) {
						<span data-wizard-next-text>{ nextLabel(ctx, wizardSteps[0]) }</span>
					}
					@ui.Button(ui.ButtonProps{Variant: ui.Primary, Size: ui.LG, Type: "submit", Icon: "sparkles", Class: "mv-wizard__submit", Attrs: templ.Attributes{"data-wizard-submit": true}}) {
						{ i18n.T(ctx, "studioui.new.submit") }
					}
				</footer>
			</div>
			@wizardSummary(v)
		</form>
	</div>
}

// wizardStepper is the designed progress bar. Its labels are in-page links,
// so they reach the stacked steps without JavaScript too.
templ wizardStepper(v newProjectView) {
	<nav class="mv-wizard__stepper" aria-label={ i18n.T(ctx, "studioui.new.steps") }>
		<ol class="mv-steps mv-list-plain">
			for i, step := range wizardSteps {
				<li class={ stepClass(v, step) } data-step-item={ step }>
					<a
						class="mv-wizard__steplink"
						href={ templ.URL("#mv-step-" + step) }
						data-step-link={ step }
						if step == v.openStep() {
							aria-current="step"
						}
					>
						<span class="mv-steps__bar" aria-hidden="true"></span>
						<span class="mv-steps__label">{ strconv.Itoa(i + 1) }. <span class="mv-wizard__stepname">{ stepName(ctx, step) }</span></span>
					</a>
				</li>
			}
		</ol>
	</nav>
}

templ wizardErrors(v newProjectView) {
	if v.Errors.Has() {
		@ui.Notice(ui.ToneError, "alert-triangle") {
			<strong>{ i18n.T(ctx, "studioui.form.check") }</strong>
			if v.Errors.Form() != "" {
				<p>{ v.Errors.Form() }</p>
			}
			<p class="mv-wizard__errsteps">
				<span>{ i18n.T(ctx, "studioui.new.error.steps") }</span>
				for _, step := range v.errorSteps() {
					<a href={ templ.URL("#mv-step-" + step) } data-step-link={ step }>{ stepName(ctx, step) }</a>
				}
			</p>
		}
	}
}

templ wizardStep(v newProjectView, step string) {
	<section
		class="mv-wizard__step"
		id={ "mv-step-" + step }
		data-step={ step }
		aria-labelledby={ "mv-step-" + step + "-title" }
		if nextLabel(ctx, step) != "" {
			data-next-label={ nextLabel(ctx, step) }
		}
	>
		<header class="mv-wizard__head">
			<span class="mv-wizard__eyebrow">
				{ i18n.T(ctx, "studioui.new.step_of", "number", stepIndex(step) + 1, "total", len(wizardSteps)) }
				<span class="mv-wizard__eyebrow-step">· { stepName(ctx, step) }</span>
			</span>
			<h2 class="mv-wizard__heading" id={ "mv-step-" + step + "-title" } tabindex="-1">{ i18n.T(ctx, "studioui.new." + step + ".heading") }</h2>
			<p class="mv-wizard__lead">{ i18n.T(ctx, "studioui.new." + step + ".lead") }</p>
		</header>
		{ children... }
	</section>
}

templ wizardPremise(v newProjectView) {
	@ui.Field(ui.FieldProps{ID: "title", Label: i18n.T(ctx, "studioui.new.title_label"), Error: v.Errors["title"]}) {
		@ui.Input(ui.InputProps{ID: "title", Name: "title", Value: v.Values.Title, Placeholder: i18n.T(ctx, "studioui.new.title_placeholder"), Required: true, MaxLength: 160, Invalid: v.Errors["title"] != "", Attrs: templ.Attributes{"data-summary-source": "title"}})
	}
	<div class="mv-field">
		<span class="mv-field__label">{ i18n.T(ctx, "studioui.new.mode") }</span>
		@ui.Segmented(ui.SegmentedProps{Name: "mode", Value: v.Values.Mode, Label: i18n.T(ctx, "studioui.new.mode"), Full: true, Options: []ui.Option{
			{Value: "premise", Label: i18n.T(ctx, "studioui.new.mode_premise")},
			{Value: "adapt", Label: i18n.T(ctx, "studioui.new.mode_adapt")},
		}})
		if v.Errors["mode"] != "" {
			<span class="mv-field__error" role="alert">
				@ui.Icon("alert-triangle", 14)
				<span>{ v.Errors["mode"] }</span>
			</span>
		}
	</div>
	<div class="mv-wizard__mode" data-mode-panel="premise">
		@ui.Field(ui.FieldProps{ID: "premise", Label: i18n.T(ctx, "studioui.new.premise_label"), Error: v.Errors["premise"], Class: "mv-wizard__premise"}) {
			@ui.Textarea(ui.TextareaProps{ID: "premise", Name: "premise", Value: v.Values.Premise, Placeholder: i18n.T(ctx, "studioui.new.premise_placeholder"), Rows: 4, MaxLength: 4000, Invalid: v.Errors["premise"] != "", Attrs: templ.Attributes{"data-summary-source": "premise"}})
		}
		<p class="mv-wizard__hint">{ i18n.T(ctx, "studioui.new.premise_hint") }</p>
		<div class="mv-wizard__tries" data-premise-tries hidden>
			<span class="mv-wizard__hint mv-wizard__trylabel">{ i18n.T(ctx, "studioui.new.premise_try") }</span>
			for _, key := range premiseSuggestions {
				<button type="button" class="mv-wizard__try" data-premise-suggestion={ i18n.T(ctx, "studioui.new.try."+key) }>{ i18n.T(ctx, "studioui.new.try." + key) }</button>
			}
		</div>
	</div>
	<div class="mv-wizard__mode mv-wizard__adapt" data-mode-panel="adapt">
		@ui.Field(ui.FieldProps{ID: "source_text", Label: i18n.T(ctx, "studioui.new.source_label"), Hint: i18n.T(ctx, "studioui.new.source_hint"), Error: v.Errors["source_text"]}) {
			@ui.Textarea(ui.TextareaProps{ID: "source_text", Name: "source_text", Value: v.Values.SourceText, Placeholder: i18n.T(ctx, "studioui.new.source_placeholder"), Rows: 4, Invalid: v.Errors["source_text"] != ""})
		}
		<span class="mv-wizard__or">{ i18n.T(ctx, "studioui.new.or") }</span>
		@ui.Field(ui.FieldProps{ID: "source_file", Label: i18n.T(ctx, "studioui.new.upload_label"), Hint: i18n.T(ctx, "studioui.new.upload_hint"), Error: v.Errors["source_file"]}) {
			@ui.FileDrop(ui.FileDropProps{ID: "source_file", Name: "source_file", Accept: ".txt,text/plain", Prompt: i18n.T(ctx, "studioui.new.upload_prompt"), Invalid: v.Errors["source_file"] != "", DescribedBy: uploadHint("source_file", v.Errors["source_file"] != "")})
		}
		@ui.Notice(ui.ToneInfo, "shield-lock") {
			<p>{ i18n.T(ctx, "studioui.new.private_source") }</p>
		}
	</div>
}

templ wizardGenre(v newProjectView) {
	<fieldset class="mv-wizard__fieldset">
		<legend class="mv-sr-only">{ i18n.T(ctx, "studioui.new.genres") }</legend>
		<div class="mv-chips">
			for _, genre := range genreValues {
				<label class="mv-chip">
					<input type="checkbox" name="genres" value={ genre } checked?={ contains(v.Values.Genres, genre) }/>
					@ui.Icon("check", 16)
					<span data-label>{ i18n.T(ctx, "genre." + genre) }</span>
				</label>
			}
		</div>
		if v.Errors["genres"] != "" {
			<span class="mv-field__error" role="alert">
				@ui.Icon("alert-triangle", 14)
				<span>{ v.Errors["genres"] }</span>
			</span>
		}
	</fieldset>
}

templ wizardStyle(v newProjectView) {
	<fieldset class="mv-wizard__fieldset">
		<legend class="mv-sr-only">{ i18n.T(ctx, "studioui.new.style") }</legend>
		<div class="mv-choices mv-choices--3">
			for _, style := range styleValues {
				<label class="mv-choice">
					<input type="radio" name="style" value={ style } checked?={ v.Values.Style == style }/>
					@ui.Icon(styleIcon(style), 22)
					<span>
						<span class="mv-choice__title" data-label>{ styleLabel(ctx, style) }</span>
						<span class="mv-choice__desc">{ i18n.T(ctx, "style." + style + ".desc") }</span>
					</span>
				</label>
			}
		</div>
		if v.Errors["style"] != "" {
			<span class="mv-field__error" role="alert">
				@ui.Icon("alert-triangle", 14)
				<span>{ v.Errors["style"] }</span>
			</span>
		}
	</fieldset>
}

templ wizardFormat(v newProjectView) {
	<fieldset class="mv-wizard__fieldset">
		<legend class="mv-sr-only">{ i18n.T(ctx, "studioui.new.format") }</legend>
		<div class="mv-wizard__formats">
			for _, format := range formatValues {
				<label class="mv-choice mv-fmt">
					<input type="radio" name="format" value={ format } checked?={ v.Values.Format == format }/>
					@formatThumb(format)
					<span class="mv-fmt__head">
						<strong class="mv-fmt__title" data-label>{ formatLabel(ctx, format) }</strong>
						<span class="mv-fmt__radio" aria-hidden="true"></span>
					</span>
					<span class="mv-fmt__desc">{ i18n.T(ctx, "studioui.new.format." + format + ".desc") }</span>
				</label>
			}
		</div>
		if v.Errors["format"] != "" {
			<span class="mv-field__error" role="alert">
				@ui.Icon("alert-triangle", 14)
				<span>{ v.Errors["format"] }</span>
			</span>
		}
	</fieldset>
	<div class="mv-wizard__triple">
		@ui.Field(ui.FieldProps{ID: "page_size", Label: i18n.T(ctx, "studioui.new.page_size"), Error: v.Errors["page_size"]}) {
			@ui.Select(ui.SelectProps{ID: "page_size", Name: "page_size", Value: v.Values.PageSize, Options: pageSizeOptions(ctx), Invalid: v.Errors["page_size"] != ""})
		}
		<div class="mv-field is-soon">
			<label class="mv-field__label" for="chapters_plan">
				<span>{ i18n.T(ctx, "studioui.new.chapters_plan") }</span>
				@ui.SoonTag()
			</label>
			@ui.Input(ui.InputProps{ID: "chapters_plan", Type: "number", Value: "1", Disabled: true})
		</div>
		@ui.Field(ui.FieldProps{ID: "pages_target", Label: i18n.T(ctx, "studioui.new.pages_per_chapter"), Error: v.Errors["pages_target"]}) {
			@ui.Input(ui.InputProps{ID: "pages_target", Name: "pages_target", Type: "number", Value: strconv.Itoa(v.Values.PagesTarget), Inputmode: "numeric", Invalid: v.Errors["pages_target"] != "", Attrs: templ.Attributes{"min": "1", "max": "256"}})
		}
	</div>
}

// formatThumb draws the format card's thumbnail as the design does: a paper
// page (or a spread) of screentone panels with tilted gutters, or a webtoon
// strip of toned cells.
templ formatThumb(format string) {
	<span class="mv-fmt__thumb" aria-hidden="true">
		switch format {
			case "webtoon":
				<span class="mv-fmt__strip">
					<span class="mv-tone mv-fmt__cell mv-fmt__cell--1"></span>
					<span class="mv-tone mv-fmt__cell mv-fmt__cell--2"></span>
					<span class="mv-tone mv-fmt__cell mv-fmt__cell--3"></span>
				</span>
			case "manga_rtl":
				@pageThumb(format + "-1")
				@pageThumb(format + "-2")
			default:
				@pageThumb(format + "-1")
		}
	</span>
}

// thumbPanels are the design's five-panel page with tilted gutters, in the
// 84 x 119 page box.
var thumbPanels = []string{
	"5,5 79,5 79,36.6 5,41",
	"43.5,43.7 79,39.3 79,72.6 43.5,72.6",
	"5,44.2 41.3,43.8 41.3,72.6 5,72.6",
	"5,75.9 49.4,75.9 43.5,114 5,114",
	"51.6,75.9 79,75.9 79,114 45.7,114",
}

templ pageThumb(id string) {
	<svg class="mv-fmt__page" data-theme="light" width="84" height="119" viewBox="0 0 84 119" focusable="false">
		<defs>
			<pattern id={ "mv-fmt-dots-" + id } width="6" height="6" patternUnits="userSpaceOnUse">
				<circle class="mv-fmt__dot" cx="3" cy="3" r="1.05"></circle>
			</pattern>
		</defs>
		<rect class="mv-fmt__paper" width="84" height="119"></rect>
		for _, points := range thumbPanels {
			<polygon class="mv-fmt__panel" points={ points }></polygon>
			<polygon points={ points } fill={ "url(#mv-fmt-dots-" + id + ")" }></polygon>
			<polygon class="mv-fmt__frame" points={ points }></polygon>
		}
	</svg>
}

templ wizardGenerate(v newProjectView) {
	<div class="mv-wizard__pair">
		@ui.Field(ui.FieldProps{ID: "chapter_title", Label: i18n.T(ctx, "studioui.new.chapter_label"), Error: v.Errors["chapter_title"]}) {
			@ui.Input(ui.InputProps{ID: "chapter_title", Name: "chapter_title", Value: v.Values.ChapterTitle, Placeholder: i18n.T(ctx, "studioui.new.chapter_placeholder"), Required: true, MaxLength: 160, Invalid: v.Errors["chapter_title"] != ""})
		}
		@ui.Field(ui.FieldProps{ID: "language", Label: i18n.T(ctx, "studioui.new.language"), Error: v.Errors["language"]}) {
			@ui.Select(ui.SelectProps{ID: "language", Name: "language", Value: v.Values.Language, Options: selectOptions(ctx, "studioui.language.", languageValues), Invalid: v.Errors["language"] != ""})
		}
	</div>
}

// wizardSummary is the designed "Your manga so far" panel. The studio script
// keeps it in step with the form; the server renders the submitted values.
templ wizardSummary(v newProjectView) {
	<aside class="mv-wizard__summary" aria-labelledby="mv-summary-label">
		<span class="mv-label-mono" id="mv-summary-label">{ i18n.T(ctx, "studioui.new.summary.label") }</span>
		<span class="mv-wizard__sumtitle" data-summary="title" data-empty={ i18n.T(ctx, "studioui.new.summary.untitled") }>{ titleSummary(ctx, v.Values.Title) }</span>
		<p
			class="mv-wizard__sumpremise"
			data-summary="premise"
			data-empty={ i18n.T(ctx, "studioui.new.summary.no_premise") }
			data-quote={ i18n.T(ctx, "studioui.new.summary.quoted") }
			data-adapt={ i18n.T(ctx, "studioui.new.summary.adapt") }
		>{ premiseSummary(ctx, v.Values) }</p>
		<dl class="mv-wizard__sumrows">
			<div>
				<dt>{ stepName(ctx, "genre") }</dt>
				<dd data-summary="genres" data-empty={ i18n.T(ctx, "studioui.new.summary.none") }>{ genreSummary(ctx, v.Values.Genres) }</dd>
			</div>
			<div>
				<dt>{ stepName(ctx, "style") }</dt>
				<dd data-summary="style">{ styleLabel(ctx, v.Values.Style) }</dd>
			</div>
			<div>
				<dt>{ stepName(ctx, "format") }</dt>
				<dd data-summary="format">{ formatLabel(ctx, v.Values.Format) }</dd>
			</div>
		</dl>
		<div class="mv-wizard__makes">
			<strong>{ i18n.T(ctx, "studioui.new.makes.title") }</strong>
			<span>{ i18n.T(ctx, "studioui.new.makes.body") }</span>
			@ui.RouteChip(i18n.T(ctx, "studioui.route.auto"), i18n.T(ctx, "studioui.route.pick"), "", "")
		</div>
	</aside>
}

templ NoChapterPage(v noChapterView) {
	<main class="mv-story">
		<header class="mv-pagehead"><div class="mv-pagehead__text"><span class="mv-label-mono">{ i18n.T(ctx, "studioui.story.project") }</span><h1 class="mv-pagehead__title">{ v.Project.Title }</h1></div></header>
		@ui.State(ui.StateProps{SFX: "シーン…", JP: true, Title: i18n.T(ctx, "studioui.chapter.empty"), Body: i18n.T(ctx, "studioui.chapter.empty_body"), Art: "splash", Boxed: true}) {
			if v.CanEdit {
				<form class="mv-story__chapter-form" method="post" action={ templ.URL(storyPath(v.Project.ID, "") + "/chapters") } novalidate>
					@FormNotice(v.Error)
					@ui.Field(ui.FieldProps{ID: "chapter_title", Label: i18n.T(ctx, "studioui.new.chapter_label")}) {
						@ui.Input(ui.InputProps{ID: "chapter_title", Name: "chapter_title", Placeholder: i18n.T(ctx, "studioui.new.chapter_placeholder"), Required: true, MaxLength: 160})
					}
					@ui.Button(ui.ButtonProps{Variant: ui.Primary, Type: "submit", Icon: "plus"}) {
						{ i18n.T(ctx, "studioui.chapter.create") }
					}
				</form>
			}
		}
	</main>
}

templ GenerationStart(v storyView) {
	@ui.State(ui.StateProps{SFX: "INK", Title: i18n.T(ctx, "studioui.generate.title"), Body: i18n.T(ctx, "studioui.generate.body"), Art: "speedlines", Boxed: true}) {
		<form class="mv-story__generate" method="post" action={ templ.URL(storyPath(v.Project.ID, v.Chapter.ID) + "/generate") } novalidate>
			@ui.Field(ui.FieldProps{ID: "pages_target", Label: i18n.T(ctx, "studioui.new.pages"), Hint: i18n.T(ctx, "studioui.new.pages_hint")}) {
				@ui.Input(ui.InputProps{ID: "pages_target", Name: "pages_target", Type: "number", Value: strconv.Itoa(defaultPagesTarget), Inputmode: "numeric", Described: true, Attrs: templ.Attributes{"min": "1", "max": "256"}})
			}
			@ui.Button(ui.ButtonProps{Variant: ui.Primary, Type: "submit", Icon: "sparkles"}) {
				{ i18n.T(ctx, "studioui.generate.submit") }
			}
		</form>
	}
}

templ JobPanel(v *jobView) {
	<div class="mv-story-job" id={ "job-" + v.Job.ID } aria-live="polite" { jobPollAttrs(v)... }>
		@ui.GenState(ui.GenProps{State: v.State, Position: v.Position, Progress: v.Job.Progress, Step: v.Job.Step, Steps: v.Job.Steps, ProgressText: v.Progress, Title: v.Title, Detail: v.Detail, ResultLabel: v.ResultLabel, SFX: "FZZT", JobID: v.Job.ID})
		<div class="mv-story-job__actions">
			<a href={ templ.URL(v.StoryURL) } class="mv-btn mv-btn--quiet">
				@ui.Icon("refresh", 16)
				{ i18n.T(ctx, "studioui.job.refresh") }
			</a>
			if v.Retryable {
				<form method="post" action={ templ.URL(v.RetryURL) } novalidate>
					@ui.Button(ui.ButtonProps{Variant: ui.Secondary, Type: "submit", Icon: "refresh"}) {
						{ i18n.T(ctx, "studioui.job.retry") }
					}
				</form>
			}
		</div>
	</div>
}
