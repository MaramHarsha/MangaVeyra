package studio

import (
	"strconv"

	"github.com/MaramHarsha/MangaVeyra/internal/i18n"
	"github.com/MaramHarsha/MangaVeyra/internal/web/ui"
)

// StoryPage is C1: arcs → chapters → scenes tree, the panel-by-panel script
// (or prose) of the current scene and the script assistant.
templ StoryPage(v StoryView) {
	<div class={ ui.Cls("mv-story", ui.If(v.Chapter == nil, "mv-story--empty")) }>
		@storyTree(v)
		<section class="mv-story__main" aria-label={ i18n.T(ctx, "studio.story.script") }>
			if v.Chapter == nil {
				<div class="mv-story__pad">
					@EmptyState("シーン…", i18n.T(ctx, "studio.story.empty.title"), i18n.T(ctx, "studio.story.empty.body"), true) {
						if v.Access.Can(EditStory) {
							<form class="mv-row mv-row--sm mv-row--wrap mv-center" method="post" action={ templ.URL(v.Base() + "/chapters") }>
								<label class="mv-sr-only" for="first-chapter">{ i18n.T(ctx, "studio.story.chapter_title") }</label>
								@ui.Input(ui.InputProps{ID: "first-chapter", Name: "title", Placeholder: i18n.T(ctx, "studio.story.chapter_title"), MaxLength: 160})
								@ui.Button(ui.ButtonProps{Variant: ui.Primary, Type: "submit", Icon: "plus"}) {
									{ i18n.T(ctx, "studio.story.add_chapter") }
								}
							</form>
						}
					}
				</div>
			} else {
				@sceneHead(v)
				if v.Scene == nil {
					<div class="mv-story__pad">
						@EmptyState("HMMM…", i18n.T(ctx, "studio.story.no_scenes"), i18n.T(ctx, "studio.story.no_scenes_body"), false) {
							if v.Access.Can(EditStory) {
								@addSceneForm(v, "first-scene")
							}
						}
					</div>
				} else if v.Tab == "prose" {
					@proseEditor(v)
				} else {
					@scriptTable(v)
				}
			}
		</section>
		if v.Chapter != nil {
			@assistPanel(v)
		}
	</div>
}

templ storyTree(v StoryView) {
	<nav class="mv-tree mv-hide-mobile" aria-label={ i18n.T(ctx, "studio.story.tree") }>
		<ul class="mv-tree__list mv-list-plain">
			for _, arc := range v.Arcs {
				<li>
					@treeArc(v, arc)
					<ul class="mv-list-plain">
						for _, ch := range v.Chapters {
							if ch.ArcID == arc.ID {
								@treeChapter(v, ch)
							}
						}
					</ul>
				</li>
			}
			for _, ch := range v.Chapters {
				if ch.ArcID == "" || !arcExists(v.Arcs, ch.ArcID) {
					@treeChapter(v, ch)
				}
			}
		</ul>
		if v.Access.Can(EditStory) {
			<details class="mv-tree__add">
				<summary class="mv-tree__item mv-tree__item--add">
					@ui.Icon("plus", 15)
					{ i18n.T(ctx, "studio.story.add") }
				</summary>
				<div class="mv-stack mv-stack--sm mv-tree__forms">
					<form class="mv-row mv-row--sm" method="post" action={ templ.URL(v.Base() + "/arcs") }>
						<input type="hidden" name="next" value={ v.Here() }/>
						<label class="mv-sr-only" for="new-arc">{ i18n.T(ctx, "studio.story.new_arc") }</label>
						@ui.Input(ui.InputProps{ID: "new-arc", Name: "title", Placeholder: i18n.T(ctx, "studio.story.new_arc"), Required: true, MaxLength: 120, Class: "mv-input--sm"})
						@ui.Button(ui.ButtonProps{Variant: ui.Secondary, Size: ui.SM, Type: "submit", Icon: "folder-plus", Label: i18n.T(ctx, "studio.story.new_arc")})
					</form>
					<form class="mv-stack mv-stack--xs" method="post" action={ templ.URL(v.Base() + "/chapters") }>
						<div class="mv-row mv-row--sm">
							<label class="mv-sr-only" for="new-chapter">{ i18n.T(ctx, "studio.story.new_chapter") }</label>
							@ui.Input(ui.InputProps{ID: "new-chapter", Name: "title", Placeholder: i18n.T(ctx, "studio.story.new_chapter"), MaxLength: 160, Class: "mv-input--sm"})
							@ui.Button(ui.ButtonProps{Variant: ui.Secondary, Size: ui.SM, Type: "submit", Icon: "file-plus", Label: i18n.T(ctx, "studio.story.new_chapter")})
						</div>
						if len(v.Arcs) > 0 {
							@ui.Select(ui.SelectProps{ID: "new-chapter-arc", Name: "arc_id", Value: chapterArc(v), Options: arcOptions(ctx, v.Arcs), Attrs: attrs("aria-label", i18n.T(ctx, "studio.story.arc"))})
						}
					</form>
					if v.Chapter != nil {
						@addSceneForm(v, "new-scene")
					}
				</div>
			</details>
		}
		if v.Chapter != nil && v.Issues > 0 {
			<a class="mv-tree__issues" href={ templ.URL(v.Base() + "/chapters/" + itoa(v.Chapter.Number) + "/continuity") }>
				@ui.Icon("alert-triangle", 16)
				<span>{ i18n.T(ctx, "studio.story.issues", "count", v.Issues, "n", v.Chapter.Number) } <span class="mv-accent-text">{ i18n.T(ctx, "studio.story.review") }</span></span>
			</a>
		}
	</nav>
}

templ addSceneForm(v StoryView, id string) {
	<form class="mv-row mv-row--sm" method="post" action={ templ.URL(v.Base() + "/scenes") }>
		<input type="hidden" name="chapter_id" value={ v.Chapter.ID }/>
		<label class="mv-sr-only" for={ id }>{ i18n.T(ctx, "studio.story.new_scene") }</label>
		@ui.Input(ui.InputProps{ID: id, Name: "title", Placeholder: i18n.T(ctx, "studio.story.new_scene"), Required: true, MaxLength: 160, Class: "mv-input--sm"})
		@ui.Button(ui.ButtonProps{Variant: ui.Secondary, Size: ui.SM, Type: "submit", Icon: "plus", Label: i18n.T(ctx, "studio.story.new_scene")})
	</form>
}

templ treeArc(v StoryView, arc Arc) {
	if v.Rename == arc.ID {
		@renameForm(v, v.Base()+"/arcs/"+arc.ID, arc.Title, 0)
	} else {
		<div class="mv-tree__row">
			<span class="mv-tree__item mv-tree__item--arc">
				@ui.Icon(arcIcon(v, arc), 15)
				<span class="mv-truncate">{ i18n.T(ctx, "studio.story.arc_label", "n", arc.OrderIdx+1, "title", arc.Title) }</span>
			</span>
			if v.Access.Can(EditStory) {
				@treeMenu(v, "/arcs/"+arc.ID, arc.ID, true)
			}
		</div>
	}
}

templ treeChapter(v StoryView, ch Chapter) {
	<li>
		if v.Rename == ch.ID {
			@renameForm(v, v.Base()+"/chapters/"+ch.ID, ch.Title, 1)
		} else {
			<div class="mv-tree__row">
				<a
					class={ ui.Cls("mv-tree__item mv-tree__item--chapter", ui.If(v.Chapter != nil && v.Chapter.ID == ch.ID, "is-open")) }
					href={ templ.URL(v.Base() + "/story/" + itoa(ch.Number)) }
					if v.Chapter != nil && v.Chapter.ID == ch.ID && v.Scene == nil {
						aria-current="page"
					}
				>
					@ui.Icon("file", 15)
					<span class="mv-truncate">{ chapterLabel(ctx, ch) }</span>
					if ch.Locked {
						@ui.Icon("lock", 13)
						<span class="mv-sr-only">{ i18n.T(ctx, "studio.lock.locked") }</span>
					}
				</a>
				if v.Access.Can(EditStory) {
					@treeMenu(v, "/chapters/"+ch.ID, ch.ID, true)
				}
			</div>
		}
		if v.Chapter != nil && v.Chapter.ID == ch.ID {
			<ul class="mv-list-plain">
				for i, sc := range v.Scenes {
					<li>
						if v.Rename == sc.ID {
							@renameForm(v, v.Base()+"/scenes/"+sc.ID, sc.Title, 2)
						} else {
							<div class="mv-tree__row">
								<a
									class="mv-tree__item mv-tree__item--scene"
									href={ templ.URL(v.SceneURL(i, v.Tab)) }
									if v.Scene != nil && v.Scene.ID == sc.ID {
										aria-current="page"
									}
								>
									@ui.Icon("point", 15)
									<span class="mv-truncate">{ i18n.T(ctx, "studio.story.scene_short", "n", i+1, "title", sc.Title) }</span>
								</a>
								if v.Access.Can(EditStory) {
									@treeMenu(v, "/scenes/"+sc.ID, sc.ID, true)
								}
							</div>
						}
					</li>
				}
			</ul>
		}
	</li>
}

templ renameForm(v StoryView, action, value string, depth int) {
	<form class={ "mv-tree__rename mv-tree__rename--d" + strconv.Itoa(depth) } method="post" action={ templ.URL(action) }>
		<input type="hidden" name="next" value={ v.Here() }/>
		<label class="mv-sr-only" for="rename-input">{ i18n.T(ctx, "studio.story.rename") }</label>
		@ui.Input(ui.InputProps{ID: "rename-input", Name: "title", Value: value, Required: true, Autofocus: true, MaxLength: 160, Class: "mv-input--sm"})
		@ui.Button(ui.ButtonProps{Variant: ui.Primary, Size: ui.SM, Type: "submit", Icon: "check", Label: i18n.T(ctx, "studio.save")})
		@ui.LinkButton(v.Here(), ui.ButtonProps{Variant: ui.IconOnly, Size: ui.SM, Icon: "x", Label: i18n.T(ctx, "ui.cancel")})
	</form>
}

templ treeMenu(v StoryView, path, id string, movable bool) {
	@ui.Dropdown("mv-tree__menu", "end", false, treeMenuTrigger(), treeMenuItems(ctx, v, path, id))
}

templ treeMenuTrigger() {
	<span class="mv-iconlink mv-tree__dots" aria-hidden="true">
		@ui.Icon("dots", 16)
	</span>
	<span class="mv-sr-only">{ i18n.T(ctx, "studio.story.item_actions") }</span>
}

templ sceneHead(v StoryView) {
	<header class="mv-scenehead">
		<div class="mv-stack mv-stack--xs mv-hide-mobile">
			<span class="mv-small mv-muted">
				{ i18n.T(ctx, "studio.ch_short", "n", v.Chapter.Number) }
				if v.Scene != nil {
					· { i18n.T(ctx, "studio.story.scene_n", "n", v.SceneIdx+1) }
				}
			</span>
			<h1 class="mv-scenehead__title">
				if v.Scene != nil {
					{ v.Scene.Title }
				} else {
					{ chapterLabel(ctx, *v.Chapter) }
				}
			</h1>
		</div>
		if v.Scene != nil {
			<div class="mv-scenehead__actions">
				<nav class="mv-seg mv-scenehead__tabs" aria-label={ i18n.T(ctx, "studio.story.view") }>
					<a
						class="mv-seg__item"
						href={ templ.URL(v.SceneURL(v.SceneIdx, "prose")) }
						if v.Tab == "prose" {
							aria-current="true"
						}
					>{ i18n.T(ctx, "studio.story.prose") }</a>
					<a
						class="mv-seg__item"
						href={ templ.URL(v.SceneURL(v.SceneIdx, "")) }
						if v.Tab == "panels" {
							aria-current="true"
						}
					>{ i18n.T(ctx, "studio.story.panels") }</a>
				</nav>
				if v.Access.Can(EditPages) && len(v.Script) > 0 {
					<form class="mv-hide-mobile" method="post" action={ templ.URL(v.Base() + "/chapters/" + v.Chapter.ID + "/pages") }>
						<input type="hidden" name="next" value={ v.Here() }/>
						@ui.Button(ui.ButtonProps{Variant: ui.Primary, Size: ui.SM, Type: "submit", Icon: "layout-board"}) {
							{ i18n.T(ctx, "studio.story.make_pages") }
						}
					</form>
				}
			</div>
		}
	</header>
	if v.Chapter.Locked {
		<div class="mv-story__pad mv-story__pad--tight">
			@ui.Notice(ui.ToneWarning, "lock") {
				{ i18n.T(ctx, "studio.story.chapter_locked") }
			}
		</div>
	}
}

templ scriptTable(v StoryView) {
	<div class="mv-script" id="mv-script">
		<div class="mv-script__head mv-hide-mobile" aria-hidden="true">
			<span>{ i18n.T(ctx, "studio.script.col.panel") }</span>
			<span>{ i18n.T(ctx, "studio.script.col.camera") }</span>
			<span>{ i18n.T(ctx, "studio.script.col.action") }</span>
			<span class="mv-script__sfxcol">SFX</span>
		</div>
		if len(v.Script) == 0 {
			<div class="mv-story__pad">
				@EmptyState("…", i18n.T(ctx, "studio.script.empty.title"), i18n.T(ctx, "studio.script.empty.body"), false) {
					if v.Access.Can(EditScript) {
						@addPanelButton(v, "", ui.Primary)
					}
				}
			</div>
		} else {
			<ol class="mv-list-plain mv-script__rows">
				for _, sp := range v.Script {
					@ScriptRow(ScriptRowView{Story: &v, Panel: sp, Edit: v.EditID == sp.ID})
				}
			</ol>
			if v.Access.Can(EditScript) {
				<div class="mv-script__add">
					@addPanelButton(v, v.Script[len(v.Script)-1].ID, ui.Ghost)
				</div>
			}
		}
		if v.Access.Can(EditPages) && len(v.Script) > 0 {
			<form class="mv-show-mobile mv-script__mobilemake" method="post" action={ templ.URL(v.Base() + "/chapters/" + v.Chapter.ID + "/pages") }>
				<input type="hidden" name="next" value={ v.Here() }/>
				@ui.Button(ui.ButtonProps{Variant: ui.Primary, Type: "submit", Full: true, Size: ui.LG}) {
					{ i18n.T(ctx, "studio.story.make_pages") }
				}
			</form>
		}
		@sceneNav(v)
	</div>
}

templ sceneNav(v StoryView) {
	if len(v.Scenes) > 1 {
		<nav class="mv-scenenav" aria-label={ i18n.T(ctx, "studio.story.scenes") }>
			if v.SceneIdx > 0 {
				<a class="mv-link--plain" href={ templ.URL(v.SceneURL(v.SceneIdx-1, v.Tab)) }>
					@ui.Icon("arrow-left", 16)
					{ i18n.T(ctx, "studio.story.scene_short", "n", v.SceneIdx, "title", v.Scenes[v.SceneIdx-1].Title) }
				</a>
			} else {
				<span></span>
			}
			if v.SceneIdx < len(v.Scenes)-1 {
				<a class="mv-link--plain" href={ templ.URL(v.SceneURL(v.SceneIdx+1, v.Tab)) }>
					{ i18n.T(ctx, "studio.story.scene_short", "n", v.SceneIdx+2, "title", v.Scenes[v.SceneIdx+1].Title) }
					@ui.Icon("arrow-right", 16)
				</a>
			}
		</nav>
	}
}

templ addPanelButton(v StoryView, after string, variant ui.Variant) {
	<form method="post" action={ templ.URL(v.Base() + "/script") }>
		<input type="hidden" name="scene_id" value={ v.Scene.ID }/>
		<input type="hidden" name="after" value={ after }/>
		<input type="hidden" name="next" value={ v.SceneURL(v.SceneIdx, "") }/>
		@ui.Button(ui.ButtonProps{Variant: variant, Size: ui.SM, Type: "submit", Icon: "plus"}) {
			{ i18n.T(ctx, "studio.script.add_panel") }
		}
	</form>
}

// ScriptRow is one panel of the script: display or inline edit (HTMX).
templ ScriptRow(r ScriptRowView) {
	if r.Edit {
		<li class="mv-srow mv-srow--edit" id={ "row-" + r.Panel.ID }>
			@scriptEditForm(r)
		</li>
	} else {
		<li class="mv-srow" id={ "row-" + r.Panel.ID }>
			if r.Story.Access.Can(EditScript) {
				<a
					class="mv-srow__label mv-link--plain"
					href={ templ.URL(r.Story.SceneURL(r.Story.SceneIdx, "") + "?edit=" + r.Panel.ID + "#row-" + r.Panel.ID) }
					hx-get={ r.Story.Base() + "/script/" + r.Panel.ID + "/edit" }
					hx-target={ "#row-" + r.Panel.ID }
					hx-swap="outerHTML"
					aria-label={ i18n.T(ctx, "studio.script.edit", "label", r.Panel.Label) }
				>{ r.Panel.Label }</a>
			} else {
				<span class="mv-srow__label">{ r.Panel.Label }</span>
			}
			<div class="mv-srow__cam">
				if r.Panel.Camera != "" {
					<span class="mv-cam">{ r.Panel.Camera }</span>
				}
				if r.Panel.Emotion != "" {
					<span class="mv-srow__emotion">{ r.Panel.Emotion }</span>
				}
			</div>
			<div class="mv-srow__text">
				if r.Panel.Action != "" {
					<span class="mv-srow__action">{ r.Panel.Action }</span>
				}
				for _, l := range r.Panel.Dialogue.V {
					<span class={ "mv-srow__line mv-srow__line--" + l.Kind }>
						if l.Kind == LineCaption {
							<strong>{ i18n.T(ctx, "studio.script.caption") }:</strong>
						} else {
							<strong>{ l.Speaker }:</strong>
						}
						{ l.Text }
						if l.Kind != LineSpeech && l.Kind != LineCaption && l.Kind != "" {
							<span class="mv-srow__kind">({ i18n.T(ctx, "studio.line."+l.Kind) })</span>
						}
					</span>
				}
			</div>
			<div class="mv-srow__sfx">
				for _, x := range r.Panel.SFX.V {
					<span class="mv-sfxword">{ x }</span>
				}
			</div>
			if r.Story.Access.Can(EditScript) {
				<div class="mv-srow__tools">
					<a
						class="mv-iconlink"
						href={ templ.URL(r.Story.SceneURL(r.Story.SceneIdx, "") + "?edit=" + r.Panel.ID + "#row-" + r.Panel.ID) }
						hx-get={ r.Story.Base() + "/script/" + r.Panel.ID + "/edit" }
						hx-target={ "#row-" + r.Panel.ID }
						hx-swap="outerHTML"
						aria-label={ i18n.T(ctx, "studio.script.edit", "label", r.Panel.Label) }
						title={ i18n.T(ctx, "studio.script.edit_short") }
					>
						@ui.Icon("pencil", 16)
					</a>
					@rowAction(r, "/move", "up", "arrow-up", i18n.T(ctx, "studio.script.move_up"))
					@rowAction(r, "/move", "down", "arrow-down", i18n.T(ctx, "studio.script.move_down"))
					@rowAction(r, "/delete", "", "trash", i18n.T(ctx, "studio.script.delete"))
				</div>
			}
		</li>
	}
}

templ rowAction(r ScriptRowView, path, dir, icon, label string) {
	<form method="post" action={ templ.URL(r.Story.Base() + "/script/" + r.Panel.ID + path) }>
		<input type="hidden" name="next" value={ r.Story.SceneURL(r.Story.SceneIdx, "") }/>
		if dir != "" {
			<input type="hidden" name="dir" value={ dir }/>
		}
		<button class="mv-iconlink" type="submit" aria-label={ label } title={ label }>
			@ui.Icon(icon, 16)
		</button>
	</form>
}

templ scriptEditForm(r ScriptRowView) {
	<form
		class="mv-sedit"
		method="post"
		action={ templ.URL(r.Story.Base() + "/script/" + r.Panel.ID) }
		hx-post={ r.Story.Base() + "/script/" + r.Panel.ID }
		hx-target={ "#row-" + r.Panel.ID }
		hx-swap="outerHTML"
	>
		<input type="hidden" name="next" value={ r.Story.SceneURL(r.Story.SceneIdx, "") + "#row-" + r.Panel.ID }/>
		<div class="mv-sedit__grid">
			@ui.Field(ui.FieldProps{ID: "sp-page-" + r.Panel.ID, Label: i18n.T(ctx, "studio.script.page")}) {
				@ui.Input(ui.InputProps{ID: "sp-page-" + r.Panel.ID, Name: "page", Type: "number", Value: strconv.Itoa(r.Panel.PageNumber), Attrs: attrs("min", "1", "max", "999")})
			}
			@ui.Field(ui.FieldProps{ID: "sp-cam-" + r.Panel.ID, Label: i18n.T(ctx, "studio.script.camera")}) {
				@ui.Input(ui.InputProps{ID: "sp-cam-" + r.Panel.ID, Name: "camera", Value: r.Panel.Camera, MaxLength: 40, Attrs: attrs("list", "mv-cameras")})
			}
			@ui.Field(ui.FieldProps{ID: "sp-emo-" + r.Panel.ID, Label: i18n.T(ctx, "studio.script.emotion")}) {
				@ui.Input(ui.InputProps{ID: "sp-emo-" + r.Panel.ID, Name: "emotion", Value: r.Panel.Emotion, MaxLength: 80})
			}
			@ui.Field(ui.FieldProps{ID: "sp-sfx-" + r.Panel.ID, Label: "SFX", Hint: i18n.T(ctx, "studio.script.sfx_hint")}) {
				@ui.Input(ui.InputProps{ID: "sp-sfx-" + r.Panel.ID, Name: "sfx", Value: joinComma(r.Panel.SFX.V), MaxLength: 200, Described: true})
			}
		</div>
		<datalist id="mv-cameras">
			for _, c := range CameraPresets {
				<option value={ c }></option>
			}
		</datalist>
		@ui.Field(ui.FieldProps{ID: "sp-action-" + r.Panel.ID, Label: i18n.T(ctx, "studio.script.action")}) {
			@ui.Textarea(ui.TextareaProps{ID: "sp-action-" + r.Panel.ID, Name: "action", Value: r.Panel.Action, Rows: 2})
		}
		<fieldset class="mv-field mv-sedit__lines">
			<legend class="mv-field__label">{ i18n.T(ctx, "studio.script.dialogue") }</legend>
			for i, l := range editLines(r.Panel.Dialogue.V) {
				<div class="mv-sedit__line">
					@ui.Select(ui.SelectProps{ID: "sp-speaker-" + r.Panel.ID + "-" + strconv.Itoa(i), Name: "line_speaker", Value: l.CharacterID,
						Options: speakerOptions(ctx, r.Story.Characters), Attrs: attrs("aria-label", i18n.T(ctx, "studio.script.speaker"))})
					@ui.Select(ui.SelectProps{ID: "sp-kind-" + r.Panel.ID + "-" + strconv.Itoa(i), Name: "line_kind", Value: l.Kind,
						Options: lineKindOptions(ctx), Attrs: attrs("aria-label", i18n.T(ctx, "studio.script.kind"))})
					@ui.Input(ui.InputProps{ID: "sp-text-" + r.Panel.ID + "-" + strconv.Itoa(i), Name: "line_text", Value: l.Text, MaxLength: 600,
						Placeholder: i18n.T(ctx, "studio.script.line_placeholder"), Attrs: attrs("aria-label", i18n.T(ctx, "studio.script.line", "n", i+1))})
				</div>
			}
			<span class="mv-field__hint">{ i18n.T(ctx, "studio.script.lines_hint") }</span>
		</fieldset>
		<div class="mv-row mv-row--sm mv-row--end">
			<a
				class="mv-btn mv-btn--ghost mv-btn--sm"
				href={ templ.URL(r.Story.SceneURL(r.Story.SceneIdx, "") + "#row-" + r.Panel.ID) }
				hx-get={ r.Story.Base() + "/script/" + r.Panel.ID }
				hx-target={ "#row-" + r.Panel.ID }
				hx-swap="outerHTML"
			>{ i18n.T(ctx, "ui.cancel") }</a>
			@ui.Button(ui.ButtonProps{Variant: ui.Primary, Size: ui.SM, Type: "submit", Icon: "check"}) {
				{ i18n.T(ctx, "studio.save") }
			}
		</div>
	</form>
}

templ proseEditor(v StoryView) {
	<form class="mv-prose" method="post" action={ templ.URL(v.Base() + "/scenes/" + v.Scene.ID) }
		hx-post={ v.Base() + "/scenes/" + v.Scene.ID }
		hx-trigger="input changed delay:900ms, change"
		hx-vals={ `{"autosave":"1"}` }
		hx-target="#mv-prose-saved"
		hx-swap="outerHTML"
	>
		<input type="hidden" name="next" value={ v.SceneURL(v.SceneIdx, "prose") }/>
		<div class="mv-grid-3">
			@ui.Field(ui.FieldProps{ID: "scene-title", Label: i18n.T(ctx, "studio.story.scene_title")}) {
				@ui.Input(ui.InputProps{ID: "scene-title", Name: "title", Value: v.Scene.Title, MaxLength: 160, Required: true, ReadOnly: !v.Access.Can(EditStory)})
			}
			@ui.Field(ui.FieldProps{ID: "scene-time", Label: i18n.T(ctx, "studio.story.time_of_day")}) {
				@ui.Select(ui.SelectProps{ID: "scene-time", Name: "time_of_day", Value: v.Scene.TimeOfDay, Options: timeOptions(ctx, v.Scene.TimeOfDay), Disabled: !v.Access.Can(EditStory)})
			}
			@ui.Field(ui.FieldProps{ID: "scene-location", Label: i18n.T(ctx, "studio.story.location")}) {
				@ui.Select(ui.SelectProps{ID: "scene-location", Name: "location_id", Value: v.Scene.LocationID, Options: locationOptions(ctx, v.Locations), Disabled: !v.Access.Can(EditStory)})
			}
		</div>
		@ui.Field(ui.FieldProps{ID: "scene-prose", Label: i18n.T(ctx, "studio.story.prose"), Aside: i18n.T(ctx, "studio.story.words", "count", wordCount(v.Scene.Prose))}) {
			@ui.Textarea(ui.TextareaProps{ID: "scene-prose", Name: "prose", Value: v.Scene.Prose, Rows: 18, Class: "mv-prose__text",
				Placeholder: i18n.T(ctx, "studio.story.prose_placeholder")})
		}
		<div class="mv-row mv-row--between">
			@SavedNote("")
			if v.Access.Can(EditStory) {
				@ui.Button(ui.ButtonProps{Variant: ui.Secondary, Type: "submit", Icon: "device-floppy", Class: "mv-nojs"}) {
					{ i18n.T(ctx, "studio.save") }
				}
			}
		</div>
	</form>
}

// SavedNote is the autosave indicator of the prose editor.
templ SavedNote(text string) {
	<span id="mv-prose-saved" class="mv-small mv-muted" aria-live="polite">
		if text != "" {
			@ui.Icon("check", 14)
			{ text }
		} else {
			{ i18n.T(ctx, "studio.wizard.autosaves") }
		}
	</span>
}

templ assistPanel(v StoryView) {
	<aside class="mv-assist mv-hide-mobile" aria-label={ i18n.T(ctx, "studio.assist.title") }>
		<div class="mv-assist__head">
			<strong class="mv-small">{ i18n.T(ctx, "studio.assist.title") }</strong>
			<span class="mv-assist__chip">
				@ui.Icon("route", 14)
				<strong>{ v.Route.Auto }</strong>
				<span class="mv-truncate">→ { v.Route.Pick }</span>
			</span>
		</div>
		<div class="mv-assist__list" id="mv-assist-list">
			if len(v.Assists) == 0 {
				<p class="mv-small mv-muted mv-assist__hint">{ i18n.T(ctx, "studio.assist.hint") }</p>
			}
			for _, as := range v.Assists {
				@AssistItem(AssistView{Story: &v, Assist: as, Panels: scriptMap(v.Script)})
			}
		</div>
		if v.Access.Can(EditScript) {
			<form
				class="mv-assist__form"
				method="post"
				action={ templ.URL(v.Base() + "/assist") }
				hx-post={ v.Base() + "/assist" }
				hx-target="#mv-assist-list"
				hx-swap="beforeend"
			>
				<input type="hidden" name="chapter_id" value={ v.Chapter.ID }/>
				if v.Scene != nil {
					<input type="hidden" name="scene_id" value={ v.Scene.ID }/>
				}
				<input type="hidden" name="next" value={ v.Here() }/>
				<label class="mv-sr-only" for="assist-request">{ i18n.T(ctx, "studio.assist.ask") }</label>
				<input class="mv-input" id="assist-request" name="request" required maxlength="1000" placeholder={ i18n.T(ctx, "studio.assist.ask") } autocomplete="off"/>
				@ui.Button(ui.ButtonProps{Variant: ui.IconOnly, Type: "submit", Icon: "send", Label: i18n.T(ctx, "studio.assist.send")})
			</form>
		}
	</aside>
}

// AssistItem is one request bubble and its proposal (polled while pending).
templ AssistItem(a AssistView) {
	<div
		class="mv-assist__item"
		id={ "assist-" + a.Assist.ID }
		if a.Assist.Status == "pending" {
			hx-get={ a.Story.Base() + "/assist/" + a.Assist.ID }
			hx-trigger="every 2s, mv:ws from:document throttle:600ms"
			hx-swap="outerHTML"
		}
	>
		<div class="mv-assist__req">{ a.Assist.Request }</div>
		switch a.Assist.Status {
			case "pending":
				<div class="mv-assist__prop" role="status">
					@ui.Skeleton(i18n.T(ctx, "studio.assist.thinking"))
					<span class="mv-small mv-muted">{ i18n.T(ctx, "studio.assist.thinking") } { pct(a.Pct) }</span>
				</div>
			case "failed":
				<div class="mv-assist__prop mv-assist__prop--failed" role="alert">
					@ui.Icon("alert-triangle", 16)
					<span class="mv-small">{ i18n.T(ctx, "studio.assist.failed") } { a.Assist.Error }</span>
				</div>
			default:
				<div class={ ui.Cls("mv-assist__prop", ui.If(a.Assist.Status != "ready", "is-done")) }>
					<p class="mv-small">{ i18n.T(ctx, "studio.assist.proposed") } { a.Assist.Diff.V.Summary }</p>
					<span class="mv-mono mv-faint mv-assist__affects">{ a.Assist.Diff.V.Affects }</span>
					switch a.Assist.Status {
						case "ready":
							<div class="mv-row mv-row--sm">
								if a.Story.Access.Can(EditScript) {
									<form method="post" action={ templ.URL(a.Story.Base() + "/assist/" + a.Assist.ID + "/apply") } hx-post={ a.Story.Base() + "/assist/" + a.Assist.ID + "/apply" }>
										<input type="hidden" name="next" value={ a.Story.Here() }/>
										@ui.Button(ui.ButtonProps{Variant: ui.Primary, Size: ui.SM, Type: "submit"}) {
											{ i18n.T(ctx, "studio.assist.apply") }
										}
									</form>
								}
								<button class="mv-btn mv-btn--secondary mv-btn--sm" type="button" data-dialog-open={ "diff-" + a.Assist.ID }>{ i18n.T(ctx, "studio.assist.show_diff") }</button>
								if a.Story.Access.Can(EditScript) {
									<form method="post" action={ templ.URL(a.Story.Base() + "/assist/" + a.Assist.ID + "/dismiss") } hx-post={ a.Story.Base() + "/assist/" + a.Assist.ID + "/dismiss" } hx-target={ "#assist-" + a.Assist.ID } hx-swap="outerHTML">
										<input type="hidden" name="next" value={ a.Story.Here() }/>
										@ui.Button(ui.ButtonProps{Variant: ui.IconOnly, Size: ui.SM, Type: "submit", Icon: "x", Label: i18n.T(ctx, "studio.assist.dismiss")})
									</form>
								}
							</div>
							@diffDialog(a)
						case "applied":
							@ui.Badge(ui.ToneSuccess, "circle-check", i18n.T(ctx, "studio.assist.status.applied"))
						case "dismissed":
							@ui.Badge(ui.ToneMuted, "x", i18n.T(ctx, "studio.assist.status.dismissed"))
					}
				</div>
		}
	</div>
}

templ diffDialog(a AssistView) {
	@ui.Modal(ui.ModalProps{ID: "diff-" + a.Assist.ID, Title: i18n.T(ctx, "studio.assist.diff_title"), Wide: true}) {
		@ui.ModalBody() {
			<ol class="mv-diff mv-list-plain">
				for _, op := range a.Assist.Diff.V.Ops {
					<li class={ "mv-diff__op mv-diff__op--" + op.Op }>
						<span class="mv-diff__tag">{ i18n.T(ctx, "studio.assist.op."+op.Op) }</span>
						if old, ok := a.Panels[op.PanelID]; ok {
							<div class="mv-diff__before">
								<span class="mv-label-mono">{ old.Label } · { old.Camera }</span>
								<del>{ old.Action } { joinLines(old.Dialogue.V) }</del>
							</div>
						}
						if op.Panel != nil {
							<div class="mv-diff__after">
								<span class="mv-label-mono">{ op.Panel.Camera }</span>
								<ins>{ op.Panel.Action } { joinLines(op.Panel.Dialogue) }</ins>
							</div>
						}
					</li>
				}
			</ol>
		}
		@ui.ModalFoot() {
			<form method="dialog">
				@ui.Button(ui.ButtonProps{Variant: ui.Secondary, Type: "submit"}) {
					{ i18n.T(ctx, "ui.close") }
				}
			</form>
		}
	}
}

// AssistCreated answers a new request: the item plus a cleared request box.
templ AssistCreated(a AssistView) {
	@AssistItem(a)
	<input class="mv-input" id="assist-request" name="request" required maxlength="1000" placeholder={ i18n.T(ctx, "studio.assist.ask") } autocomplete="off" hx-swap-oob="true"/>
}
