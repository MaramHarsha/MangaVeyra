package studio

import (
	"strconv"

	"github.com/MaramHarsha/MangaVeyra/internal/i18n"
	"github.com/MaramHarsha/MangaVeyra/internal/jobs"
	"github.com/MaramHarsha/MangaVeyra/internal/web/ui"
)

// CharactersPage is C2: the character bible of a project.
templ CharactersPage(v CharactersView) {
	<header class="mv-pagehead mv-pagehead--compact">
		<div class="mv-pagehead__text">
			<h1 class="mv-pagehead__title">{ i18n.T(ctx, "studio.chars.title", "title", v.Project.Title) }</h1>
			<span class="mv-pagehead__sub">{ i18n.T(ctx, "studio.chars.sub", "count", v.Counts[""], "locked", v.Locked, "training", v.Training) }</span>
		</div>
		<div class="mv-pagehead__actions">
			<span class="mv-hide-mobile">
				@ui.LinkButton("/studio/templates/import?kind=character&project="+v.Project.ID, ui.ButtonProps{Variant: ui.Secondary, Icon: "package-import"}) {
					{ i18n.T(ctx, "studio.tpl.import_pack") }
				}
			</span>
			if v.Access.Can(EditCharacters) {
				@ui.LinkButton("/studio/p/"+v.Project.ID+"/characters/new", ui.ButtonProps{Variant: ui.Primary, Icon: "plus", Class: "mv-hide-mobile"}) {
					{ i18n.T(ctx, "studio.chars.new") }
				}
				@ui.LinkButton("/studio/p/"+v.Project.ID+"/characters/new", ui.ButtonProps{Variant: ui.IconOnly, Icon: "plus", Class: "mv-show-mobile", Label: i18n.T(ctx, "studio.chars.new")})
			}
		</div>
	</header>
	@ProjectTabs(v.Project, "characters")
	<div class="mv-hide-mobile">
		@ui.SegmentedLinks(i18n.T(ctx, "studio.chars.filter"), []ui.SegLink{
			{Href: "?", Label: i18n.T(ctx, "studio.chars.all_n", "count", v.Counts[""]), Current: v.Filter == ""},
			{Href: "?cat=main", Label: i18n.T(ctx, "studio.category.main"), Current: v.Filter == CategoryMain},
			{Href: "?cat=supporting", Label: i18n.T(ctx, "studio.category.supporting"), Current: v.Filter == CategorySupporting},
			{Href: "?cat=extra", Label: i18n.T(ctx, "studio.category.extras"), Current: v.Filter == CategoryExtra},
		})
	</div>
	if len(v.Cards) == 0 && !v.Access.Can(EditCharacters) {
		@EmptyState("シーン…", i18n.T(ctx, "studio.chars.empty.title"), i18n.T(ctx, "studio.chars.empty.body"), true)
	} else {
		<div class="mv-cgrid">
			for _, c := range v.Cards {
				@CharCardView(c)
			}
			if v.Access.Can(EditCharacters) {
				<a class="mv-addcard" href={ templ.URL("/studio/p/" + v.Project.ID + "/characters/new") }>
					@ui.Icon("user-plus", 32)
					<strong>{ i18n.T(ctx, "studio.chars.add") }</strong>
					<span>{ i18n.T(ctx, "studio.chars.add_desc") }</span>
				</a>
			}
		</div>
	}
}

// CharCardView is an anime-profile card: art, kanji watermark, role line, big name, Character Lock.
templ CharCardView(c CharCard) {
	<article class="mv-ccard">
		@Thumb(c.ArtURL, i18n.T(ctx, "studio.character.art"), "mv-ccard__art")
		<div class="mv-ccard__body">
			if c.Kanji != "" {
				<span class="mv-ccard__kanji" aria-hidden="true">{ c.Kanji }</span>
			}
			if c.RoleLine != "" {
				<span class="mv-ccard__role">{ c.RoleLine }</span>
			}
			<h3 class="mv-ccard__name">
				<a href={ templ.URL(c.Href) } class="mv-link--plain mv-ccard__link">
					<span>{ c.First }</span>
					if c.Last != "" {
						<span>{ c.Last }</span>
					}
				</a>
			</h3>
			if c.Personality != "" || c.Age != "" {
				<p class="mv-ccard__desc">{ charDesc(c.Character) }</p>
			}
			@LockMeter(c)
		</div>
	</article>
}

// LockMeter shows Character Lock: score, training progress or not trained yet.
templ LockMeter(c CharCard) {
	<div class="mv-ccard__lock">
		switch c.LockStatus {
			case LockReady:
				<div class={ ui.Cls("mv-lock", ui.If(c.LockScore != nil && *c.LockScore < DriftThreshold, "mv-lock--drift")) }>
					<span class="mv-lock__label">
						@ui.Icon("lock", 14)
						{ i18n.T(ctx, "studio.lock.name") }
					</span>
					<span class="mv-lock__score">{ fmtScore(c.LockScore) }</span>
				</div>
				@ui.Bar(scoreOf(c.LockScore), lockBarTone(c.LockScore), false, i18n.T(ctx, "studio.lock.name"))
			case LockTraining:
				<div class="mv-lock mv-lock--training">
					<span class="mv-lock__label">
						@ui.Icon("loader-2", 14)
						{ i18n.T(ctx, "studio.lock.training", "pct", pct(c.Progress)) }
					</span>
					<span class="mv-lock__score">–</span>
				</div>
				@ui.Bar(c.Progress, "", false, i18n.T(ctx, "studio.lock.training", "pct", pct(c.Progress)))
			case LockFailed:
				<div class="mv-lock mv-lock--failed">
					<span class="mv-lock__label">
						@ui.Icon("alert-triangle", 14)
						{ i18n.T(ctx, "studio.lock.failed") }
					</span>
				</div>
			default:
				<div class="mv-lock mv-lock--none">
					<span class="mv-lock__label">
						@ui.Icon("lock-open", 14)
						{ i18n.T(ctx, "studio.lock.none") }
					</span>
				</div>
		}
	</div>
}

// AllCharactersPage is /studio/characters: every project's characters, grouped by project.
templ AllCharactersPage(v AllCharactersView) {
	@ui.PageHead(i18n.T(ctx, "nav.characters"), i18n.T(ctx, "studio.chars.all_sub"), nil)
	if len(v.Groups) == 0 {
		@EmptyState("シーン…", i18n.T(ctx, "dash.empty.title"), i18n.T(ctx, "studio.chars.no_projects"), true) {
			@ui.LinkButton("/studio/new", ui.ButtonProps{Variant: ui.Primary, Icon: "plus"}) {
				{ i18n.T(ctx, "nav.new_manga") }
			}
		}
	}
	for _, g := range v.Groups {
		<section class="mv-stack">
			<div class="mv-section-head">
				<h2 class="mv-section-head__title">{ g.Project.Title }</h2>
				<a href={ templ.URL("/studio/p/" + g.Project.ID + "/characters") }>{ i18n.T(ctx, "studio.chars.open_bible", "count", len(g.Cards)) }</a>
			</div>
			if len(g.Cards) == 0 {
				<p class="mv-small mv-muted">{ i18n.T(ctx, "studio.chars.none_yet") }</p>
			}
			<div class="mv-cgrid">
				for _, c := range g.Cards {
					@CharCardView(c)
				}
				if g.CanAdd {
					<a class="mv-addcard" href={ templ.URL("/studio/p/" + g.Project.ID + "/characters/new") }>
						@ui.Icon("user-plus", 32)
						<strong>{ i18n.T(ctx, "studio.chars.add") }</strong>
						<span>{ i18n.T(ctx, "studio.chars.add_desc") }</span>
					</a>
				}
			</div>
		</section>
	}
}

// CharacterPage is C3: references, Character Lock, facts, outfits and relationships.
templ CharacterPage(v CharacterView, bibleTitle string) {
	<div class="mv-c3">
		<div class={ ui.Cls("mv-c3__refs", "mv-c3-sec", ui.If(v.Tab == "refs", "is-current")) }>
			<div class="mv-c3__main">
				@Thumb(v.Card.ArtURL, i18n.T(ctx, "studio.character.main_ref"), "mv-c3__mainart")
				if v.Card.Kanji != "" {
					<span class="mv-c3__kanji" aria-hidden="true">{ v.Card.Kanji }</span>
				}
			</div>
			<div class="mv-c3__slots">
				for _, s := range refSlots(ctx, v.Refs, v.RefURLs) {
					<div class="mv-c3__slot">
						@Thumb(s.URL, s.Label, "mv-c3__slotart")
					</div>
				}
			</div>
			if v.Access.Can(EditCharacters) {
				<details class="mv-c3__upload">
					<summary class="mv-btn mv-btn--secondary mv-btn--sm">
						@ui.Icon("upload", 16)
						{ i18n.T(ctx, "studio.character.add_refs") }
					</summary>
					<form class="mv-stack mv-stack--sm mv-box mv-box--pad" method="post" enctype="multipart/form-data" action={ templ.URL(v.Card.Href + "/refs") }>
						@ui.Field(ui.FieldProps{ID: "refs-files", Label: i18n.T(ctx, "studio.character.ref_files"), Hint: i18n.T(ctx, "studio.upload.hint")}) {
							<input class="mv-input mv-file" id="refs-files" type="file" name="refs" accept="image/png,image/jpeg,image/webp" multiple required/>
						}
						<div class="mv-grid-2">
							@ui.Field(ui.FieldProps{ID: "refs-kind", Label: i18n.T(ctx, "studio.character.ref_kind")}) {
								@ui.Select(ui.SelectProps{ID: "refs-kind", Name: "kind", Value: RefFront, Options: refKindOptions(ctx)})
							}
							@ui.Field(ui.FieldProps{ID: "refs-label", Label: i18n.T(ctx, "studio.character.ref_label"), Aside: i18n.T(ctx, "studio.form.optional")}) {
								@ui.Input(ui.InputProps{ID: "refs-label", Name: "label", MaxLength: 60, Placeholder: i18n.T(ctx, "studio.character.ref_label_ph")})
							}
						</div>
						@ui.Button(ui.ButtonProps{Variant: ui.Primary, Size: ui.SM, Type: "submit", Icon: "upload"}) {
							{ i18n.T(ctx, "studio.character.upload") }
						}
					</form>
				</details>
			}
			if len(v.Refs) > 0 {
				<ul class="mv-reflist mv-list-plain">
					for _, ref := range v.Refs {
						<li class="mv-reflist__item">
							@Thumb(v.RefURLs[ref.ID], "", "mv-reflist__thumb")
							<span class="mv-small">{ refLabel(ctx, ref) }</span>
							if v.Access.Can(EditCharacters) {
								<form method="post" action={ templ.URL(v.Card.Href + "/refs/" + ref.ID) } class="mv-reflist__form">
									<input type="hidden" name="kind" value={ ref.Kind }/>
									<input type="hidden" name="label" value={ ref.Label }/>
									<input type="hidden" name="portrait" value="1"/>
									@ui.Button(ui.ButtonProps{Variant: ui.IconOnly, Size: ui.SM, Type: "submit", Icon: "star", Label: i18n.T(ctx, "studio.character.make_main"), Tip: i18n.T(ctx, "studio.character.make_main")})
								</form>
								<form method="post" action={ templ.URL(v.Card.Href + "/refs/" + ref.ID + "/delete") }>
									@ui.Button(ui.ButtonProps{Variant: ui.IconOnly, Size: ui.SM, Type: "submit", Icon: "trash", Label: i18n.T(ctx, "studio.character.remove_ref"), Tip: i18n.T(ctx, "studio.character.remove_ref")})
								</form>
							}
						</li>
					}
				</ul>
			}
		</div>
		<div class="mv-c3__info">
			<div class="mv-c3__head">
				<div class="mv-stack mv-stack--xs">
					<span class="mv-ccard__role">{ upper(joinDot(v.Card.RoleLine, v.Project.Title)) }</span>
					<h1 class="mv-c3__name">{ v.Card.Name }</h1>
				</div>
				<div class="mv-row mv-row--sm mv-hide-mobile">
					if v.Access.Can(EditCharacters) {
						@ui.LinkButton(v.Card.Href+"/edit", ui.ButtonProps{Variant: ui.Ghost, Icon: "pencil", Size: ui.SM}) {
							{ i18n.T(ctx, "studio.character.edit") }
						}
					}
					@ui.LinkButton("/studio/templates/export?kind=character&id="+v.Card.ID, ui.ButtonProps{Variant: ui.Secondary, Icon: "package-export", Size: ui.SM}) {
						{ i18n.T(ctx, "studio.character.export_pack") }
					}
					@ui.LinkButton("/studio/p/"+v.Project.ID+"/chapters/"+itoa(v.EditorN)+"/edit?character="+v.Card.ID, ui.ButtonProps{Variant: ui.Primary, Size: ui.SM}) {
						{ i18n.T(ctx, "studio.character.use_in_panel") }
					}
				</div>
			</div>
			<div class="mv-c3__top">
				@lockPanel(v)
				<div class={ ui.Cls("mv-box mv-c3__facts", "mv-c3-sec", ui.If(v.Tab == "profile", "is-current")) }>
					<p class="mv-c3__about mv-show-mobile">{ charAbout(v.Card.Character) }</p>
					@ui.KV(i18n.T(ctx, "studio.character.age"), dash(v.Card.Age))
					@ui.KV(i18n.T(ctx, "studio.character.voice"), voiceLine(ctx, v.Card.Voice.V))
					@ui.KV(i18n.T(ctx, "studio.character.speech"), dash(v.Card.SpeechStyle))
					@ui.KV(i18n.T(ctx, "studio.character.appears"), i18n.T(ctx, "studio.character.appears_value", "chapters", v.Stats.Chapters, "panels", v.Stats.Panels))
					if v.Card.Look != "" {
						@ui.KV(i18n.T(ctx, "studio.character.look"), v.Card.Look)
					}
				</div>
			</div>
			<nav class="mv-seg mv-seg--full mv-show-mobile mv-c3__tabs" aria-label={ v.Card.Name }>
				for _, t := range []string{"profile", "outfits", "relations", "refs"} {
					<a
						class="mv-seg__item mv-seg__item--lg"
						href={ templ.URL("?tab=" + t) }
						if v.Tab == t {
							aria-current="true"
						}
					>{ i18n.T(ctx, "studio.character.tab."+t) }</a>
				}
			</nav>
			<section class={ ui.Cls("mv-stack mv-stack--sm", "mv-c3-sec", ui.If(v.Tab == "outfits", "is-current")) }>
				<h2 class="mv-c3__h2">{ i18n.T(ctx, "studio.character.outfits") }</h2>
				<div class="mv-outfits">
					for _, o := range v.Outfits {
						<div class={ ui.Cls("mv-outfit", ui.If(o.IsDefault, "is-default")) }>
							@Thumb(v.RefURLs[o.AssetID], outfitLabel(ctx, o), "mv-outfit__art")
							if o.Description != "" {
								<span class="mv-sr-only">{ o.Description }</span>
							}
							if v.Access.Can(EditCharacters) {
								<form class="mv-outfit__del" method="post" action={ templ.URL(v.Card.Href + "/outfits/" + o.ID + "/delete") }>
									@ui.Button(ui.ButtonProps{Variant: ui.IconOnly, Size: ui.SM, Type: "submit", Icon: "x", Label: i18n.T(ctx, "studio.character.remove_outfit", "name", o.Name)})
								</form>
							}
						</div>
					}
					if v.Access.Can(EditCharacters) {
						<button class="mv-outfit mv-outfit--add" type="button" data-dialog-open="outfit-new">
							@ui.Icon("plus", 16)
							{ i18n.T(ctx, "studio.character.outfit") }
						</button>
					}
				</div>
			</section>
			<section class={ ui.Cls("mv-stack mv-stack--sm", "mv-c3-sec", ui.If(v.Tab == "relations", "is-current")) }>
				<h2 class="mv-c3__h2">{ i18n.T(ctx, "studio.character.relations") }</h2>
				<div class="mv-rels">
					for _, rel := range v.Relations {
						<div class="mv-rel">
							@ui.Avatar(ui.AvatarProps{Name: rel.OtherName, Key: rel.OtherID, Size: "md"})
							<span class="mv-rel__text">
								<a class="mv-link--plain" href={ templ.URL("/studio/p/" + v.Project.ID + "/characters/" + rel.OtherID) }><strong>{ rel.OtherName }</strong></a>
								<span>{ joinDot(rel.Kind, rel.Note) }</span>
							</span>
							if v.Access.Can(EditCharacters) {
								<form method="post" action={ templ.URL(v.Card.Href + "/relations/" + rel.ID + "/delete") }>
									@ui.Button(ui.ButtonProps{Variant: ui.IconOnly, Size: ui.SM, Type: "submit", Icon: "x", Label: i18n.T(ctx, "studio.character.remove_relation", "name", rel.OtherName)})
								</form>
							}
						</div>
					}
					if v.Access.Can(EditCharacters) && len(v.Others) > 0 {
						<button class="mv-rel mv-rel--add" type="button" data-dialog-open="relation-new">
							@ui.Icon("plus", 16)
							{ i18n.T(ctx, "studio.character.relation") }
						</button>
					}
				</div>
				if len(v.Relations) == 0 && len(v.Others) == 0 {
					<p class="mv-small mv-muted">{ i18n.T(ctx, "studio.character.no_others") }</p>
				}
			</section>
		</div>
	</div>
	if v.Access.Can(EditCharacters) {
		@outfitDialog(v)
		@relationDialog(v)
	}
}

templ lockPanel(v CharacterView) {
	<section class={ ui.Cls("mv-box mv-lockpanel", ui.If(v.Card.LockStatus == LockReady, "mv-lockpanel--ready")) } aria-label={ i18n.T(ctx, "studio.lock.name") }>
		<div class="mv-lockpanel__head">
			<strong>
				@ui.Icon("lock", 18)
				{ i18n.T(ctx, "studio.lock.name") }
			</strong>
			switch v.Card.LockStatus {
				case LockReady:
					<span class={ ui.Cls("mv-lockpanel__score", ui.If(v.Card.LockScore != nil && *v.Card.LockScore < DriftThreshold, "is-drift")) }>{ fmtScore(v.Card.LockScore) }</span>
				case LockTraining:
					<span class="mv-lockpanel__score is-training">{ pct(v.Card.Progress) }</span>
			}
		</div>
		switch v.Card.LockStatus {
			case LockReady:
				<p class="mv-small mv-muted mv-hide-mobile">{ lockDesc(ctx, v) }</p>
				if len(v.Stats.ByChapter) > 0 {
					<div class="mv-lockbars mv-hide-mobile" role="img" aria-label={ i18n.T(ctx, "studio.lock.history") }>
						for _, b := range v.Stats.ByChapter {
							<span class={ ui.Cls("mv-lockbars__bar", ui.If(b.Score < DriftThreshold, "is-drift")) } style={ "height:" + strconv.Itoa(barHeight(b.Score)) + "%" } title={ i18n.T(ctx, "studio.lock.bar", "n", b.Chapter, "pct", pct(b.Score)) }></span>
						}
					</div>
				}
				if len(v.Stats.Drifted) > 0 {
					<p class="mv-small mv-warn-text mv-hide-mobile">
						{ i18n.T(ctx, "studio.lock.drifted", "count", len(v.Stats.Drifted), "n", v.Stats.Drifted[0].Chapter) } ·
						<a class="mv-warn-text" href={ templ.URL("/studio/p/" + v.Project.ID + "/chapters/" + itoa(v.Stats.Drifted[0].Chapter) + "/edit?tool=lockfix&character=" + v.Card.ID) }>{ i18n.T(ctx, "studio.lock.fix") }</a>
					</p>
				}
			case LockTraining:
				<p class="mv-small mv-muted">{ i18n.T(ctx, "studio.lock.training_desc") }</p>
				@ui.Bar(v.Card.Progress, "", true, i18n.T(ctx, "studio.lock.training", "pct", pct(v.Card.Progress)))
			default:
				<p class="mv-small mv-muted">
					if v.Card.LockStatus == LockFailed {
						{ i18n.T(ctx, "studio.lock.failed_desc", "error", v.Card.LockInfo.V.Error) }
					} else {
						{ i18n.T(ctx, "studio.lock.none_desc") }
					}
				</p>
				if v.Access.Can(EditCharacters) {
					<form method="post" action={ templ.URL(v.Card.Href + "/train") }>
						@ui.Button(ui.ButtonProps{Variant: ui.Primary, Size: ui.SM, Type: "submit", Icon: "lock", Disabled: len(v.Refs) == 0}) {
							{ i18n.T(ctx, "studio.lock.train") }
						}
						if len(v.Refs) == 0 {
							<span class="mv-small mv-muted">{ i18n.T(ctx, "studio.character.need_refs") }</span>
						}
					</form>
				}
		}
	</section>
}

templ outfitDialog(v CharacterView) {
	@ui.Modal(ui.ModalProps{ID: "outfit-new", Title: i18n.T(ctx, "studio.character.new_outfit")}) {
		<form method="post" enctype="multipart/form-data" action={ templ.URL(v.Card.Href + "/outfits") }>
			@ui.ModalBody() {
				@ui.Field(ui.FieldProps{ID: "outfit-name", Label: i18n.T(ctx, "studio.character.outfit_name")}) {
					@ui.Input(ui.InputProps{ID: "outfit-name", Name: "name", Required: true, MaxLength: 80, Placeholder: i18n.T(ctx, "studio.character.outfit_name_ph")})
				}
				@ui.Field(ui.FieldProps{ID: "outfit-chapters", Label: i18n.T(ctx, "studio.character.outfit_chapters"), Aside: i18n.T(ctx, "studio.form.optional")}) {
					@ui.Input(ui.InputProps{ID: "outfit-chapters", Name: "chapters", MaxLength: 40, Placeholder: "6–9"})
				}
				@ui.Field(ui.FieldProps{ID: "outfit-desc", Label: i18n.T(ctx, "studio.character.outfit_desc"), Aside: i18n.T(ctx, "studio.form.optional")}) {
					@ui.Textarea(ui.TextareaProps{ID: "outfit-desc", Name: "description", Rows: 2})
				}
				@ui.Field(ui.FieldProps{ID: "outfit-image", Label: i18n.T(ctx, "studio.character.outfit_image"), Aside: i18n.T(ctx, "studio.form.optional")}) {
					<input class="mv-input mv-file" id="outfit-image" type="file" name="image" accept="image/png,image/jpeg,image/webp"/>
				}
				@ui.Checkbox(ui.CheckProps{ID: "outfit-default", Name: "is_default", Label: i18n.T(ctx, "studio.character.outfit_default")})
			}
			@ui.ModalFoot() {
				@ui.Button(ui.ButtonProps{Variant: ui.Ghost, Attrs: attrs("data-dialog-close", "")}) {
					{ i18n.T(ctx, "ui.cancel") }
				}
				@ui.Button(ui.ButtonProps{Variant: ui.Primary, Type: "submit", Icon: "plus"}) {
					{ i18n.T(ctx, "studio.character.add_outfit") }
				}
			}
		</form>
	}
}

templ relationDialog(v CharacterView) {
	@ui.Modal(ui.ModalProps{ID: "relation-new", Title: i18n.T(ctx, "studio.character.new_relation")}) {
		<form method="post" action={ templ.URL(v.Card.Href + "/relations") }>
			@ui.ModalBody() {
				@ui.Field(ui.FieldProps{ID: "rel-other", Label: i18n.T(ctx, "studio.character.relation_with")}) {
					@ui.Select(ui.SelectProps{ID: "rel-other", Name: "other_id", Options: otherOptions(v.Others)})
				}
				@ui.Field(ui.FieldProps{ID: "rel-kind", Label: i18n.T(ctx, "studio.character.relation_kind")}) {
					@ui.Input(ui.InputProps{ID: "rel-kind", Name: "kind", Required: true, MaxLength: 60, Placeholder: i18n.T(ctx, "studio.character.relation_kind_ph")})
				}
				@ui.Field(ui.FieldProps{ID: "rel-note", Label: i18n.T(ctx, "studio.character.relation_note"), Aside: i18n.T(ctx, "studio.form.optional")}) {
					@ui.Input(ui.InputProps{ID: "rel-note", Name: "note", MaxLength: 200})
				}
			}
			@ui.ModalFoot() {
				@ui.Button(ui.ButtonProps{Variant: ui.Ghost, Attrs: attrs("data-dialog-close", "")}) {
					{ i18n.T(ctx, "ui.cancel") }
				}
				@ui.Button(ui.ButtonProps{Variant: ui.Primary, Type: "submit", Icon: "plus"}) {
					{ i18n.T(ctx, "studio.character.add_relation") }
				}
			}
		</form>
	}
}

// CharacterEditPage edits every profile field.
templ CharacterEditPage(v CharacterView, f *characterForm) {
	@ui.PageHead(i18n.T(ctx, "studio.character.edit_title", "name", v.Card.Name), v.Project.Title, nil)
	<form class="mv-cform" method="post" action={ templ.URL(v.Card.Href) }>
		<input type="hidden" name="next" value={ v.Card.Href }/>
		@characterFields(editInput(v, f), editErrors(f), true)
		<div class="mv-row mv-row--between mv-row--wrap">
			@ui.LinkButton(v.Card.Href, ui.ButtonProps{Variant: ui.Ghost}) {
				{ i18n.T(ctx, "ui.cancel") }
			}
			@ui.Button(ui.ButtonProps{Variant: ui.Primary, Type: "submit", Icon: "check"}) {
				{ i18n.T(ctx, "studio.save") }
			}
		</div>
	</form>
	<section class="mv-box mv-box--danger mv-box--pad mv-stack mv-stack--sm">
		<strong>{ i18n.T(ctx, "studio.character.delete_title") }</strong>
		<p class="mv-small mv-muted">{ i18n.T(ctx, "studio.character.delete_body") }</p>
		<form method="post" action={ templ.URL(v.Card.Href + "/delete") }>
			@ui.Button(ui.ButtonProps{Variant: ui.DangerOutline, Type: "submit", Icon: "trash", Size: ui.SM}) {
				{ i18n.T(ctx, "studio.character.delete", "name", v.Card.Name) }
			}
		</form>
	</section>
}

templ characterFields(in CharacterInput, errs map[string]string, full bool) {
	<div class="mv-grid-2">
		@ui.Field(ui.FieldProps{ID: "c-name", Label: i18n.T(ctx, "studio.character.name"), Error: errs["name"]}) {
			@ui.Input(ui.InputProps{ID: "c-name", Name: "name", Value: in.Name, Required: true, MaxLength: 80, Invalid: errs["name"] != ""})
		}
		if full {
			@ui.Field(ui.FieldProps{ID: "c-kanji", Label: i18n.T(ctx, "studio.character.kanji"), Hint: i18n.T(ctx, "studio.character.kanji_hint")}) {
				@ui.Input(ui.InputProps{ID: "c-kanji", Name: "kanji", Value: in.Kanji, MaxLength: 2, Described: true})
			}
		}
		@ui.Field(ui.FieldProps{ID: "c-role", Label: i18n.T(ctx, "studio.character.role")}) {
			@ui.Select(ui.SelectProps{ID: "c-role", Name: "role", Value: in.Role, Options: roleOptions(ctx)})
		}
		@ui.Field(ui.FieldProps{ID: "c-roleline", Label: i18n.T(ctx, "studio.character.role_line"), Aside: i18n.T(ctx, "studio.form.optional")}) {
			@ui.Input(ui.InputProps{ID: "c-roleline", Name: "role_line", Value: in.RoleLine, MaxLength: 80, Placeholder: i18n.T(ctx, "studio.character.role_line_ph")})
		}
		if full {
			@ui.Field(ui.FieldProps{ID: "c-category", Label: i18n.T(ctx, "studio.character.category")}) {
				@ui.Select(ui.SelectProps{ID: "c-category", Name: "category", Value: in.Category, Options: categoryOptions(ctx)})
			}
			@ui.Field(ui.FieldProps{ID: "c-age", Label: i18n.T(ctx, "studio.character.age")}) {
				@ui.Input(ui.InputProps{ID: "c-age", Name: "age", Value: in.Age, MaxLength: 20})
			}
		}
	</div>
	@ui.Field(ui.FieldProps{ID: "c-look", Label: i18n.T(ctx, "studio.character.look")}) {
		@ui.Textarea(ui.TextareaProps{ID: "c-look", Name: "look", Value: in.Look, Rows: 3, Placeholder: i18n.T(ctx, "studio.character.look_ph")})
	}
	@ui.Field(ui.FieldProps{ID: "c-personality", Label: i18n.T(ctx, "studio.character.personality")}) {
		@ui.Textarea(ui.TextareaProps{ID: "c-personality", Name: "personality", Value: in.Personality, Rows: 2})
	}
	if full {
		<div class="mv-grid-2">
			@ui.Field(ui.FieldProps{ID: "c-speech", Label: i18n.T(ctx, "studio.character.speech")}) {
				@ui.Input(ui.InputProps{ID: "c-speech", Name: "speech_style", Value: in.SpeechStyle, MaxLength: 400})
			}
			@ui.Field(ui.FieldProps{ID: "c-voice", Label: i18n.T(ctx, "studio.character.voice"), Hint: i18n.T(ctx, "studio.character.voice_hint")}) {
				@ui.Input(ui.InputProps{ID: "c-voice", Name: "voice", Value: in.Voice.Description, MaxLength: 200, Described: true})
			}
		</div>
		@ui.Field(ui.FieldProps{ID: "c-backstory", Label: i18n.T(ctx, "studio.character.backstory"), Aside: i18n.T(ctx, "studio.form.optional")}) {
			@ui.Textarea(ui.TextareaProps{ID: "c-backstory", Name: "backstory", Value: in.Backstory, Rows: 4})
		}
		<input type="hidden" name="style" value={ in.Style }/>
		<input type="hidden" name="voice_preset" value={ in.Voice.Preset }/>
	}
}

// CreateCharacterPage is C4: describe & generate a reference sheet, or upload references, then train Character Lock.
templ CreateCharacterPage(v CreateView) {
	<header class="mv-pagehead">
		<div class="mv-pagehead__text mv-hide-mobile">
			<h1 class="mv-pagehead__title">{ i18n.T(ctx, "studio.create.title") }</h1>
			<span class="mv-pagehead__sub">{ v.Project.Title }</span>
		</div>
		<nav class="mv-seg mv-c4__modes" aria-label={ i18n.T(ctx, "studio.create.mode") }>
			<a class="mv-seg__item mv-seg__item--lg" href={ templ.URL(createHref(v, "describe")) }
				if v.Mode == "describe" {
					aria-current="true"
				}
			>
				<span class="mv-hide-mobile">{ i18n.T(ctx, "studio.create.describe") }</span>
				<span class="mv-show-mobile">{ i18n.T(ctx, "studio.create.describe_short") }</span>
			</a>
			<a class="mv-seg__item mv-seg__item--lg" href={ templ.URL(createHref(v, "upload")) }
				if v.Mode == "upload" {
					aria-current="true"
				}
			>
				<span class="mv-hide-mobile">{ i18n.T(ctx, "studio.create.upload") }</span>
				<span class="mv-show-mobile">{ i18n.T(ctx, "studio.create.upload_short") }</span>
			</a>
		</nav>
	</header>
	<div class="mv-c4">
		if v.Mode == "upload" {
			<form class="mv-c4__form" method="post" enctype="multipart/form-data" action={ templ.URL(createAction(v)) }>
				<input type="hidden" name="mode" value="upload"/>
				if v.Character != nil {
					<input type="hidden" name="next" value={ createHref(v, "upload") }/>
				}
				@characterFields(v.In, v.Errors, false)
				@ui.Field(ui.FieldProps{ID: "c-refs", Label: i18n.T(ctx, "studio.character.ref_files"), Hint: i18n.T(ctx, "studio.upload.hint"), Error: v.Errors["refs"]}) {
					<input class="mv-input mv-file" id="c-refs" type="file" name="refs" accept="image/png,image/jpeg,image/webp" multiple required?={ v.Character == nil }/>
				}
				@ui.Field(ui.FieldProps{ID: "c-refkind", Label: i18n.T(ctx, "studio.character.ref_kind")}) {
					@ui.Select(ui.SelectProps{ID: "c-refkind", Name: "ref_kind", Value: RefFront, Options: refKindOptions(ctx)})
				}
				<div class="mv-c4__foot">
					@ui.Button(ui.ButtonProps{Variant: ui.Primary, Type: "submit", Icon: "upload", Full: true, Size: ui.LG}) {
						{ i18n.T(ctx, "studio.create.upload_submit") }
					}
				</div>
			</form>
		} else {
			<form class="mv-c4__form" method="post" action={ templ.URL(createAction(v)) }>
				<input type="hidden" name="mode" value="describe"/>
				@characterFields(v.In, v.Errors, false)
				<fieldset class="mv-field">
					<legend class="mv-field__label">{ i18n.T(ctx, "studio.create.style") }</legend>
					@ui.Segmented(ui.SegmentedProps{Name: "style", Value: styleValue(v.In.Style), Full: true, Label: i18n.T(ctx, "studio.create.style"), Options: []ui.Option{
						{Value: "series", Label: i18n.T(ctx, "studio.create.style.series", "style", i18n.T(ctx, "style."+v.Project.Style))},
						{Value: "colour", Label: i18n.T(ctx, "studio.create.style.colour")},
						{Value: "chibi", Label: i18n.T(ctx, "studio.create.style.chibi")},
					}})
				</fieldset>
				<div class="mv-c4__foot">
					@RouteChipView(v.Route)
					@ui.Button(ui.ButtonProps{Variant: ui.Primary, Type: "submit", Icon: "sparkles", Full: true, Size: ui.LG}) {
						<span class="mv-hide-mobile">{ i18n.T(ctx, "studio.create.generate") }</span>
						<span class="mv-show-mobile">{ i18n.T(ctx, "studio.create.generate_short") }</span>
					}
				</div>
			</form>
		}
		<div class="mv-c4__side">
			if v.Mode == "upload" {
				@uploadedRefs(v)
			} else {
				@SheetPicker(v)
			}
		</div>
	</div>
}

templ uploadedRefs(v CreateView) {
	<div class="mv-stack">
		<div class="mv-row mv-row--between">
			<strong>{ i18n.T(ctx, "studio.create.your_refs", "count", len(v.Refs)) }</strong>
			<span class="mv-small mv-muted">{ i18n.T(ctx, "studio.create.refs_hint") }</span>
		</div>
		<div class="mv-sheets">
			for i := 0; i < max(4, len(v.Refs)); i++ {
				if i < len(v.Refs) {
					@Thumb(v.RefURLs[v.Refs[i].AssetID], refLabel(ctx, v.Refs[i]), "mv-sheet")
				} else {
					@ui.ToneBox(i18n.T(ctx, "studio.create.ref_slot", "n", i+1), "", "mv-sheet")
				}
			}
		</div>
		if v.Character != nil && len(v.Refs) > 0 {
			@trainNotice(v)
			<form method="post" action={ templ.URL("/studio/p/" + v.Project.ID + "/characters/" + v.Character.ID + "/train") }>
				<input type="hidden" name="next" value={ "/studio/p/" + v.Project.ID + "/characters/" + v.Character.ID }/>
				@ui.Button(ui.ButtonProps{Variant: ui.Primary, Type: "submit", Icon: "lock", Full: true}) {
					{ i18n.T(ctx, "studio.lock.train") }
				}
			</form>
		}
	</div>
}

templ trainNotice(v CreateView) {
	@ui.Notice(ui.ToneInfo, "info-circle") {
		if v.GPU != "" {
			{ i18n.T(ctx, "studio.create.train_note_gpu", "gpu", v.GPU) }
		} else {
			{ i18n.T(ctx, "studio.create.train_note") }
		}
	}
}

// SheetPicker shows the four generated reference sheets (polled while generating).
templ SheetPicker(v CreateView) {
	<div
		id="mv-sheets"
		class="mv-stack"
		if v.Job != nil && !v.Job.Finished() {
			hx-get={ "/studio/p/" + v.Project.ID + "/characters/" + v.Character.ID + "/sheets" }
			hx-trigger="every 2s, mv:ws from:document throttle:600ms"
			hx-swap="outerHTML"
		}
	>
		<div class="mv-row mv-row--between">
			<strong>{ i18n.T(ctx, "studio.create.pick", "count", len(v.Sheets)) }</strong>
			<span class="mv-small mv-muted mv-hide-mobile">{ i18n.T(ctx, "studio.create.pick_hint") }</span>
		</div>
		if v.Job == nil || (v.Job.State == jobs.StateDone && len(v.Sheets) == 0) {
			<div class="mv-sheets">
				for i := 1; i <= 4; i++ {
					@ui.ToneBox(i18n.T(ctx, "studio.create.sheet_label", "n", i), "", "mv-sheet")
				}
			</div>
		} else if v.Job.State == jobs.StateDone {
			<form class="mv-stack" method="post" action={ templ.URL("/studio/p/" + v.Project.ID + "/characters/" + v.Character.ID + "/pick") }>
				<fieldset class="mv-sheets mv-vars__grid" data-variation-picker>
					<legend class="mv-sr-only">{ i18n.T(ctx, "studio.create.pick", "count", len(v.Sheets)) }</legend>
					for i, s := range v.Sheets {
						<label class="mv-var mv-sheet">
							<input type="radio" name="sheet" value={ s.AssetID } checked?={ i == 0 && v.Character.PortraitAssetID == "" || s.AssetID == v.Character.PortraitAssetID } aria-keyshortcuts={ strconv.Itoa(i + 1) }/>
							@Thumb(v.SheetURLs[s.AssetID], i18n.T(ctx, "studio.create.sheet_label", "n", i+1), "")
							<span class="mv-var__key" aria-hidden="true">{ strconv.Itoa(i + 1) }</span>
						</label>
					}
				</fieldset>
				@trainNotice(v)
				<div class="mv-row mv-row--sm mv-row--wrap">
					<button class="mv-btn mv-btn--primary" type="submit" name="train" value="1">
						@ui.Icon("lock", 18)
						{ i18n.T(ctx, "studio.create.keep_train") }
					</button>
					<button class="mv-btn mv-btn--secondary" type="submit" name="train" value="0">
						{ i18n.T(ctx, "studio.create.keep") }
					</button>
					<button class="mv-btn mv-btn--ghost" type="submit" formaction={ templ.URL("/studio/p/" + v.Project.ID + "/characters/" + v.Character.ID + "/sheets") }>
						@ui.Icon("refresh", 18)
						{ i18n.T(ctx, "studio.create.reroll") }
					</button>
				</div>
			</form>
		} else if v.Job.State == jobs.StateFailed || v.Job.State == jobs.StateCanceled {
			@ui.GenState(ui.GenProps{State: ui.GenFailed, Title: i18n.T(ctx, "studio.create.failed"), Detail: jobErr(v.Job), SFX: "FZZT"})
			<form method="post" action={ templ.URL("/studio/p/" + v.Project.ID + "/characters/" + v.Character.ID + "/sheets") }>
				@ui.Button(ui.ButtonProps{Variant: ui.Secondary, Type: "submit", Icon: "refresh"}) {
					{ i18n.T(ctx, "studio.wizard.gen.retry") }
				}
			</form>
		} else {
			<div class="mv-sheets">
				for i := 1; i <= 4; i++ {
					if v.Job.State == jobs.StateQueued {
						@ui.GenState(ui.GenProps{State: ui.GenQueued, Position: i, Title: i18n.T(ctx, "studio.create.sheet_label", "n", i), JobID: v.Job.ID})
					} else {
						@ui.GenState(ui.GenProps{State: ui.GenGenerating, Progress: sheetProgress(v.Job.Progress, i), Title: i18n.T(ctx, "studio.create.sheet_label", "n", i),
							ProgressText: pct(sheetProgress(v.Job.Progress, i)), JobID: v.Job.ID})
					}
				}
			</div>
		}
	</div>
}
